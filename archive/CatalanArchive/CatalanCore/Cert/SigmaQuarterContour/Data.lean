  decide ((ptAtC (conjugateIndex k)).1 = (ptAtC k).1) &&
  decide ((ptAtC (conjugateIndex k)).2.1 = -(ptAtC k).2.1) &&
  decide ((ptAtC (conjugateIndex k)).2.2 = (ptAtC k).2.2) &&
  decide (conjugateIndex (conjugateIndex k) = k)
def checkChunk (j : ℕ) : List ℕ := (List.range (min 32 (pts.length - 32*j))).map (fun i => 32*j+i)
end CatalanCore.Cert.SigmaQuarterContour
