def qII (p q : Pt) : ℕ := (p.1 - q.1).natAbs ^ 2 + (p.2.1 - q.2.1).natAbs ^ 2 + 2 ^ 56

def iRow (p : Pt) : List Pt → ℤ
  | [] => 0
  | q :: qs => (q.2.2 : ℤ) * CatalanLambda.Cert.logLoS (qII p q) + iRow p qs

/-- row `r` of the triangle: the diagonal term and twice the pairs with the later points. -/
def rowT (L : List Pt) (r : ℕ) : ℤ :=
  ((L.getD r (0, 0, 0)).2.2 : ℤ) * (((L.getD r (0, 0, 0)).2.2 : ℤ) * CatalanLambda.Cert.logLoS (qII (L.getD r (0, 0, 0)) (L.getD r (0, 0, 0)))
    + 2 * iRow (L.getD r (0, 0, 0)) (L.drop (r + 1)))

def rowsSum (a n : ℕ) : ℤ := ((List.range n).map (fun i => rowT sigH (a + i))).sum

