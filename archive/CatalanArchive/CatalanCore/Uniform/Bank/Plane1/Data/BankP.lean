module

public import CatalanCore.Uniform.Bank.Plane1.Data.Lam
public import CatalanCore.Uniform.Bank.Plane1.Data.HeadP
public import CatalanCore.Uniform.Bank.Plane1.Data.TP1
public import CatalanCore.Uniform.Bank.Plane1.Data.TP5

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Plane 1 content: the bank check of `S⁺` (wave H5a; generated by `plane_gen.py`)

`kDataP = {kHeadP with Λ := planeLam, tmpls}`; **`kdataP_check : kcheck kDataP = true`**. -/

namespace CatalanCore.Uniform.Bank.Plane1.Data
open CatalanCore.Uniform.Content.BankShared.KTerm CatalanCore.Uniform.Content.BankShared.Check

/-- The plane 1 content bank of the support. -/
def kDataP : KBankData := { kHeadP with Λ := planeLam, tmpls := [(1, ktmplP1), (5, ktmplP5)] }

theorem ktmplP1_okD : ktmplOK kDataP 1 ktmplP1 = true :=
  ktmplOK_withTmpls kHeadP _ _ 1 ktmplP1 ktmplP1_ok

theorem ktmplP5_okD : ktmplOK kDataP 5 ktmplP5 = true :=
  ktmplOK_withTmpls kHeadP _ _ 5 ktmplP5 ktmplP5_ok

-- kcost: parameters and class sums (a handful of rational comparisons), measured in the pricing run
theorem kdataP_params : kcheckParams kDataP = true := by decide +kernel

theorem kdataP_classes : kclassOK kDataP = true := by decide +kernel

theorem kdataP_tmpls : kDataP.tmpls.all (fun x => ktmplOK kDataP x.1 x.2) = true := by
  show [(1, ktmplP1), (5, ktmplP5)].all (fun x => ktmplOK kDataP x.1 x.2) = true
  simp only [List.all_cons, List.all_nil, ktmplP1_okD, ktmplP5_okD, Bool.and_self]

/-- **The plane 1 content catalogue of the support passes `kcheck`.** -/
theorem kdataP_check : kcheck kDataP = true := by
  unfold kcheck
  rw [kdataP_params, kdataP_tmpls, kdataP_classes]
  rfl

theorem kDataP_cat : ∀ br ∈ kDataP.kcat, CatalanCore.Uniform.Bank.Plane1.PlaneBranch br :=
  planeCatOf_plane kPresP

end CatalanCore.Uniform.Bank.Plane1.Data

