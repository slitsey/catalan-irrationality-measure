module

public import CatalanCore.Uniform.Bank.Plane1.Content
public import CatalanCore.Uniform.Content.BankShared.KTerm.Split
public import CatalanCore.Uniform.Content.BankShared.KTerm.Prefix

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Plane 1 content catalogue: common header (wave H5a; ledger P115; generated by `work/tools/h/h5a/plane_gen.py`)

`planeHeadOf ρ a pres` is the header bank of the plane content check on the support with `3 k_A = j p + ρ`
(`ρ = 2`, `a = 1` on `S⁺`; `ρ = 1`, `a = 5` on `S⁻`): master modulus `Q = M = 6`, `α = 1/12` (`c = 1/6 = 2 α`),
shifts `[(3, ρ, 1), (2, 1, 1)]`, depth `64`, `c_F = 23`, `P_bad = 6`, `α₀ = α₀ᵇ = 5/2`, `t₀ = 1/68`, `τ = 9`,
`R_t = 2`, and the catalogue `planeTrop ++ prefix branches` (`kbT0` is the tail branch, index `5`).  Every
branch is a `PlaneBranch`, so the bank satisfies the catalogue hypothesis of `plane_content`. -/

namespace CatalanCore.Uniform.Bank.Plane1.Data
open CatalanCore.Uniform.Content.BankShared.KTerm CatalanCore.Uniform.Content.BankShared.Check

/-- `n / d`. -/
abbrev qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

/-- The catalogue: the six tropical branches of `planeTrop`, then the prefix branches `kbrPre n j₀ [j₁, j₂]`. -/
def planeCatOf (pres : List (ℕ × ℕ × ℕ × ℕ)) : List KBranch :=
  planeTrop ++ pres.map (fun x => kbrPre x.1 x.2.1 [x.2.2.1, x.2.2.2])

/-- Every branch of `planeCatOf pres` is a plane branch. -/
theorem planeCatOf_plane (pres : List (ℕ × ℕ × ℕ × ℕ)) :
    ∀ br ∈ planeCatOf pres, CatalanCore.Uniform.Bank.Plane1.PlaneBranch br := by
  intro br hbr
  simp only [planeCatOf, List.mem_append, List.mem_map] at hbr
  rcases hbr with h | ⟨x, _, rfl⟩
  · exact Or.inl h
  · exact Or.inr ⟨x.1, x.2.1, x.2.2.1, x.2.2.2, rfl⟩

/-- The header bank of a support (`ρ`, master member `a`), without templates. -/
def planeHeadOf (ρ a : ℕ) (pres : List (ℕ × ℕ × ℕ × ℕ)) : KBankData where
  Q := 6
  M := 6
  α := qq 1 12
  a := a
  shifts := [⟨3, ρ, 1⟩, ⟨2, 1, 1⟩]
  depth := 64
  cF := 23
  Pbad := 6
  α0 := qq 5 2
  τ := qq 9 1
  Λ := 0
  α0b := qq 5 2
  t0 := qq 1 68
  Rt := qq 2 1
  kcat := planeCatOf pres
  tmpls := []

end CatalanCore.Uniform.Bank.Plane1.Data
