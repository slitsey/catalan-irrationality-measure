module

public import CatalanCore.Uniform.Bank.Plane1.Data.HeadP
public import CatalanCore.Uniform.Bank.Plane1.Data.LP5_0
public import CatalanCore.Uniform.Bank.Plane1.Data.LP5_1
public import CatalanCore.Uniform.Bank.Plane1.Data.LP5_2
public import CatalanCore.Uniform.Bank.Plane1.Data.LP5_3
public import CatalanCore.Uniform.Bank.Plane1.Data.LP5_4
public import CatalanCore.Uniform.Bank.Plane1.Data.LP5_5

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Plane 1 content: template of `S⁺`, root class `j = 5` (wave H5a; generated by `plane_gen.py`)

`ktmplP5_ok : ktmplOK kHeadP 5 ktmplP5 = true`: the head (chain, tail branch `kbT0` = index 5, `τ`)
and the pieces of the leaves. -/

namespace CatalanCore.Uniform.Bank.Plane1.Data
open CatalanCore.Uniform.Content.BankShared.KTerm CatalanCore.Uniform.Content.BankShared.Check

def ktmplP5 : KTmpl := ⟨qq 1 396, lfP5_0 ++ (lfP5_1 ++ (lfP5_2 ++ (lfP5_3 ++ (lfP5_4 ++ (lfP5_5))))), 5⟩

-- kcost: chain over the pieces and the tail test (comparisons of small rationals), measured in the pricing run
theorem ktmplP5_head : ktmplHead kHeadP 5 ktmplP5 = true := by decide +kernel

theorem ktmplP5_ok : ktmplOK kHeadP 5 ktmplP5 = true := by
  unfold ktmplOK
  rw [ktmplP5_head]
  show (true && kpieceAll kHeadP 5 (lfP5_0 ++ (lfP5_1 ++ (lfP5_2 ++ (lfP5_3 ++ (lfP5_4 ++ (lfP5_5))))))) = true
  simp only [kpieceAll_append, lfP5_0_ok, lfP5_1_ok, lfP5_2_ok, lfP5_3_ok, lfP5_4_ok, lfP5_5_ok, Bool.and_self]

end CatalanCore.Uniform.Bank.Plane1.Data
