module

public import CatalanCore.Uniform.Bank.Plane1.Data.HeadP
public import CatalanCore.Uniform.Bank.Plane1.Data.LP1_0
public import CatalanCore.Uniform.Bank.Plane1.Data.LP1_1
public import CatalanCore.Uniform.Bank.Plane1.Data.LP1_2
public import CatalanCore.Uniform.Bank.Plane1.Data.LP1_3
public import CatalanCore.Uniform.Bank.Plane1.Data.LP1_4
public import CatalanCore.Uniform.Bank.Plane1.Data.LP1_5

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Plane 1 content: template of `S⁺`, root class `j = 1` (wave H5a; generated by `plane_gen.py`)

`ktmplP1_ok : ktmplOK kHeadP 1 ktmplP1 = true`: the head (chain, tail branch `kbT0` = index 5, `τ`)
and the pieces of the leaves. -/

namespace CatalanCore.Uniform.Bank.Plane1.Data
open CatalanCore.Uniform.Content.BankShared.KTerm CatalanCore.Uniform.Content.BankShared.Check

def ktmplP1 : KTmpl := ⟨qq 1 396, lfP1_0 ++ (lfP1_1 ++ (lfP1_2 ++ (lfP1_3 ++ (lfP1_4 ++ (lfP1_5))))), 5⟩

-- kcost: chain over the pieces and the tail test (comparisons of small rationals), measured in the pricing run
theorem ktmplP1_head : ktmplHead kHeadP 1 ktmplP1 = true := by decide +kernel

theorem ktmplP1_ok : ktmplOK kHeadP 1 ktmplP1 = true := by
  unfold ktmplOK
  rw [ktmplP1_head]
  show (true && kpieceAll kHeadP 1 (lfP1_0 ++ (lfP1_1 ++ (lfP1_2 ++ (lfP1_3 ++ (lfP1_4 ++ (lfP1_5))))))) = true
  simp only [kpieceAll_append, lfP1_0_ok, lfP1_1_ok, lfP1_2_ok, lfP1_3_ok, lfP1_4_ok, lfP1_5_ok, Bool.and_self]

end CatalanCore.Uniform.Bank.Plane1.Data
