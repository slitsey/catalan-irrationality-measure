  · intro ε hε i hi c hc p hp hpc hlt hpf
    have hlt' := hlt
    simp only [h4] at hlt'
    have hfl : ⌊(4 : ℝ) * (G310.scale i : ℝ)⌋₊ = 4 * i.1 := by
      have : (4 : ℝ) * (G310.scale i : ℝ) = ((4 * i.1 : ℕ) : ℝ) := by
        show (4 : ℝ) * (i.1 : ℝ) = _; push_cast; ring
      rw [this, Nat.floor_natCast]
    rw [hfl] at hlt'
    exact thirds_tail_gle thirdsAc_data depth i hi p hlt'
  · intro ε hε i hi c hc p h1' hp hpc hpf
    have ht1 : (tmplFull_1 c).t1 = 3 / 1000 := by
      simp only [tmplFull_1]; split_ifs <;> rfl
    have hα : (tmplFull_1 c).α0 = 23 / 10 := by
