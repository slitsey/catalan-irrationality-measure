    simp only [ht1] at h1'
    have hfl : ⌊(3 / 1000 : ℝ) * (G310.scale i : ℝ)⌋₊ = 3 * i.1 / 1000 := by
      have := CatalanCore.Arith.Hybrid.floor_frac 3 1000 i.1
      simpa using this
    rw [hfl] at h1'
    have := thirds_pre_gle thirdsAc_data depth i hi p (five_le_of_unit hp hc hpc) h1'
    simp only [hα]
    exact this
