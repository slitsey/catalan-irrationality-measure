theorem units6 (c : ZMod 6) : IsUnit c ↔ (c = 1 ∨ c = 5) := by
  have : ∀ c : ZMod 6, (∃ y : ZMod 6, c * y = 1) ↔ (c = 1 ∨ c = 5) := by decide
  rw [isUnit_iff_exists_inv]
  exact this c

theorem unitClasses6 : unitClasses 6 = {1, 5} := by
  ext c
  simp only [mem_unitClasses, Finset.mem_insert, Finset.mem_singleton]
  exact units6 c

theorem five_le_of_unit {p : ℕ} (hp : p.Prime) {c : ZMod 6} (hc : IsUnit c)
    (hpc : (p : ZMod 6) = c) : 5 ≤ p := by
  rcases (units6 c).1 hc with rfl | rfl
  · have := cls6 (r := 1) (by simpa using hpc) (by norm_num); have := hp.two_le; omega
  · have := cls6 (r := 5) (by simpa using hpc) (by norm_num); have := hp.two_le; omega

