  rw [h6]
  have h51 : (5 : ZMod 6) ≠ 1 := by decide
  simp only [tmplFull_1, if_true, if_neg h51]
  rw [tmpl_1_1_mass, tmpl_1_5_mass]
  norm_num [LamFin]

