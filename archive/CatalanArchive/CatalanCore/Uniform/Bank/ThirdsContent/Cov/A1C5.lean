  have hp5 : 5 ≤ p := by have := hp.out.two_le; omega
  by_cases hr : i.1 < 10 ^ 6
  · exact pcov_small (by simp [cFr_thirdsAc]) i hi hr p hp.out.two_le _ _ _ _ (by norm_num) (by omega)
