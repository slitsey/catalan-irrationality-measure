theorem newFirst5_end : lastEnd (1/4) newFirst5 = 1/2 := by
  simp [newFirst5, lastEnd, mkPiece] <;> norm_num

theorem newFirst5_covers {r m : ℕ} (hm1 : r ≤ 4 * m) (hm2 : 4 * m ≤ r + 3) (hr : 100 ≤ r) :
    ∀ P ∈ newFirst5, Covers (5 : ZMod 6) (fun p => (Wn r m p : ℝ)) r P := by
  intro P hP
  simp only [newFirst5, List.mem_cons, List.mem_nil_iff, or_false] at hP
  rcases hP with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [cov5_0 hm1 hm2 hr, cov5_1 hm1 hm2 hr, cov5_2 hm1 hm2 hr, cov5_3 hm1 hm2 hr, cov5_4 hm1 hm2 hr, cov5_5 hm1 hm2 hr, cov5_6 hm1 hm2 hr, cov5_7 hm1 hm2 hr, cov5_8 hm1 hm2 hr, cov5_9 hm1 hm2 hr, cov5_10 hm1 hm2 hr, cov5_11 hm1 hm2 hr, cov5_12 hm1 hm2 hr, cov5_13 hm1 hm2 hr, cov5_14 hm1 hm2 hr]

end CatalanCore.Uniform.Bank.Chi3Content
