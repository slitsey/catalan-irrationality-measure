module

public import CatalanCore.Uniform.Bank.Chi3Content.Weight

@[expose] public section

/-!
# Class 1: the M3D windows on the first tropical piece (lane B, B3c; generated by
`scripts/claude/bank/chi3content/emit_windows.py`).  The first old piece `11/4 - theta` on
`(1/4, 1/2]` is replaced by 12 pieces; every cover is `omega`-checkable affine arithmetic
(`nocut_window` + `M3Hyp`), with the old bound as fallback where the segment is shorter than 8.
-/

open Finset Filter CatalanCore CatalanCore.Arith CatalanCore.Arith.Hybrid CatalanFrames.HybCommon
  CatalanFrames.P6 CatalanFrames.P6Hybrid

set_option maxHeartbeats 3200000
set_option maxRecDepth 4000

namespace CatalanCore.Uniform.Bank.Chi3Content

theorem cov1_0 {r m : ℕ} (hm1 : r ≤ 4 * m) (hm2 : 4 * m ≤ r + 3) (hr : 100 ≤ r) :
    Covers (1 : ZMod 6) (fun p => (Wn r m p : ℝ)) r (mkPiece 1 4 3 11 (3) (-2) 100 1) :=
  CatalanFrames.HybGen.covers_mkM (1 : ZMod 6) (fun p => p % 6 = 1) (fun p _ h => cls_one h) (Wn r m) r 1 4 3 11 (3) (-2) 100 1 (by norm_num)
    (fun p hs ht hpp hcn => by
      have hold := W_old_first hm1 hm2 hr (Or.inl hcn) (by omega) (by omega)
      have hWW := Wn_le_W r m p
      by_cases hlen : max (r + 2*m - p) (r + 2 * m - p) + 8 ≤ r + p
      · have h26 : 26 ≤ p := by omega
        have hpp2 : 26 * p ≤ p * p := Nat.mul_le_mul_right p h26
        have hM : M3Hyp r m p (r + 2*m - p) (r + p) :=
          ⟨hpp, by omega, by omega, by omega, by omega, by omega, by omega, by omega,
            nocut_window p r (r + 2*m - p) (r + p) (by omega) 4 13 1 9 0 0
              ⟨by omega, by omega⟩ ⟨by omega, by omega⟩
              (by intro i hi1 hi2; interval_cases i <;> omega)
              ⟨by omega, by omega⟩
              (by intro i hi1 hi2; interval_cases i <;> omega) ⟨by omega, by omega⟩⟩
        have he := (Wn_le_e r m p).trans (eExp_le_m3 hM)
        unfold m3price at he
        omega
      · omega)

