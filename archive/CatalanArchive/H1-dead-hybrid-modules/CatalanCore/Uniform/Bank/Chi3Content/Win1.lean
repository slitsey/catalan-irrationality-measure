noncomputable def newFirst1 : List Piece :=
  [mkPiece 1 4 3 11 (3) (-2) 100 1, mkPiece 3 11 5 18 (3) (7) 200 2, mkPiece 5 18 9 32 (8) (-11) 200 2, mkPiece 9 32 2 7 (15) (-1) 600 6, mkPiece 2 7 15 52 (9) (20) 600 6, mkPiece 15 52 3 10 (12) (-16) 300 3, mkPiece 3 10 5 16 (3) (6) 200 2, mkPiece 5 16 1 3 (4) (-5) 100 1, mkPiece 1 3 5 14 (3) (5) 200 2, mkPiece 5 14 5 12 (11) (-4) 400 4, mkPiece 5 12 3 7 (4) (-4) 100 1, mkPiece 3 7 1 2 (5) (-1) 200 2]

theorem newFirst1_chain : Chain (1/4) newFirst1 := by
  simp only [newFirst1, Chain, mkPiece]; norm_num

theorem newFirst1_end : lastEnd (1/4) newFirst1 = 1/2 := by
  simp [newFirst1, lastEnd, mkPiece] <;> norm_num

theorem newFirst1_covers {r m : ℕ} (hm1 : r ≤ 4 * m) (hm2 : 4 * m ≤ r + 3) (hr : 100 ≤ r) :
    ∀ P ∈ newFirst1, Covers (1 : ZMod 6) (fun p => (Wn r m p : ℝ)) r P := by
  intro P hP
  simp only [newFirst1, List.mem_cons, List.mem_nil_iff, or_false] at hP
  rcases hP with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [cov1_0 hm1 hm2 hr, cov1_1 hm1 hm2 hr, cov1_2 hm1 hm2 hr, cov1_3 hm1 hm2 hr, cov1_4 hm1 hm2 hr, cov1_5 hm1 hm2 hr, cov1_6 hm1 hm2 hr, cov1_7 hm1 hm2 hr, cov1_8 hm1 hm2 hr, cov1_9 hm1 hm2 hr, cov1_10 hm1 hm2 hr, cov1_11 hm1 hm2 hr]

end CatalanCore.Uniform.Bank.Chi3Content
