module

public import CatalanMeasure.GenD.Signed.RouteI.RowCert.PolyN

@[expose] public section

set_option Elab.async false
set_option maxRecDepth 100000
set_option autoImplicit false

/-!
# The square of the row, sign N

kcost: six packs of at most 32767 terms at 167 bits, about 10 s each measured, one product.
-/

namespace CatalanMeasure.GenD.Signed.RouteI.RowCert

open CatalanMeasure.GenD.Signed.RouteI.FreeRowCap0
open CatalanMeasure.GenD.Signed.RouteI.MarkedPilot
open CatalanMeasure.GenD.Signed.RouteI.MarkedSourceTail
open CatalanMeasure.GenD.Signed.RouteI.CapFields
open CatalanMeasure.GenD.Signed.RouteI.CapFields.CapSource
open CatalanMeasure.GenD.Signed.RouteI.CapSourceData
open CatalanMeasure.Signed.ChebSquare
open CatalanMeasure.GenD.Signed.Davis.CircleCheb
open Set

noncomputable def x1N : ℕ := raw_hex% ""
noncomputable def x2N : ℕ := raw_hex% ""
noncomputable def rrN : ℕ := raw_hex% ""
noncomputable def y1N : ℕ := raw_hex% ""
noncomputable def y2N : ℕ := raw_hex% ""
noncomputable def uuN : ℕ := raw_hex% ""
theorem sLenN : sLN.length = 32767 := by
  decide +kernel -- kcost: five list additions of 32767 terms, 3 s measured
theorem qLenN : qN.length = 16384 := by
  decide +kernel -- kcost: one list of 16384 terms
theorem sOffN : sLN.all (fun a => decide (0 ≤ a + (((2 ^ (167 - 1) : ℕ)) : ℤ))) = true := by
  decide +kernel -- kcost: 32767 comparisons
theorem qOffN : qN.all (fun a => decide (0 ≤ a + (((2 ^ (167 - 1) : ℕ)) : ℤ))) = true := by
  decide +kernel -- kcost: 16384 comparisons
theorem p1N : packN 15 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) sLN) = x1N := by
  decide +kernel -- kcost: pack of 32767 terms, 10 s measured
theorem p2N : packN 15 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) sLN.reverse) = x2N := by
  decide +kernel -- kcost: pack of 32767 terms, 10 s measured
theorem p3N : packN 15 (2 ^ 167) (List.replicate sLN.length 1) = rrN := by
  decide +kernel -- kcost: pack of 32767 terms, 10 s measured
theorem p4N : packN 14 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) qN) = y1N := by
  decide +kernel -- kcost: pack of 16384 terms, 3 s measured
theorem p5N : packN 14 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) qN.reverse) = y2N := by
  decide +kernel -- kcost: pack of 16384 terms, 3 s measured
theorem p6N : packN 14 (2 ^ 167) (List.replicate qN.length 1) = uuN := by
  decide +kernel -- kcost: pack of 16384 terms, 3 s measured
theorem sqfN : 2 * ((dPc : ℕ) : ℤ) * (pow2 (167 * (2 * 16383)) * ((x1N : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (rrN : ℤ)) +
        ((x2N : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (rrN : ℤ))) +
      (pow2 (167 * 16383) * ((y1N : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuN : ℤ)) + ((y2N : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuN : ℤ))) *
      (pow2 (167 * 16383) * ((y1N : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuN : ℤ)) + ((y2N : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuN : ℤ))) =
      2 * (2 * ((dPc : ℕ) : ℤ) * cN) * pow2 (167 * (2 * 16383)) := by
  decide +kernel -- kcost: one product of two 5 Mbit integers
theorem sqN : kronEq 167 16383 15 14 ((dPc : ℕ) : ℤ) cN sLN qN = true :=
  kron_packs (by rw [sLenN]; norm_num) (by rw [qLenN]; norm_num) sOffN qOffN p1N p2N p3N p4N p5N p6N sqfN
theorem sqbN : 4 * (2 * ((dPc : ℕ) : ℤ) * l1 sLN + 2 * l1 qN * l1 qN) < pow2 167 := by
  decide +kernel -- kcost: two sums of 32767 terms
theorem sqcN : 8 * (2 * ((dPc : ℕ) : ℤ) * |cN|) < pow2 167 := by
  decide +kernel -- kcost: one product
theorem sqrN : (rN.headD 0 = -16492697069) ∧ l1 rN.tail = 49799145888502483 := by
  decide +kernel -- kcost: one sum of 32767 terms

end CatalanMeasure.GenD.Signed.RouteI.RowCert
