module

public import CatalanMeasure.GenD.Signed.RouteI.RowCert.PolyP

@[expose] public section

set_option Elab.async false
set_option maxRecDepth 100000
set_option autoImplicit false

/-!
# The square of the row, sign P

kcost: six packs of at most 32767 terms at 167 bits, about 10 s each measured, one product.
-/

namespace CatalanMeasure.GenD.Signed.RouteI.RowCert

open CatalanMeasure.GenD.Signed.RouteI.FreeRowCap0
open CatalanMeasure.GenD.Signed.RouteI.MarkedPilot
open CatalanMeasure.GenD.Signed.RouteI.MarkedSourceTail
open CatalanMeasure.GenD.Signed.RouteI.CapFields
open CatalanMeasure.GenD.Signed.RouteI.CapFields.CapSource
open CatalanMeasure.GenD.Signed.RouteI.CapSourceData
open CatalanMeasure.Signed.ChebSquare
open CatalanMeasure.GenD.Signed.Davis.CircleCheb
open Set

noncomputable def x1P : ℕ := raw_hex% ""
noncomputable def x2P : ℕ := raw_hex% ""
noncomputable def rrP : ℕ := raw_hex% ""
noncomputable def y1P : ℕ := raw_hex% ""
noncomputable def y2P : ℕ := raw_hex% ""
noncomputable def uuP : ℕ := raw_hex% ""
theorem sLenP : sLP.length = 32767 := by
  decide +kernel -- kcost: five list additions of 32767 terms, 3 s measured
theorem qLenP : qP.length = 16384 := by
  decide +kernel -- kcost: one list of 16384 terms
theorem sOffP : sLP.all (fun a => decide (0 ≤ a + (((2 ^ (167 - 1) : ℕ)) : ℤ))) = true := by
  decide +kernel -- kcost: 32767 comparisons
theorem qOffP : qP.all (fun a => decide (0 ≤ a + (((2 ^ (167 - 1) : ℕ)) : ℤ))) = true := by
  decide +kernel -- kcost: 16384 comparisons
theorem p1P : packN 15 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) sLP) = x1P := by
  decide +kernel -- kcost: pack of 32767 terms, 10 s measured
theorem p2P : packN 15 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) sLP.reverse) = x2P := by
  decide +kernel -- kcost: pack of 32767 terms, 10 s measured
theorem p3P : packN 15 (2 ^ 167) (List.replicate sLP.length 1) = rrP := by
  decide +kernel -- kcost: pack of 32767 terms, 10 s measured
theorem p4P : packN 14 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) qP) = y1P := by
  decide +kernel -- kcost: pack of 16384 terms, 3 s measured
theorem p5P : packN 14 (2 ^ 167) (offL (((2 ^ (167 - 1) : ℕ)) : ℤ) qP.reverse) = y2P := by
  decide +kernel -- kcost: pack of 16384 terms, 3 s measured
theorem p6P : packN 14 (2 ^ 167) (List.replicate qP.length 1) = uuP := by
  decide +kernel -- kcost: pack of 16384 terms, 3 s measured
theorem sqfP : 2 * ((dPc : ℕ) : ℤ) * (pow2 (167 * (2 * 16383)) * ((x1P : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (rrP : ℤ)) +
        ((x2P : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (rrP : ℤ))) +
      (pow2 (167 * 16383) * ((y1P : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuP : ℤ)) + ((y2P : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuP : ℤ))) *
      (pow2 (167 * 16383) * ((y1P : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuP : ℤ)) + ((y2P : ℤ) - (((2 ^ (167 - 1) : ℕ)) : ℤ) * (uuP : ℤ))) =
      2 * (2 * ((dPc : ℕ) : ℤ) * cP) * pow2 (167 * (2 * 16383)) := by
  decide +kernel -- kcost: one product of two 5 Mbit integers
theorem sqP : kronEq 167 16383 15 14 ((dPc : ℕ) : ℤ) cP sLP qP = true :=
  kron_packs (by rw [sLenP]; norm_num) (by rw [qLenP]; norm_num) sOffP qOffP p1P p2P p3P p4P p5P p6P sqfP
theorem sqbP : 4 * (2 * ((dPc : ℕ) : ℤ) * l1 sLP + 2 * l1 qP * l1 qP) < pow2 167 := by
  decide +kernel -- kcost: two sums of 32767 terms
theorem sqcP : 8 * (2 * ((dPc : ℕ) : ℤ) * |cP|) < pow2 167 := by
  decide +kernel -- kcost: one product
theorem sqrP : (rP.headD 0 = 4141446590298) ∧ l1 rP.tail = 2800664216744096174 := by
  decide +kernel -- kcost: one sum of 32767 terms

end CatalanMeasure.GenD.Signed.RouteI.RowCert
