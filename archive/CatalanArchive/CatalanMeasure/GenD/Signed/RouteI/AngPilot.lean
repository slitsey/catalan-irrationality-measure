    · have hs := pow_stream_err hlo hhi hτ0 hτ1 ha1' ha2 j
      refine hs.trans ?_
      have hjr : (j : ℝ) ≤ 384 := by exact_mod_cast hj
      have hd : 0 ≤ ((D.bL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa - ((D.aL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa := by linarith
      unfold eTq
      push_cast
      have h1 : (j : ℝ) * (((D.bL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa - ((D.aL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa) ≤
          384 * (((D.bL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa - ((D.aL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa) :=
