theorem passAll_tri : passAll triL := by
  intro x hx
  obtain ⟨k, hk, rfl⟩ := List.mem_map.1 hx
  have hk' := List.mem_range.1 hk
  match k, hk' with
  | 0, _ => exact pass_0
  | 1, _ => exact pass_1
  | 2, _ => exact pass_2
  | 3, _ => exact pass_3
  | 4, _ => exact pass_4
  | 5, _ => exact pass_5
  | 6, _ => exact pass_6
  | 7, _ => exact pass_7
  | 8, _ => exact pass_8
  | 9, _ => exact pass_9
  | 10, _ => exact pass_10
  | 11, _ => exact pass_11
  | 12, _ => exact pass_12
  | 13, _ => exact pass_13
  | 14, _ => exact pass_14
  | 15, _ => exact pass_15
  | 16, _ => exact pass_16
  | 17, _ => exact pass_17
  | 18, _ => exact pass_18
  | 19, _ => exact pass_19
  | 20, _ => exact pass_20
  | 21, _ => exact pass_21
  | 22, _ => exact pass_22
  | 23, _ => exact pass_23
  | 24, _ => exact pass_24
  | 25, _ => exact pass_25
  | 26, _ => exact pass_26
  | 27, _ => exact pass_27
  | 28, _ => exact pass_28
  | 29, _ => exact pass_29
  | k + 30, h => omega


theorem map_getD_range {α : Type*} (l : List α) (d : α) (n : ℕ) (h : l.length = n) :
    (List.range n).map (fun k => l.getD k d) = l := by
  subst h
  apply List.ext_getElem
  · simp
  · intro i h1 h2
    simp [List.getD_eq_getElem?_getD, h2]

theorem hbins_tri : triL.map Prod.fst = binsQ := by
  rw [binsQ_eq]
  unfold triL
  rw [List.map_map]
  exact map_getD_range binsLit [] 30 binsLit_length

-- kcost: 30 logs of rationals (about 20 Rat operations each) plus sums.
