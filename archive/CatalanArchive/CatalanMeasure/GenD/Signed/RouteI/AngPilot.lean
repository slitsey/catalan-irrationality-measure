    (Ah := (((D.an : ℚ) / 2 ^ PA : ℚ) : ℝ)) (Bh := (((D.bn : ℚ) / 2 ^ PA : ℚ) : ℝ))
    (wA := ((1 / 2 ^ PA : ℚ) : ℝ)) (wB := ((1 / 2 ^ PA : ℚ) : ℝ)) (δ := (dC : ℝ)) (GM := (GMq D : ℝ))
    hAe hBe hAh hBh (by unfold GMq; push_cast; exact le_refl _) hdC
    (τJ := fun r => tauR r ^ j) (T := fun r => (stream Pa (D.aL.getD r 0) (2 ^ Pa) j : ℝ) / 2 ^ Pa)
    (S := fun r => Sr r j)
    (Sh := fun r => ((tgtQ / (Maux : ℚ) : ℚ) : ℝ) * (((D.pw.getD (j % 186) []).getD r 0 : ℤ) : ℝ) / 2 ^ PY)
    (m := fun r => (mq D r : ℝ)) (eT := fun r => (eTq D r : ℝ))
