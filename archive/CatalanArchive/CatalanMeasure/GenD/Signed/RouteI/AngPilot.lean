/-!
# Route I `AngPilot`: ONE real `AngRadiusCert` (positive species, radius index 1, gas degree 255)

The first complete radius certificate on the real source `CapSourceData.capSource`: the worst-degree
radius of the angular cap `AngCap (finite 384) pos (29557/200000)`. Every field of
`AngularCap.AngRadiusCert` is filled:

* `bins`, `hb`: the 30 nonempty bins of the K = 32 grid, as exact rational pieces `QC` (cells cut at
  `Y_j = (j^2 + 1024) / (32 j)`), `Partitioned` through `CellCut` (`cutQ_sound`, `partitioned_pos`).
* gas coefficients (`hG`): per piece two root brackets `n / 2^128` (`Hat`), `WLog.lnQP` logs, exact
  moments (`binFold_spec`), 192-bit seeds and alpha numerators, floor power streams with ceiling
  coefficients (`glFast_eq`), the constant coefficient from logs of the bin bases (`constSum`);
  `gas_cert` applies `GasCert.gasCert_pos` to the 30 records.
* auxiliary coefficients (`hA`), tail (`hT`): `auxA_eq` (16 radius classes), exponential enclosures,
  `stream` fixed-point powers, a shared integer cosine/class table, `aux_coef_err`, `hA_bound`,
  `tail_bound`.
* `SquareIdentity` through `KronSquare`, margin `hm`.

No sorry, no native_decide, no new axioms.
-/

namespace CatalanMeasure.GenD.Signed.RouteI.AngPilot
open CatalanMeasure.GenD.Signed.RouteI
open CatalanMeasure.GenD.Signed.RouteI.CapFields
open CatalanMeasure.GenD.Signed.RouteI.MomentSource
open CatalanMeasure.GenD.Signed.RouteI.MomentInputs

noncomputable section

/-- A rational uniform cell. -/
structure QC where
  lo : ℚ
  hi : ℚ
  w : ℚ
deriving DecidableEq

@[reducible] def QC.ok (c : QC) : Prop := c.lo < c.hi ∧ 0 ≤ c.w

def QC.toY (c : QC) : YCell :=
  if h : c.lo < c.hi ∧ 0 ≤ c.w then
    ⟨(c.lo : ℝ), (c.hi : ℝ), (c.w : ℝ), by exact_mod_cast h.1, by exact_mod_cast h.2⟩
  else ⟨0, 1, 0, zero_lt_one, le_rfl⟩

theorem QC.toY_lo {c : QC} (h : c.ok) : c.toY.lo = (c.lo : ℝ) := by
  unfold QC.toY; simp only [dif_pos h]
theorem QC.toY_hi {c : QC} (h : c.ok) : c.toY.hi = (c.hi : ℝ) := by
  unfold QC.toY; simp only [dif_pos h]
theorem QC.toY_w {c : QC} (h : c.ok) : c.toY.w = (c.w : ℝ) := by
  unfold QC.toY; simp only [dif_pos h]

def QC.left (c : QC) (m : ℚ) : QC := ⟨c.lo, m, c.w * (m - c.lo) / (c.hi - c.lo)⟩
def QC.right (c : QC) (m : ℚ) : QC := ⟨m, c.hi, c.w * (c.hi - m) / (c.hi - c.lo)⟩

def cutQ (c : QC) : List ℚ → List QC
  | [] => [c]
  | m :: ms => c.left m :: cutQ (c.right m) ms

def cutOK : QC → List ℚ → Bool
  | c, [] => decide (c.lo < c.hi ∧ 0 ≤ c.w)
  | c, m :: ms => decide (c.lo < m ∧ m < c.hi ∧ 0 ≤ c.w) && cutOK (c.right m) ms

theorem left_ok {c : QC} {m : ℚ} (h1 : c.lo < m) (h2 : m < c.hi) (hw : 0 ≤ c.w) : (c.left m).ok := by
  refine ⟨h1, ?_⟩
  show 0 ≤ c.w * (m - c.lo) / (c.hi - c.lo)
  exact div_nonneg (mul_nonneg hw (by linarith)) (by linarith)

theorem right_ok {c : QC} {m : ℚ} (h1 : c.lo < m) (h2 : m < c.hi) (hw : 0 ≤ c.w) : (c.right m).ok := by
  refine ⟨h2, ?_⟩
  show 0 ≤ c.w * (c.hi - m) / (c.hi - c.lo)
  exact div_nonneg (mul_nonneg hw (by linarith)) (by linarith)

theorem YCell.ext_of (a b : YCell) (h1 : a.lo = b.lo) (h2 : a.hi = b.hi) (h3 : a.w = b.w) : a = b := by
  cases a; cases b; simp_all

theorem toY_left {c : QC} {m : ℚ} (h1 : c.lo < m) (h2 : m < c.hi) (hw : 0 ≤ c.w)
    (g1 g2) : (c.left m).toY = c.toY.left (m : ℝ) g1 g2 := by
  have hc : c.ok := ⟨by linarith, hw⟩
  have hl := left_ok h1 h2 hw
  apply YCell.ext_of
  · rw [QC.toY_lo hl]; simp [QC.left, YCell.left, QC.toY_lo hc]
  · rw [QC.toY_hi hl]; simp [QC.left, YCell.left]
  · rw [QC.toY_w hl]; simp only [YCell.left, QC.left, QC.toY_lo hc, QC.toY_hi hc, QC.toY_w hc]; push_cast; rfl

theorem toY_right {c : QC} {m : ℚ} (h1 : c.lo < m) (h2 : m < c.hi) (hw : 0 ≤ c.w)
    (g1 g2) : (c.right m).toY = c.toY.right (m : ℝ) g1 g2 := by
  have hc : c.ok := ⟨by linarith, hw⟩
  have hl := right_ok h1 h2 hw
  apply YCell.ext_of
  · rw [QC.toY_lo hl]; simp [QC.right, YCell.right]
  · rw [QC.toY_hi hl]; simp [QC.right, YCell.right, QC.toY_hi hc]
  · rw [QC.toY_w hl]; simp only [YCell.right, QC.right, QC.toY_lo hc, QC.toY_hi hc, QC.toY_w hc]; push_cast; rfl

theorem cutQ_ok : ∀ (ms : List ℚ) (c : QC), cutOK c ms = true → ∀ p ∈ cutQ c ms, p.ok := by
  intro ms
  induction ms with
  | nil => intro c h p hp; simp [cutOK] at h; simp [cutQ] at hp; subst hp; exact h
  | cons m ms ih =>
    intro c h p hp
    simp only [cutOK, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2, hw⟩, h3⟩ := h
    simp only [cutQ, List.mem_cons] at hp
    rcases hp with rfl | hp
    · exact left_ok h1 h2 hw
    · exact ih _ h3 p hp

theorem cutQ_sound : ∀ (ms : List ℚ) (c : QC), cutOK c ms = true →
    CellCut c.toY ((cutQ c ms).map QC.toY) := by
  intro ms
  induction ms with
  | nil =>
    intro c h
    simp only [cutQ, List.map_cons, List.map_nil]
    exact CellCut.refl _
  | cons m ms ih =>
    intro c h
    simp only [cutOK, Bool.and_eq_true, decide_eq_true_eq] at h
    obtain ⟨⟨h1, h2, hw⟩, h3⟩ := h
    have hc : c.ok := ⟨by linarith, hw⟩
    have g1 : c.toY.lo < (m : ℝ) := by rw [QC.toY_lo hc]; exact_mod_cast h1
    have g2 : (m : ℝ) < c.toY.hi := by rw [QC.toY_hi hc]; exact_mod_cast h2
    have ih' := ih (c.right m) h3
    rw [toY_right h1 h2 hw g1 g2] at ih'
    have := CellCut.split c.toY (m : ℝ) g1 g2 (L1 := [(c.left m).toY]) (L2 := (cutQ (c.right m) ms).map QC.toY)
      (by rw [toY_left h1 h2 hw g1 g2]; exact CellCut.refl _) ih'
    simpa [cutQ] using this




theorem group_perm {α : Type*} (idx : α → ℕ) (l : List α) :
    ∀ K : ℕ, ((List.range K).map fun j => l.filter fun a => idx a == j).flatten.Perm
      (l.filter fun a => decide (idx a < K)) := by
  intro K
  induction K with
  | zero => simp
  | succ K ih =>
    rw [List.range_succ, List.map_append, List.flatten_append]
    simp only [List.map_cons, List.map_nil, List.flatten_cons, List.flatten_nil, List.append_nil]
    have h1 : (l.filter fun a => decide (idx a < K + 1)).Perm
        ((l.filter fun a => decide (idx a < K)) ++ (l.filter fun a => idx a == K)) := by
      have := List.filter_append_perm (fun a => decide (idx a < K)) (l.filter fun a => decide (idx a < K + 1))
      have e1 : (l.filter fun a => decide (idx a < K + 1)).filter (fun a => decide (idx a < K)) =
          l.filter fun a => decide (idx a < K) := by
        rw [List.filter_filter]; apply List.filter_congr; intro a _
        by_cases h : idx a < K
        · simp [h, show idx a < K + 1 by omega]
        · simp [h]
      have e2 : (l.filter fun a => decide (idx a < K + 1)).filter (fun a => !decide (idx a < K)) =
          l.filter fun a => idx a == K := by
        rw [List.filter_filter]; apply List.filter_congr; intro a _
        by_cases h : idx a < K
        · simp [h]; omega
        · by_cases h2 : idx a = K
          · simp [h, h2]
          · have : ¬ idx a < K + 1 := by omega
            simp [h, h2, this]
      rw [e1, e2] at this
      exact this.symm
    exact (ih.append (List.Perm.refl _)).trans h1.symm

theorem flatten_filter_ne_nil {α : Type*} (L : List (List α)) :
    (L.filter fun b => decide (b ≠ [])).flatten = L.flatten := by
  induction L with
  | nil => rfl
  | cons b L ih =>
    by_cases h : b = []
    · subst h; rw [List.filter_cons_of_neg (by simp), ih]; simp
    · rw [List.filter_cons_of_pos (by simpa using h), List.flatten_cons, ih, List.flatten_cons]



/-! ### The concrete positive-species source -/
open CapSourceData

def Tt : ℤ := 999997120790

theorem Tt_eq : sumP row0 = Tt := by decide +kernel

def qcOf (t : Tr) : QC := ⟨(t.1 : ℚ) / 10 ^ 12, (t.2.1 : ℚ) / 10 ^ 12, (t.2.2 : ℚ) / (Tt : ℚ)⟩

theorem qcOf_ok {t : Tr} (hv : t.1 < t.2.1 ∧ 0 ≤ t.2.2) : (qcOf t).ok := by
  have hT : (0 : ℚ) < Tt := by
    have : 0 < Tt := by rw [← Tt_eq]; exact row0_tot
    exact_mod_cast this
  refine ⟨?_, ?_⟩
  · show (t.1 : ℚ) / 10 ^ 12 < (t.2.1 : ℚ) / 10 ^ 12
    have : (t.1 : ℚ) < t.2.1 := by exact_mod_cast hv.1
    linarith
  · show 0 ≤ (t.2.2 : ℚ) / (Tt : ℚ)
    have : (0 : ℚ) ≤ t.2.2 := by exact_mod_cast hv.2
    exact div_nonneg this hT.le

theorem qcOf_toY {t : Tr} (hv : t.1 < t.2.1 ∧ 0 ≤ t.2.2) : (qcOf t).toY = mkCell 1 Tt t := by
  have hok := qcOf_ok hv
  have hT0 : 0 ≤ Tt := by rw [← Tt_eq]; exact row0_tot.le
  have h := mkCell_eq (m := 1) (T := Tt) hv hT0 zero_le_one
  apply YCell.ext_of
  · rw [QC.toY_lo hok, h.1]; simp [qcOf]
  · rw [QC.toY_hi hok, h.2.1]; simp [qcOf]
  · rw [QC.toY_w hok, h.2.2]; simp [qcOf, Tt]

/-- cut points `Y_j = (j^2 + 1024) / (32 j)` (`x = j/32`), ascending (`j = 31, ..., 1`), as (numerator, denominator). -/
def cutsZ : List (ℤ × ℤ) :=
  (List.range 31).reverse.map fun k => (((k + 1 : ℕ) : ℤ) * ((k + 1 : ℕ) : ℤ) + 1024, 32 * ((k + 1 : ℕ) : ℤ))

/-- The cut points strictly inside each cell (cells ascending, so each cut is visited once). -/
def cutLists : List Tr → List (ℤ × ℤ) → List (List ℚ)
  | [], _ => []
  | t :: ts, cs =>
    let cs1 := cs.dropWhile fun x => decide (x.1 * 10 ^ 12 ≤ t.1 * x.2)
    ((cs1.takeWhile fun x => decide (x.1 * 10 ^ 12 < t.2.1 * x.2)).map fun x => Rat.divInt x.1 x.2) ::
      cutLists ts cs1

theorem cutLists_length : ∀ (ts : List Tr) (cs : List (ℤ × ℤ)), (cutLists ts cs).length = ts.length
  | [], _ => rfl
  | t :: ts, cs => by simp [cutLists, cutLists_length ts]

def cellCuts : List (Tr × List ℚ) := gasPosT.zip (cutLists gasPosT cutsZ)

def gasQ : List QC := cellCuts.map fun x => qcOf x.1

def allPieces : List (List QC) := cellCuts.map fun x => cutQ (qcOf x.1) x.2

/-- bin index: the number of cut points `<= lo`. -/
def binOf (p : QC) : ℕ := (cutsZ.takeWhile fun x => decide (x.1 * p.lo.den ≤ p.lo.num * x.2)).length

def tagged : List (ℕ × QC) := allPieces.flatten.map fun p => (binOf p, p)

def binsQ : List (List QC) :=
  ((List.range 32).map fun j => (tagged.filter fun a => a.1 == j).map Prod.snd).filter
    fun b => decide (b ≠ [])

theorem cutsZ_length : cutsZ.length = 31 := by simp [cutsZ]

theorem gasPosT_eq : cellCuts.map Prod.fst = gasPosT := by
  unfold cellCuts
  apply List.map_fst_zip
  rw [cutLists_length]

theorem gas_eq : capSource.gas Sign.pos = gasQ.map QC.toY := by
  show gasCells Sign.pos = _
  simp only [gasCells, gasQ, List.map_map]
  have : gasPosT = cellCuts.map Prod.fst := gasPosT_eq.symm
  conv_lhs => rw [this]
  simp only [List.map_map]
  apply List.map_congr_left
  intro x hx
  have ht : x.1 ∈ gasPosT := by rw [← gasPosT_eq]; exact List.mem_map_of_mem hx
  show mkCell 1 (sumP row0) x.1 = (qcOf x.1).toY
  rw [Tt_eq]
  exact (qcOf_toY (row0_ok x.1 (List.mem_of_mem_filter ht))).symm

-- kcost: 0.05 s estimated; 427 cells, integer cross-multiplications, at most 2 cuts per cell.
theorem cuts_ok : ∀ x ∈ cellCuts, cutOK (qcOf x.1) x.2 = true := by decide +kernel

theorem forall2_cut (L : List (Tr × List ℚ)) (h : ∀ x ∈ L, cutOK (qcOf x.1) x.2 = true) :
    List.Forall₂ CellCut ((L.map fun x => qcOf x.1).map QC.toY)
      ((L.map fun x => cutQ (qcOf x.1) x.2).map (List.map QC.toY)) := by
  induction L with
  | nil => exact List.Forall₂.nil
  | cons x L ih =>
    exact List.Forall₂.cons (cutQ_sound _ _ (h x (by simp))) (ih fun d hd => h d (by simp [hd]))

theorem takeWhile_length_le' {α : Type*} (p : α → Bool) : ∀ l : List α, (l.takeWhile p).length ≤ l.length
  | [] => by simp
  | a :: l => by
    have ih := takeWhile_length_le' p l
    simp only [List.takeWhile_cons]
    split <;> simp <;> omega

theorem binOf_lt (p : QC) : binOf p < 32 := by
  have := takeWhile_length_le' (fun x : ℤ × ℤ => decide (x.1 * p.lo.den ≤ p.lo.num * x.2)) cutsZ
  rw [cutsZ_length] at this
  unfold binOf; omega

theorem partitioned_pos : Partitioned (capSource.gas Sign.pos) (binsQ.map (List.map QC.toY)) := by
  refine ⟨allPieces.map (List.map QC.toY), ?_, ?_⟩
  · rw [gas_eq]; exact forall2_cut cellCuts cuts_ok
  · rw [← List.map_flatten, ← List.map_flatten]
    apply List.Perm.map
    have h1 : binsQ.flatten = (((List.range 32).map fun j => (tagged.filter fun a => a.1 == j).map Prod.snd)).flatten :=
      flatten_filter_ne_nil _
    rw [h1]
    have h2 : ((List.range 32).map fun j => (tagged.filter fun a => a.1 == j).map Prod.snd).flatten =
        (((List.range 32).map fun j => tagged.filter fun a => a.1 == j).flatten).map Prod.snd := by
      rw [List.map_flatten, List.map_map]; rfl
    rw [h2]
    have h3 := group_perm (fun a : ℕ × QC => a.1) tagged 32
    have h4 : (tagged.filter fun a => decide (a.1 < 32)) = tagged :=
      List.filter_eq_self.2 (fun a ha => by
        obtain ⟨p, _, rfl⟩ := List.mem_map.1 ha
        simpa using binOf_lt p)
    rw [h4] at h3
    have h5 : tagged.map Prod.snd = allPieces.flatten := by
      simp [tagged, List.map_map, Function.comp_def]
    rw [← h5]
    exact (h3.map Prod.snd).symm

/-! ### Logarithm of a positive rational through WLog -/
open CatalanMeasure.WLog in
def logQ (x : ℚ) : Option (ℚ × ℚ) :=
  match expPQ x.num.natAbs x.den with
  | some (m, P, Q) => lnQP 5 m P Q
  | none => none

open CatalanMeasure.WLog in
theorem logQ_spec {x v e : ℚ} (hx : 0 < x) (h : logQ x = some (v, e)) :
    |Real.log (x : ℝ) - (v : ℝ)| ≤ (e : ℝ) := by
  unfold logQ at h
  cases h1 : expPQ x.num.natAbs x.den with
  | none => rw [h1] at h; simp at h
  | some t =>
    obtain ⟨m, P, Q⟩ := t
    rw [h1] at h
    simp only at h
    obtain ⟨hQ, hQP, hP2, hq⟩ := expPQ_spec h1
    have hs := lnQP_spec hQ hQP hP2 h
    have hnum : (x.num.natAbs : ℝ) = (x.num : ℝ) := by
      have : 0 < x.num := Rat.num_pos.2 hx
      have h2 : ((x.num.natAbs : ℤ) : ℝ) = (x.num : ℝ) := by
        rw [Int.natAbs_of_nonneg this.le]
      simpa using h2
    have hxr : (x : ℝ) = (x.num.natAbs : ℝ) / (x.den : ℝ) := by
      rw [hnum]; exact Rat.cast_def x
    rw [hxr, hq]
    exact hs

/-- Evaluated primitives at a root `x' = n / 2^128`: `H1 ≈ log x' - x'^2/2`, `H2 ≈ x' - x'^3/3`, error of `H1`. -/
structure HS where
  h1 : ℚ
  h2 : ℚ
  e : ℚ

def XB : ℕ := 2 ^ 128

def Hat (Y : ℚ) (n : ℕ) : Option HS :=
  if 0 < n ∧ n + 1 ≤ XB ∧ (1 : ℚ) / 16 ≤ (n : ℚ) / XB ∧ 0 ≤ ((n : ℚ) / XB) ^ 2 - Y * ((n : ℚ) / XB) + 1 ∧
      (((n : ℚ) + 1) / XB) ^ 2 - Y * (((n : ℚ) + 1) / XB) + 1 ≤ 0 then
    match logQ ((n : ℚ) / XB) with
    | some (v, e) => some ⟨v - ((n : ℚ) / XB) ^ 2 / 2, (n : ℚ) / XB - ((n : ℚ) / XB) ^ 3 / 3,
        e + (16 + (2 + 1 / (XB : ℚ)) / 2) * (1 / (XB : ℚ))⟩
    | none => none
  else none

theorem vY_bracket {Y x x1 : ℝ} (hY : 2 ≤ Y) (hx0 : 0 ≤ x) (hx1 : x1 ≤ 1) (hxx : x ≤ x1)
    (h0 : 0 ≤ x ^ 2 - Y * x + 1) (h1 : x1 ^ 2 - Y * x1 + 1 ≤ 0) : x ≤ vY Y ∧ vY Y ≤ x1 := by
  have hq := vY_quad hY
  have hp := vY_pos hY
  have hle := vY_le_one hY
  constructor
  · by_contra hc
    push_neg at hc
    nlinarith [mul_pos (sub_pos.2 hc) (by nlinarith : 0 < Y - (x + vY Y))]
  · by_contra hc
    push_neg at hc
    nlinarith [mul_pos (sub_pos.2 hc) (by nlinarith : 0 < Y - (x1 + vY Y))]

theorem Hat_spec {Y : ℚ} {n : ℕ} {hs : HS} (hY : (2 : ℝ) ≤ Y) (h : Hat Y n = some hs) :
    |(hs.h1 : ℝ) - H1 (vY Y)| ≤ hs.e ∧ |(hs.h2 : ℝ) - H2 (vY Y)| ≤ 4 / (XB : ℝ) := by
  unfold Hat at h
  split_ifs at h with hc
  obtain ⟨hn0, hn1, hxm, hg0, hg1⟩ := hc
  cases hl : logQ ((n : ℚ) / XB) with
  | none => rw [hl] at h; simp at h
  | some t =>
    obtain ⟨v, e⟩ := t
    rw [hl] at h
    simp only [Option.some.injEq] at h
    subst h
    have hXB : (0 : ℝ) < XB := by unfold XB; positivity
    have hn0' : (0 : ℝ) < n := by exact_mod_cast hn0
    have hn1' : (n : ℝ) + 1 ≤ XB := by exact_mod_cast hn1
    have hx0 : (0 : ℝ) < (n : ℝ) / XB := by positivity
    have hxq : (0 : ℚ) < (n : ℚ) / XB := by
      have : (0 : ℚ) < XB := by unfold XB; positivity
      positivity
    have hlog := logQ_spec hxq hl
    push_cast at hlog
    have hg0' : 0 ≤ ((n : ℝ) / XB) ^ 2 - Y * ((n : ℝ) / XB) + 1 := by
      have h' := (Rat.cast_le (K := ℝ)).2 hg0; push_cast at h'; exact h'
    have hg1' : (((n : ℝ) + 1) / XB) ^ 2 - Y * (((n : ℝ) + 1) / XB) + 1 ≤ 0 := by
      have h' := (Rat.cast_le (K := ℝ)).2 hg1; push_cast at h'; exact h'
    have hx1 : ((n : ℝ) + 1) / XB ≤ 1 := by rw [div_le_one hXB]; exact hn1'
    have hxx : (n : ℝ) / XB ≤ ((n : ℝ) + 1) / XB := by gcongr; linarith
    obtain ⟨hb1, hb2⟩ := vY_bracket hY hx0.le hx1 hxx hg0' hg1'
    have hxm' : (1 : ℝ) / 16 ≤ (n : ℝ) / XB := by
      have h' := (Rat.cast_le (K := ℝ)).2 hxm; push_cast at h'; exact h'
    have hδ : (0 : ℝ) ≤ 1 / (XB : ℝ) := by positivity
    have hd : |vY Y - (n : ℝ) / XB| ≤ 1 / (XB : ℝ) := by
      rw [abs_le]; constructor
      · linarith
      · have : ((n : ℝ) + 1) / XB = (n : ℝ) / XB + 1 / XB := by ring
        linarith
    have hδ1 : 1 / (XB : ℝ) ≤ 1 := by
      rw [div_le_one hXB]; unfold XB; norm_num
    have hvle := vY_le_one hY
    have hvp := vY_pos hY
    constructor
    · have := H1_approx (x := vY Y) (x' := (n : ℝ) / XB) (L' := (v : ℝ)) (δ := 1 / (XB : ℝ)) (η := (e : ℝ))
        (xm := 1 / 16) (by norm_num) (by linarith) hxm' hvle (by
          have : (n : ℝ) / XB ≤ 1 := by linarith
          linarith) hδ hd (by rw [abs_sub_comm]; exact hlog)
      push_cast
      convert this using 2
      ring
    · have := H2_approx (x := vY Y) (x' := (n : ℝ) / XB) (δ := 1 / (XB : ℝ)) hvp.le hvle hx0.le
        (by have : (n : ℝ) / XB ≤ 1 := by linarith
            linarith) hδ hδ1 hd
      push_cast
      convert this using 2
      ring


/-! ### Moment accumulation over the pieces of a bin -/

structure Acc where
  A : ℚ
  B : ℚ
  eA : ℚ
  eB : ℚ

def Acc.add (a b : Acc) : Acc := ⟨a.A + b.A, a.B + b.B, a.eA + b.eA, a.eB + b.eB⟩
def Acc.zero : Acc := ⟨0, 0, 0, 0⟩

def pieceAcc (p : QC) (hl hh : HS) : Acc :=
  ⟨p.w / (p.hi - p.lo) * (hl.h1 - hh.h1), p.w / (p.hi - p.lo) * (hl.h2 - hh.h2),
   2 * (p.w / (p.hi - p.lo)) * (hl.e + hh.e), 2 * (p.w / (p.hi - p.lo)) * (4 / (XB : ℚ))⟩

/-- Fold over the pieces; the endpoint evaluation is reused when a piece starts where the previous one ended. -/
def binFold : List QC → List ℕ → ℚ → HS → Option Acc
  | [], _, _, _ => some Acc.zero
  | p :: ps, nlo :: nhi :: ns, Yc, Hc =>
    match (if p.lo = Yc then some Hc else Hat p.lo nlo), Hat p.hi nhi with
    | some hl, some hh =>
      match binFold ps ns p.hi hh with
      | some r => some ((pieceAcc p hl hh).add r)
      | none => none
    | _, _ => none
  | _ :: _, _, _, _ => none

def Good (Y : ℚ) (h : HS) : Prop :=
  (2 : ℝ) ≤ Y ∧ |(h.h1 : ℝ) - H1 (vY Y)| ≤ h.e ∧ |(h.h2 : ℝ) - H2 (vY Y)| ≤ 4 / (XB : ℝ)

theorem Good_of_Hat {Y : ℚ} {n : ℕ} {hs : HS} (hY : (2 : ℝ) ≤ Y) (h : Hat Y n = some hs) : Good Y hs :=
  ⟨hY, (Hat_spec hY h).1, (Hat_spec hY h).2⟩

theorem Good_e_nonneg {Y : ℚ} {h : HS} (hg : Good Y h) : (0 : ℝ) ≤ h.e :=
  le_trans (abs_nonneg _) hg.2.1

theorem piece_err {p : QC} (hp : p.ok) (h2 : (2 : ℚ) ≤ p.lo) {hl hh : HS}
    (gl : Good p.lo hl) (gh : Good p.hi hh) :
    |((pieceAcc p hl hh).A : ℝ) - p.toY.phys id| ≤ (pieceAcc p hl hh).eA ∧
    |((pieceAcc p hl hh).B : ℝ) - p.toY.phys (fun x => x ^ 2)| ≤ (pieceAcc p hl hh).eB := by
  have hlo := QC.toY_lo hp
  have hhi := QC.toY_hi hp
  have hw := QC.toY_w hp
  have h2' : (2 : ℝ) ≤ p.toY.lo := by rw [hlo]; exact_mod_cast h2
  have el := Good_e_nonneg gl
  have eh := Good_e_nonneg gh
  constructor
  · have := cell_A_err (cl := p.toY) h2' (Hl := (hl.h1 : ℝ)) (Hh := (hh.h1 : ℝ)) (e := (hl.e : ℝ) + (hh.e : ℝ))
      (by rw [hlo]; linarith [gl.2.1]) (by rw [hhi]; linarith [gh.2.1])
    rw [hlo, hhi, hw] at this
    simp only [pieceAcc]
    push_cast
    exact this
  · have := cell_B_err (cl := p.toY) h2' (Hl := (hl.h2 : ℝ)) (Hh := (hh.h2 : ℝ)) (e := 4 / (XB : ℝ))
      (by rw [hlo]; exact gl.2.2) (by rw [hhi]; exact gh.2.2)
    rw [hlo, hhi, hw] at this
    simp only [pieceAcc]
    push_cast
    convert this using 2

theorem binFold_spec : ∀ (ps : List QC) (ns : List ℕ) (Yc : ℚ) (Hc : HS) (acc : Acc),
    (Yc = 0 ∨ Good Yc Hc) → (∀ p ∈ ps, p.ok ∧ (2 : ℚ) ≤ p.lo) → binFold ps ns Yc Hc = some acc →
    |(acc.A : ℝ) - physL (ps.map QC.toY) id| ≤ acc.eA ∧
    |(acc.B : ℝ) - physL (ps.map QC.toY) (fun x => x ^ 2)| ≤ acc.eB := by
  intro ps
  induction ps with
  | nil =>
    intro ns Yc Hc acc _ _ h
    simp only [binFold, Option.some.injEq] at h
    subst h
    simp [Acc.zero, physL]
  | cons p ps ih =>
    intro ns Yc Hc acc hinit hps h
    obtain ⟨hpok, hp2⟩ := hps p (by simp)
    have hrest : ∀ q ∈ ps, q.ok ∧ (2 : ℚ) ≤ q.lo := fun q hq => hps q (by simp [hq])
    cases ns with
    | nil => simp [binFold] at h
    | cons nlo ns1 =>
      cases ns1 with
      | nil => simp [binFold] at h
      | cons nhi ns =>
        simp only [binFold] at h
        have hp2' : (2 : ℝ) ≤ (p.lo : ℝ) := by exact_mod_cast hp2
        -- the left endpoint
        generalize hL : (if p.lo = Yc then some Hc else Hat p.lo nlo) = L at h
        rcases L with _ | hl
        · simp at h
        · have gl : Good p.lo hl := by
            by_cases hc : p.lo = Yc
            · rw [if_pos hc] at hL
              have : Hc = hl := Option.some.inj hL
              subst this
              rcases hinit with h0 | hg
              · exfalso; rw [← hc] at h0; linarith
              · rw [hc]; exact hg
            · rw [if_neg hc] at hL
              exact Good_of_Hat hp2' hL
          cases hh : Hat p.hi nhi with
          | none => rw [hh] at h; simp at h
          | some hhh =>
            rw [hh] at h
            simp only at h
            have gh : Good p.hi hhh := by
              apply Good_of_Hat _ hh
              have : p.lo < p.hi := hpok.1
              have : (p.lo : ℝ) < p.hi := by exact_mod_cast this
              linarith
            cases hr : binFold ps ns p.hi hhh with
            | none => rw [hr] at h; simp at h
            | some r =>
              rw [hr] at h
              simp only [Option.some.injEq] at h
              subst h
              have hih := ih ns p.hi hhh r (Or.inr gh) hrest hr
              have hpe := piece_err hpok hp2 gl gh
              simp only [List.map_cons, physL_cons, Acc.add]
              push_cast
              constructor
              · have := abs_add_le (((pieceAcc p hl hhh).A : ℝ) - p.toY.phys id)
                  ((r.A : ℝ) - physL (ps.map QC.toY) id)
                have e : ((pieceAcc p hl hhh).A : ℝ) + (r.A : ℝ) - (p.toY.phys id + physL (ps.map QC.toY) id) =
                    (((pieceAcc p hl hhh).A : ℝ) - p.toY.phys id) + ((r.A : ℝ) - physL (ps.map QC.toY) id) := by ring
                rw [e]; linarith [hpe.1, hih.1]
              · have := abs_add_le (((pieceAcc p hl hhh).B : ℝ) - p.toY.phys (fun x => x ^ 2))
                  ((r.B : ℝ) - physL (ps.map QC.toY) (fun x => x ^ 2))
                have e : ((pieceAcc p hl hhh).B : ℝ) + (r.B : ℝ) - (p.toY.phys (fun x => x ^ 2) + physL (ps.map QC.toY) (fun x => x ^ 2)) =
                    (((pieceAcc p hl hhh).B : ℝ) - p.toY.phys (fun x => x ^ 2)) + ((r.B : ℝ) - physL (ps.map QC.toY) (fun x => x ^ 2)) := by ring
                rw [e]; linarith [hpe.2, hih.2]


/-! ### From prepared bin data to `RecOK` -/

theorem rec_ok_of_data {rad : ℝ} {P : ℕ} {rH : ℚ} (hr0 : 0 < (rH : ℝ)) (hr1 : (rH : ℝ) ≤ rad)
    (hr2 : rad ≤ rH + 1 / 2 ^ P) (hrad1 : rad ≤ 1)
    {b : List YCell} (hne : b ≠ []) (hl : PosL b) (hw : ∀ c ∈ b, 0 < c.w)
    {m A2 B2 eA eB : ℚ} (hm : massL b = m)
    (hEA : |physL b id - A2| ≤ eA) (hEB : |physL b (fun x => x ^ 2) - B2| ≤ eB)
    {a s0 : ℕ} (hs1 : (s0 : ℝ) ≤ m * 2 ^ P) (hs2 : (m : ℝ) * 2 ^ P < s0 + 1) (hale : a ≤ 2 ^ P)
    (hA2 : (0 : ℝ) ≤ A2) (hD : (0 : ℝ) < m * (rH : ℝ) ^ 2 + B2)
    (hα1 : 2 * (rH : ℝ) * A2 / (m * (rH : ℝ) ^ 2 + B2) ≤ 1)
    (hra : |(a : ℝ) / 2 ^ P - 2 * (rH : ℝ) * A2 / (m * (rH : ℝ) ^ 2 + B2)| ≤ 1 / 2 ^ P)
    (hk : (2 : ℝ) ≤ 3 * rH) (heA : (0 : ℝ) ≤ eA) (heB : (0 : ℝ) ≤ eB) :
    RecOK P (rad ^ 2) rad 1
      (alphaBudget P m eA 3 (1 / 2 ^ P) rH (m * (2 / 2 ^ P) + eB) (m * (rH : ℝ) ^ 2))
      ⟨b, a, s0⟩ := by
  have hrad0 : 0 < rad := lt_of_lt_of_le hr0 hr1
  have hmpos : 0 < massL b := massL_pos hne hw
  rw [hm] at hmpos
  have hmq : (0 : ℝ) < m := hmpos
  have hP2 : (0 : ℝ) < 2 ^ P := by positivity
  have hsq : 0 ≤ physL b (fun x => x ^ 2) := physL_sq_nonneg b
  have hrr : rad ^ 2 - (rH : ℝ) ^ 2 ≤ 2 / 2 ^ P := by
    have h1 : rad - rH ≤ 1 / 2 ^ P := by linarith
    have h2 : (rad - rH) * (rad + rH) ≤ 1 / 2 ^ P * (rad + rH) :=
      mul_le_mul_of_nonneg_right h1 (by linarith)
    have h3 : 1 / 2 ^ P * (rad + rH) ≤ 1 / 2 ^ P * 2 :=
      mul_le_mul_of_nonneg_left (by linarith) (by positivity)
    have e1 : rad ^ 2 - (rH : ℝ) ^ 2 = (rad - rH) * (rad + rH) := by ring
    have e2 : (2 : ℝ) / 2 ^ P = 1 / 2 ^ P * 2 := by ring
    rw [e1, e2]; linarith
  have hrr0 : 0 ≤ rad ^ 2 - (rH : ℝ) ^ 2 := by nlinarith
  have key := recOK_of_prepared (P := P) (pa := rad ^ 2) (pb := rad) (pc := 1) (r := ⟨b, a, s0⟩)
    hl hne hw (by positivity) hrad0 one_pos (by simp)
    (by simpa [hm] using hs1) (by simpa [hm] using hs2) hale (A' := A2) (B' := B2)
    (pa' := (rH : ℝ) ^ 2) (pb' := rH) (pc' := 1) hA2 hr0 (by simpa [hm] using hD)
    (by simpa [hm] using hα1) (by simpa [hm] using hra)
    (eA := eA) (eb := 1 / 2 ^ P) (eD := m * (2 / 2 ^ P) + eB) (kA := 3) (β := rH) (d0 := m * (rH : ℝ) ^ 2)
    (by simpa using hEA) (by rw [abs_le]; constructor <;> linarith)
    (by
      simp only [hm, one_mul, mul_one]
      rw [abs_le]
      constructor
      · have := (abs_le.1 hEB).1
        nlinarith [mul_nonneg hmq.le hrr0]
      · have := (abs_le.1 hEB).2
        have h3 : (m : ℝ) * (rad ^ 2 - rH ^ 2) ≤ m * (2 / 2 ^ P) := mul_le_mul_of_nonneg_left hrr hmq.le
        nlinarith)
    (by
      simp only [hm]
      have : 2 * rad * m ≤ 3 * (m * rad ^ 2) := by nlinarith [mul_nonneg hmq.le hrad0.le]
      nlinarith)
    (by
      simp only [hm, mul_one, one_mul]
      have : (rH : ℝ) ^ 2 ≤ rad ^ 2 := by nlinarith
      nlinarith [mul_le_mul_of_nonneg_left this hmq.le])
    (by positivity) le_rfl hr0 heA (by positivity) (by positivity)
  simpa [hm] using key


/-! ### The per-bin check -/

structure BinD where
  A : ℤ
  B : ℤ
  a : ℕ
  s0 : ℕ

def PP : ℕ := 192
def eAu : ℚ := 1 / 2 ^ 80
def eBu : ℚ := 1 / 2 ^ 100
def binMass (b : List QC) : ℚ := (b.map QC.w).sum

def binPass (rH : ℚ) (b : List QC) (ns : List ℕ) (d : BinD) : Bool :=
  match binFold b ns 0 ⟨0, 0, 0⟩ with
  | none => false
  | some acc =>
    decide (b ≠ [] ∧ (∀ p ∈ b, p.ok ∧ (2 : ℚ) ≤ p.lo ∧ 0 < p.w) ∧
      (d.A : ℚ) ≤ acc.A * 2 ^ PP ∧ acc.A * 2 ^ PP < d.A + 1 ∧
      (d.B : ℚ) ≤ acc.B * 2 ^ PP ∧ acc.B * 2 ^ PP < d.B + 1 ∧
      acc.eA + 1 / 2 ^ PP ≤ eAu ∧ acc.eB + 1 / 2 ^ PP ≤ eBu ∧
      0 ≤ (d.A : ℚ) / 2 ^ PP ∧ 0 ≤ (d.B : ℚ) / 2 ^ PP ∧ 0 < binMass b * rH ^ 2 + (d.B : ℚ) / 2 ^ PP ∧
      2 * rH * ((d.A : ℚ) / 2 ^ PP) ≤ binMass b * rH ^ 2 + (d.B : ℚ) / 2 ^ PP ∧
      (d.a : ℚ) ≤ 2 * rH * ((d.A : ℚ) / 2 ^ PP) / (binMass b * rH ^ 2 + (d.B : ℚ) / 2 ^ PP) * 2 ^ PP ∧
      2 * rH * ((d.A : ℚ) / 2 ^ PP) / (binMass b * rH ^ 2 + (d.B : ℚ) / 2 ^ PP) * 2 ^ PP < d.a + 1 ∧
      d.a ≤ 2 ^ PP ∧ (d.s0 : ℚ) ≤ binMass b * 2 ^ PP ∧ binMass b * 2 ^ PP < d.s0 + 1)

theorem massL_map_toY : ∀ b : List QC, (∀ p ∈ b, p.ok) → massL (b.map QC.toY) = (binMass b : ℝ)
  | [], _ => by simp [massL, binMass]
  | p :: b, h => by
    have ih := massL_map_toY b (fun q hq => h q (by simp [hq]))
    have hw := QC.toY_w (h p (by simp))
    simp only [massL_cons, List.map_cons, ih, hw]
    simp [binMass]

theorem binPass_spec {rad : ℝ} {rH : ℚ} {b : List QC} {ns : List ℕ} {d : BinD}
    (hr0 : 0 < (rH : ℝ)) (hr1 : (rH : ℝ) ≤ rad) (hr2 : rad ≤ rH + 1 / 2 ^ PP) (hrad1 : rad ≤ 1)
    (hk : (2 : ℝ) ≤ 3 * rH) (h : binPass rH b ns d = true) :
    massL (b.map QC.toY) = (binMass b : ℝ) ∧
    |physL (b.map QC.toY) (fun x => x ^ 2) - (((d.B : ℚ) / 2 ^ PP : ℚ) : ℝ)| ≤ (eBu : ℝ) ∧
    (0 : ℝ) ≤ (((d.B : ℚ) / 2 ^ PP : ℚ) : ℝ) ∧ 0 < (binMass b : ℝ) ∧
    RecOK PP (rad ^ 2) rad 1
      (alphaBudget PP (binMass b) eAu 3 (1 / 2 ^ PP) rH (binMass b * (2 / 2 ^ PP) + eBu) (binMass b * (rH : ℝ) ^ 2))
      ⟨b.map QC.toY, d.a, d.s0⟩ := by
  unfold binPass at h
  cases hf : binFold b ns 0 ⟨0, 0, 0⟩ with
  | none => rw [hf] at h; simp at h
  | some acc =>
    rw [hf] at h
    simp only [decide_eq_true_eq] at h
    obtain ⟨hne, hall, hA1, hA2, hB1, hB2, hea, heb, hA0, hB0, hD, hα, ha1, ha2, ha3, hs1, hs2⟩ := h
    have hok : ∀ p ∈ b, p.ok := fun p hp => (hall p hp).1
    have hmass := massL_map_toY b hok
    have hsp := binFold_spec b ns 0 ⟨0, 0, 0⟩ acc (Or.inl rfl) (fun p hp => ⟨(hall p hp).1, (hall p hp).2.1⟩) hf
    have hbne : b.map QC.toY ≠ [] := by simpa using hne
    have hpos : PosL (b.map QC.toY) := by
      intro c hc
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hc
      rw [QC.toY_lo (hall p hp).1]; exact_mod_cast (hall p hp).2.1
    have hwpos : ∀ c ∈ b.map QC.toY, 0 < c.w := by
      intro c hc
      obtain ⟨p, hp, rfl⟩ := List.mem_map.1 hc
      rw [QC.toY_w (hall p hp).1]; exact_mod_cast (hall p hp).2.2
    have hP2 : (0 : ℝ) < 2 ^ PP := by positivity
    have hP2q : (0 : ℚ) < 2 ^ PP := by positivity
    set A2 : ℚ := (d.A : ℚ) / 2 ^ PP with hA2def
    set B2 : ℚ := (d.B : ℚ) / 2 ^ PP with hB2def
    set m : ℚ := binMass b with hmdef
    have hEAgen : ∀ (eu : ℚ) (Aq : ℚ) (dA : ℤ) (eAq : ℚ) (f : (List YCell) → ℝ) (accA : ℚ),
        Aq = (dA : ℚ) / 2 ^ PP → (dA : ℚ) ≤ accA * 2 ^ PP → accA * 2 ^ PP < dA + 1 →
        |(accA : ℝ) - f (b.map QC.toY)| ≤ (eAq : ℝ) → eAq + 1 / 2 ^ PP ≤ eu →
        |f (b.map QC.toY) - (Aq : ℝ)| ≤ (eu : ℝ) := by
      intro eu Aq dA eAq f accA hAq h1 h2 h3 h4
      have a1 : Aq ≤ accA := by rw [hAq, div_le_iff₀ hP2q]; linarith
      have a2 : accA ≤ Aq + 1 / 2 ^ PP := by
        rw [hAq, ← add_div, le_div_iff₀ hP2q]; linarith
      have a1' := (Rat.cast_le (K := ℝ)).2 a1
      have a2' := (Rat.cast_le (K := ℝ)).2 a2
      push_cast at a2'
      have h4' := (Rat.cast_le (K := ℝ)).2 h4
      push_cast at h4'
      rw [abs_sub_comm] at h3
      rw [abs_le] at h3 ⊢
      constructor <;> linarith [h3.1, h3.2]
    have hEA : |physL (b.map QC.toY) id - (A2 : ℝ)| ≤ (eAu : ℝ) :=
      hEAgen eAu A2 d.A acc.eA (fun l => physL l id) acc.A hA2def hA1 hA2 hsp.1 hea
    have hEB : |physL (b.map QC.toY) (fun x => x ^ 2) - (B2 : ℝ)| ≤ (eBu : ℝ) := by
      exact hEAgen eBu B2 d.B acc.eB (fun l => physL l (fun x => x ^ 2)) acc.B hB2def hB1 hB2 hsp.2 heb
    have hDr : (0 : ℝ) < (m : ℝ) * (rH : ℝ) ^ 2 + (B2 : ℝ) := by exact_mod_cast hD
    have hαq : 2 * (rH : ℝ) * (A2 : ℝ) / ((m : ℝ) * (rH : ℝ) ^ 2 + (B2 : ℝ)) ≤ 1 := by
      rw [div_le_one hDr]; exact_mod_cast hα
    have hra : |(d.a : ℝ) / 2 ^ PP - 2 * (rH : ℝ) * (A2 : ℝ) / ((m : ℝ) * (rH : ℝ) ^ 2 + (B2 : ℝ))| ≤ 1 / 2 ^ PP := by
      have b1 : (d.a : ℝ) ≤ 2 * (rH : ℝ) * (A2 : ℝ) / ((m : ℝ) * (rH : ℝ) ^ 2 + (B2 : ℝ)) * 2 ^ PP := by
        exact_mod_cast ha1
      have b2 : 2 * (rH : ℝ) * (A2 : ℝ) / ((m : ℝ) * (rH : ℝ) ^ 2 + (B2 : ℝ)) * 2 ^ PP < d.a + 1 := by
        exact_mod_cast ha2
      have c1 : (d.a : ℝ) / 2 ^ PP ≤ 2 * (rH : ℝ) * (A2 : ℝ) / ((m : ℝ) * (rH : ℝ) ^ 2 + (B2 : ℝ)) := by
        rw [div_le_iff₀ hP2]; exact b1
      have c2 : 2 * (rH : ℝ) * (A2 : ℝ) / ((m : ℝ) * (rH : ℝ) ^ 2 + (B2 : ℝ)) ≤ (d.a : ℝ) / 2 ^ PP + 1 / 2 ^ PP := by
        rw [← add_div, le_div_iff₀ hP2]; linarith
      rw [abs_le]; constructor <;> linarith
    have := rec_ok_of_data (rad := rad) (P := PP) (rH := rH) hr0 hr1 hr2 hrad1 hbne hpos hwpos
      (m := m) (A2 := A2) (B2 := B2) (eA := eAu) (eB := eBu) hmass hEA hEB (a := d.a) (s0 := d.s0)
      (by exact_mod_cast hs1) (by exact_mod_cast hs2) (by exact_mod_cast ha3) (by exact_mod_cast hA0)
      hDr hαq hra hk (by unfold eAu; positivity) (by unfold eBu; positivity)
    have hmpos : 0 < (binMass b : ℝ) := by
      have := massL_pos hbne hwpos
      rw [hmass] at this; exact this
    have hB0r : (0 : ℝ) ≤ ((B2 : ℚ) : ℝ) := by exact_mod_cast hB0
    exact ⟨hmass, hEB, hB0r, hmpos, this⟩


/-! ### exp enclosure -/
open Nat in

def expS (s : ℚ) : ℕ → ℚ
  | 0 => 0
  | n + 1 => expS s n + s ^ n / (n.factorial : ℚ)

theorem expS_cast (s : ℚ) (N : ℕ) : (expS s N : ℝ) = ∑ i ∈ Finset.range N, (s : ℝ) ^ i / (i.factorial : ℝ) := by
  induction N with
  | zero => simp [expS]
  | succ n ih => rw [Finset.sum_range_succ, ← ih]; simp [expS]

def expLoQ (t : ℚ) (N : ℕ) : ℚ :=
  (1 / (expS (t / 8) N + (t / 8) ^ N * (N + 1) / ((N.factorial : ℚ) * N))) ^ 8
def expHiQ (t : ℚ) (N : ℕ) : ℚ := (1 / expS (t / 8) N) ^ 8

theorem expQ_enc (t : ℚ) (ht0 : 0 ≤ t) (ht1 : t ≤ 8) (N : ℕ) (hN : 0 < N) :
    (expLoQ t N : ℝ) ≤ Real.exp (-(t : ℝ)) ∧ Real.exp (-(t : ℝ)) ≤ (expHiQ t N : ℝ) := by
  set s : ℝ := (t : ℝ) / 8 with hs
  have hs0 : 0 ≤ s := by rw [hs]; have : (0:ℝ) ≤ t := by exact_mod_cast ht0
                         positivity
  have hs1 : s ≤ 1 := by
    rw [hs, div_le_one (by norm_num)]; exact_mod_cast ht1
  have hlo : ∑ i ∈ Finset.range N, s ^ i / (i.factorial : ℝ) ≤ Real.exp s := Real.sum_le_exp_of_nonneg hs0 N
  have hhi := Real.exp_bound' hs0 hs1 hN
  have hE0 : 0 < ∑ i ∈ Finset.range N, s ^ i / (i.factorial : ℝ) := by
    obtain ⟨n', rfl⟩ : ∃ n', N = n' + 1 := ⟨N - 1, by omega⟩
    rw [Finset.sum_range_succ']
    have : 0 ≤ ∑ i ∈ Finset.range n', s ^ (i + 1) / ((i + 1).factorial : ℝ) :=
      Finset.sum_nonneg fun i _ => by positivity
    simp only [pow_zero, Nat.factorial_zero, Nat.cast_one, div_one]
    linarith
  have hexp : Real.exp (-(t : ℝ)) = (Real.exp s)⁻¹ ^ 8 := by
    rw [← Real.exp_neg, ← Real.exp_nat_mul]
    congr 1; rw [hs]; push_cast; ring
  have e1 : (expLoQ t N : ℝ) = (1 / (∑ i ∈ Finset.range N, s ^ i / (i.factorial : ℝ) +
      s ^ N * (N + 1) / ((N.factorial : ℝ) * N))) ^ 8 := by
    unfold expLoQ; push_cast; rw [expS_cast]; simp [hs]
  have e2 : (expHiQ t N : ℝ) = (1 / ∑ i ∈ Finset.range N, s ^ i / (i.factorial : ℝ)) ^ 8 := by
    unfold expHiQ; push_cast; rw [expS_cast]; simp [hs]
  rw [e1, e2, hexp]
  have hexp_pos := Real.exp_pos s
  constructor
  · apply pow_le_pow_left₀ (by positivity)
    rw [← one_div]
    exact one_div_le_one_div_of_le hexp_pos hhi
  · apply pow_le_pow_left₀ (by positivity)
    rw [one_div]
    exact inv_anti₀ hE0 hlo



/-! ### The radius -/
/-- radius numerator: `rN / 2^192 <= exp(-sigma_1) <= (rN+1) / 2^192`. -/
def rN : ℕ := 4676705857913616183928900120690230756850916884168092088070

def rH : ℚ := (rN : ℚ) / 2 ^ PP


def sig1 : ℚ := 29431438127090300 / 10 ^ 17

theorem sigma1 : capSource.sigma 1 = (sig1 : ℝ) := by
  show (sigN.getD (min 1 15) 0 : ℝ) / 10 ^ 17 = _
  -- kcost: one list lookup (getD at index 1) on a 16-entry list of 17-digit literals; negligible.
  have : sigN.getD (min 1 15) 0 = 29431438127090300 := by decide +kernel
  rw [this]; simp [sig1]

theorem rad1_eq : capSource.rad 1 = Real.exp (-(sig1 : ℝ)) := by
  show Real.exp (-capSource.sigma 1) = _
  rw [sigma1]

-- kcost: 0.5 s estimated; expS with 28 terms twice (about 900 Rat operations).
theorem rad_numeric : rH ≤ expLoQ sig1 28 ∧ expHiQ sig1 28 ≤ rH + 1 / 2 ^ PP := by decide +kernel

theorem rad_enc : (rH : ℝ) ≤ capSource.rad 1 ∧ capSource.rad 1 ≤ rH + 1 / 2 ^ PP := by
  have h := expQ_enc sig1 (by norm_num [sig1]) (by norm_num [sig1]) 28 (by norm_num)
  obtain ⟨n1, n2⟩ := rad_numeric
  rw [rad1_eq]
  have a := (Rat.cast_le (K := ℝ)).2 n1
  have b := (Rat.cast_le (K := ℝ)).2 n2
  push_cast at a b
  constructor <;> linarith [h.1, h.2]

theorem rH_facts : (0 : ℚ) < rH ∧ (2 : ℚ) ≤ 3 * rH ∧ rH + 1 / 2 ^ PP ≤ 1 := by
  unfold rH rN PP; refine ⟨?_, ?_, ?_⟩ <;> norm_num

/-! ### Families of bins -/

abbrev Tri := List QC × List ℕ × BinD

def recOf (x : Tri) : BinRec := ⟨x.1.map QC.toY, x.2.2.a, x.2.2.s0⟩

def deltaR (r : BinRec) : ℝ :=
  alphaBudget PP (massL r.cells) eAu 3 (1 / 2 ^ PP) rH (massL r.cells * (2 / 2 ^ PP) + eBu)
    (massL r.cells * (rH : ℝ) ^ 2)

def passAll (T : List Tri) : Prop := ∀ x ∈ T, binPass rH x.1 x.2.1 x.2.2 = true

theorem recOK_family {T : List Tri} (h : passAll T) :
    ∀ r ∈ T.map recOf, RecOK PP ((capSource.rad 1) ^ 2) (capSource.rad 1) 1 (deltaR r) r := by
  intro r hr
  obtain ⟨x, hx, rfl⟩ := List.mem_map.1 hr
  obtain ⟨hr1, hr2⟩ := rad_enc
  obtain ⟨h0, hk, h1⟩ := rH_facts
  have hrad1 : capSource.rad 1 ≤ 1 := by
    have : (rH : ℝ) + 1 / 2 ^ PP ≤ 1 := by
      have := (Rat.cast_le (K := ℝ)).2 h1; push_cast at this; exact this
    linarith
  have := (binPass_spec (rad := capSource.rad 1) (by exact_mod_cast h0) hr1 hr2 hrad1
    (by have := (Rat.cast_le (K := ℝ)).2 hk; push_cast at this; exact this) (h x hx)).2.2.2.2
  unfold deltaR recOf
  simp only
  rw [(binPass_spec (rad := capSource.rad 1) (by exact_mod_cast h0) hr1 hr2 hrad1
    (by have := (Rat.cast_le (K := ℝ)).2 hk; push_cast at this; exact this) (h x hx)).1]
  exact this

/-- per-bin coefficient budget `m * delta`. -/
def budQ (m : ℚ) : ℚ :=
  m / 2 ^ PP + 3 * eAu + m * ((1 / 2 ^ PP) / rH * (1 + (m * (2 / 2 ^ PP) + eBu) / (m * rH ^ 2))) +
    m * ((m * (2 / 2 ^ PP) + eBu) / (m * rH ^ 2))

theorem mass_delta {m : ℚ} (hm : 0 < m) :
    (m : ℝ) * alphaBudget PP (m : ℝ) eAu 3 (1 / 2 ^ PP) rH ((m : ℝ) * (2 / 2 ^ PP) + eBu) ((m : ℝ) * (rH : ℝ) ^ 2) =
      (budQ m : ℝ) := by
  have hmr : (0 : ℝ) < m := by exact_mod_cast hm
  rw [mass_mul_alphaBudget hmr]
  unfold budQ
  push_cast
  ring

def cbQ (T : List Tri) : ℚ := 1 / 2 ^ PP + (T.map fun x => 1 / 2 ^ PP + budQ (binMass x.1) / 2).sum

theorem list_sum_cast_map {α : Type*} (l : List α) (f : α → ℚ) :
    (((l.map f).sum : ℚ) : ℝ) = (l.map fun a => (f a : ℝ)).sum := by
  induction l with
  | nil => simp
  | cons a l ih => simp [ih]

theorem coefBudget_eq {T : List Tri} (h : passAll T) :
    coefBudget PP deltaR (T.map recOf) = (cbQ T : ℝ) := by
  obtain ⟨hr1, hr2⟩ := rad_enc
  obtain ⟨h0, hk, h1⟩ := rH_facts
  have hrad1 : capSource.rad 1 ≤ 1 := by
    have : (rH : ℝ) + 1 / 2 ^ PP ≤ 1 := by
      have := (Rat.cast_le (K := ℝ)).2 h1; push_cast at this; exact this
    linarith
  unfold coefBudget cbQ
  push_cast
  rw [List.map_map, List.map_map]
  congr 2
  apply List.map_congr_left
  intro x hx
  have hs := binPass_spec (rad := capSource.rad 1) (by exact_mod_cast h0) hr1 hr2 hrad1
    (by have := (Rat.cast_le (K := ℝ)).2 hk; push_cast at this; exact this) (h x hx)
  simp only [Function.comp_apply, recOf, deltaR]
  rw [hs.1]
  have := mass_delta (m := binMass x.1) (by exact_mod_cast hs.2.2.2.1)
  push_cast
  have e : (1 : ℝ) / 2 ^ PP + (binMass x.1 : ℝ) * alphaBudget PP (binMass x.1 : ℝ) eAu 3 (1 / 2 ^ PP) rH
      ((binMass x.1 : ℝ) * (2 / 2 ^ PP) + eBu) ((binMass x.1 : ℝ) * (rH : ℝ) ^ 2) / 2 =
      1 / 2 ^ PP + (budQ (binMass x.1) : ℝ) / 2 := by rw [this]
  convert e using 2


/-! ### The constant coefficient -/

def eBinLog (x : Tri) : ℚ := (2 / 2 ^ PP + eBu / binMass x.1) / rH ^ 2

def dHat (x : Tri) : ℚ := rH ^ 2 + ((x.2.2.B : ℚ) / 2 ^ PP) / binMass x.1

def logD (x : Tri) : Option (ℚ × ℚ) :=
  match logQ (dHat x) with
  | some (v, e) => some (v, e + eBinLog x)
  | none => none

def constSum : List Tri → Option (ℚ × ℚ)
  | [] => some (0, 0)
  | x :: xs =>
    match logD x, constSum xs with
    | some (v, e), some (S, H) => some (binMass x.1 / 2 * v + S, binMass x.1 / 2 * e + H)
    | _, _ => none

theorem rad_le_one : capSource.rad 1 ≤ 1 := by
  obtain ⟨hr1, hr2⟩ := rad_enc
  obtain ⟨h0, hk, h1⟩ := rH_facts
  have : (rH : ℝ) + 1 / 2 ^ PP ≤ 1 := by
    have := (Rat.cast_le (K := ℝ)).2 h1; push_cast at this; exact this
  linarith

theorem binPass_spec' {x : Tri} (hp : binPass rH x.1 x.2.1 x.2.2 = true) :
    massL (x.1.map QC.toY) = (binMass x.1 : ℝ) ∧
    |physL (x.1.map QC.toY) (fun y => y ^ 2) - (((x.2.2.B : ℚ) / 2 ^ PP : ℚ) : ℝ)| ≤ (eBu : ℝ) ∧
    (0 : ℝ) ≤ (((x.2.2.B : ℚ) / 2 ^ PP : ℚ) : ℝ) ∧ 0 < (binMass x.1 : ℝ) ∧
    RecOK PP ((capSource.rad 1) ^ 2) (capSource.rad 1) 1
      (alphaBudget PP (binMass x.1) eAu 3 (1 / 2 ^ PP) rH (binMass x.1 * (2 / 2 ^ PP) + eBu) (binMass x.1 * (rH : ℝ) ^ 2))
      ⟨x.1.map QC.toY, x.2.2.a, x.2.2.s0⟩ := by
  obtain ⟨hr1, hr2⟩ := rad_enc
  obtain ⟨h0, hk, h1⟩ := rH_facts
  exact binPass_spec (rad := capSource.rad 1) (by exact_mod_cast h0) hr1 hr2 rad_le_one
    (by have := (Rat.cast_le (K := ℝ)).2 hk; push_cast at this; exact this) hp

theorem logD_spec {x : Tri} (hp : binPass rH x.1 x.2.1 x.2.2 = true) {v e : ℚ} (h : logD x = some (v, e)) :
    |Real.log (binD ((capSource.rad 1) ^ 2) 1 (x.1.map QC.toY)) - (v : ℝ)| ≤ (e : ℝ) := by
  obtain ⟨hr1, hr2⟩ := rad_enc
  obtain ⟨h0, hk, h1⟩ := rH_facts
  have hrad1 := rad_le_one
  obtain ⟨hmass, hEB, hB0, hmpos, -⟩ := binPass_spec' hp
  unfold logD at h
  cases hl : logQ (dHat x) with
  | none => rw [hl] at h; simp at h
  | some t =>
    obtain ⟨v0, e0⟩ := t
    rw [hl] at h
    simp only [Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    set m : ℚ := binMass x.1 with hm
    set B2 : ℚ := (x.2.2.B : ℚ) / 2 ^ PP with hB2
    have hmq : (0 : ℚ) < m := by exact_mod_cast hmpos
    have hB0q : (0 : ℚ) ≤ B2 := by exact_mod_cast hB0
    have hdpos : (0 : ℚ) < dHat x := by
      unfold dHat
      have h1' : (0 : ℚ) < rH ^ 2 := by positivity
      have h2' : (0 : ℚ) ≤ B2 / m := div_nonneg hB0q hmq.le
      linarith
    have hlog := logQ_spec hdpos hl
    have hP2 : (0 : ℝ) < 2 ^ PP := by positivity
    have hrH0 : (0 : ℝ) < rH := by exact_mod_cast h0
    have hrad0 : 0 < capSource.rad 1 := lt_of_lt_of_le hrH0 hr1
    have hrr : capSource.rad 1 ^ 2 - (rH : ℝ) ^ 2 ≤ 2 / 2 ^ PP := by
      have h1' : capSource.rad 1 - rH ≤ 1 / 2 ^ PP := by linarith
      have h2 : (capSource.rad 1 - rH) * (capSource.rad 1 + rH) ≤ 1 / 2 ^ PP * (capSource.rad 1 + rH) :=
        mul_le_mul_of_nonneg_right h1' (by linarith)
      have h3 : 1 / 2 ^ PP * (capSource.rad 1 + rH) ≤ 1 / 2 ^ PP * 2 :=
        mul_le_mul_of_nonneg_left (by linarith) (by positivity)
      have e1 : capSource.rad 1 ^ 2 - (rH : ℝ) ^ 2 = (capSource.rad 1 - rH) * (capSource.rad 1 + rH) := by ring
      have e2 : (2 : ℝ) / 2 ^ PP = 1 / 2 ^ PP * 2 := by ring
      rw [e1, e2]; linarith
    have hrr0 : 0 ≤ capSource.rad 1 ^ 2 - (rH : ℝ) ^ 2 := by nlinarith
    have hsq := physL_sq_nonneg (x.1.map QC.toY)
    set sq : ℝ := physL (x.1.map QC.toY) (fun y => y ^ 2) with hsqdef
    have hmr : (0 : ℝ) < (m : ℝ) := by exact_mod_cast hmq
    have hxdef : binD ((capSource.rad 1) ^ 2) 1 (x.1.map QC.toY) = capSource.rad 1 ^ 2 + sq / (m : ℝ) := by
      unfold binD; rw [hmass]; simp [hsqdef]
    rw [hxdef]
    have hydef : ((dHat x : ℚ) : ℝ) = (rH : ℝ) ^ 2 + ((B2 : ℚ) : ℝ) / (m : ℝ) := by
      unfold dHat; simp only [hB2, hm]; push_cast; ring
    have hx1 : (rH : ℝ) ^ 2 ≤ capSource.rad 1 ^ 2 + sq / (m : ℝ) := by
      have : 0 ≤ sq / (m : ℝ) := div_nonneg hsq hmr.le
      nlinarith
    have hB0r : (0 : ℝ) ≤ ((B2 : ℚ) : ℝ) := hB0
    have hy1 : (rH : ℝ) ^ 2 ≤ ((dHat x : ℚ) : ℝ) := by
      rw [hydef]
      have : 0 ≤ ((B2 : ℚ) : ℝ) / (m : ℝ) := div_nonneg hB0r hmr.le
      linarith
    have hrHsq : (0 : ℝ) < (rH : ℝ) ^ 2 := by positivity
    have hdiff : |capSource.rad 1 ^ 2 + sq / (m : ℝ) - ((dHat x : ℚ) : ℝ)| ≤ 2 / 2 ^ PP + (eBu : ℝ) / (m : ℝ) := by
      rw [hydef]
      have e : capSource.rad 1 ^ 2 + sq / (m : ℝ) - ((rH : ℝ) ^ 2 + ((B2 : ℚ) : ℝ) / (m : ℝ)) =
          (capSource.rad 1 ^ 2 - (rH : ℝ) ^ 2) + (sq - ((B2 : ℚ) : ℝ)) / (m : ℝ) := by ring
      rw [e]
      have t1 : |(sq - ((B2 : ℚ) : ℝ)) / (m : ℝ)| ≤ (eBu : ℝ) / (m : ℝ) := by
        rw [abs_div, abs_of_pos hmr]
        exact div_le_div_of_nonneg_right hEB hmr.le
      have t2 := abs_add_le (capSource.rad 1 ^ 2 - (rH : ℝ) ^ 2) ((sq - ((B2 : ℚ) : ℝ)) / (m : ℝ))
      rw [abs_of_nonneg hrr0] at t2
      linarith
    have hxpos : 0 < capSource.rad 1 ^ 2 + sq / (m : ℝ) := lt_of_lt_of_le hrHsq hx1
    have hypos : 0 < ((dHat x : ℚ) : ℝ) := lt_of_lt_of_le hrHsq hy1
    have hl1 := abs_log_sub_le hxpos hypos
    have hmin : (rH : ℝ) ^ 2 ≤ min (capSource.rad 1 ^ 2 + sq / (m : ℝ)) ((dHat x : ℚ) : ℝ) := le_min hx1 hy1
    have hq : |capSource.rad 1 ^ 2 + sq / (m : ℝ) - ((dHat x : ℚ) : ℝ)| /
        min (capSource.rad 1 ^ 2 + sq / (m : ℝ)) ((dHat x : ℚ) : ℝ) ≤
        (2 / 2 ^ PP + (eBu : ℝ) / (m : ℝ)) / (rH : ℝ) ^ 2 := by
      calc _ ≤ |capSource.rad 1 ^ 2 + sq / (m : ℝ) - ((dHat x : ℚ) : ℝ)| / (rH : ℝ) ^ 2 :=
            div_le_div_of_nonneg_left (abs_nonneg _) hrHsq hmin
        _ ≤ _ := div_le_div_of_nonneg_right hdiff hrHsq.le
    have hlog' : |Real.log ((dHat x : ℚ) : ℝ) - (v0 : ℝ)| ≤ (e0 : ℝ) := hlog
    have hbin : ((eBinLog x : ℚ) : ℝ) = (2 / 2 ^ PP + (eBu : ℝ) / (m : ℝ)) / (rH : ℝ) ^ 2 := by
      unfold eBinLog; simp only [hm]; push_cast; ring
    have t := abs_add_le (Real.log (capSource.rad 1 ^ 2 + sq / (m : ℝ)) - Real.log ((dHat x : ℚ) : ℝ))
      (Real.log ((dHat x : ℚ) : ℝ) - (v0 : ℝ))
    have e2 : Real.log (capSource.rad 1 ^ 2 + sq / (m : ℝ)) - (v0 : ℝ) =
        (Real.log (capSource.rad 1 ^ 2 + sq / (m : ℝ)) - Real.log ((dHat x : ℚ) : ℝ)) +
        (Real.log ((dHat x : ℚ) : ℝ) - (v0 : ℝ)) := by ring
    rw [e2]
    push_cast
    rw [hbin]
    linarith

theorem constSum_spec : ∀ (T : List Tri) {S H : ℚ}, passAll T → constSum T = some (S, H) →
    |(S : ℝ) - ((T.map recOf).map fun r => massL r.cells / 2 * Real.log (binD ((capSource.rad 1) ^ 2) 1 r.cells)).sum| ≤ H
  | [], S, H, _, h => by
    simp only [constSum, Option.some.injEq, Prod.mk.injEq] at h
    obtain ⟨rfl, rfl⟩ := h
    simp
  | x :: xs, S, H, hp, h => by
    unfold constSum at h
    cases hl : logD x with
    | none => rw [hl] at h; simp at h
    | some t =>
      obtain ⟨v, e⟩ := t
      rw [hl] at h
      cases hc : constSum xs with
      | none => rw [hc] at h; simp at h
      | some t2 =>
        obtain ⟨S2, H2⟩ := t2
        rw [hc] at h
        simp only [Option.some.injEq, Prod.mk.injEq] at h
        obtain ⟨rfl, rfl⟩ := h
        have hpx : binPass rH x.1 x.2.1 x.2.2 = true := hp x (by simp)
        have hpxs : passAll xs := fun y hy => hp y (by simp [hy])
        have ih := constSum_spec xs hpxs hc
        have hls := logD_spec hpx hl
        have hs := binPass_spec' hpx
        have hm : massL (x.1.map QC.toY) = (binMass x.1 : ℝ) := hs.1
        have hmpos : (0 : ℝ) < binMass x.1 := hs.2.2.2.1
        simp only [List.map_cons, List.sum_cons, recOf]
        rw [hm]
        push_cast
        set rest := ((xs.map recOf).map fun r => massL r.cells / 2 * Real.log (binD ((capSource.rad 1) ^ 2) 1 r.cells)).sum
          with hrest
        have t1 : |(binMass x.1 : ℝ) / 2 * ((v : ℝ) - Real.log (binD ((capSource.rad 1) ^ 2) 1 (x.1.map QC.toY)))| ≤
            (binMass x.1 : ℝ) / 2 * (e : ℝ) := by
          rw [abs_mul, abs_of_pos (by positivity)]
          apply mul_le_mul_of_nonneg_left _ (by positivity)
          rw [abs_sub_comm]; exact hls
        have t2 := abs_add_le ((binMass x.1 : ℝ) / 2 * ((v : ℝ) - Real.log (binD ((capSource.rad 1) ^ 2) 1 (x.1.map QC.toY))))
          ((S2 : ℝ) - rest)
        have e1 : (binMass x.1 : ℝ) / 2 * (v : ℝ) + (S2 : ℝ) -
            ((binMass x.1 : ℝ) / 2 * Real.log (binD ((capSource.rad 1) ^ 2) 1 (x.1.map QC.toY)) + rest) =
            (binMass x.1 : ℝ) / 2 * ((v : ℝ) - Real.log (binD ((capSource.rad 1) ^ 2) 1 (x.1.map QC.toY))) +
            ((S2 : ℝ) - rest) := by ring
        rw [e1]
        linarith



/-! ### Fast evaluation of the aggregated power streams and the coefficient list -/

theorem stream_shift (P a s0 : ℕ) : ∀ k, stream P a s0 (k + 1) = stream P a (s0 * a / 2 ^ P) k := by
  intro k
  induction k with
  | zero => rfl
  | succ k ih => rw [stream, ih]; rfl

def stepAll (as ss : List ℕ) : List ℕ := List.zipWith (fun a s => s * a / 2 ^ PP) as ss

def aggLoop (as : List ℕ) : ℕ → List ℕ → List ℕ
  | 0, _ => []
  | n + 1, ss => ss.sum :: aggLoop as n (stepAll as ss)

theorem stepAll_length (as ss : List ℕ) : (stepAll as ss).length = min as.length ss.length := by
  simp [stepAll]

theorem aggLoop_spec (as : List ℕ) : ∀ (n : ℕ) (ss : List ℕ), ss.length = as.length →
    aggLoop as n ss = (List.range n).map fun k => (List.zipWith (fun a s => stream PP a s k) as ss).sum := by
  intro n
  induction n with
  | zero => intro ss _; simp [aggLoop]
  | succ n ih =>
    intro ss hlen
    rw [aggLoop, List.range_succ_eq_map, List.map_cons, List.map_map]
    have hlen' : (stepAll as ss).length = as.length := by
      rw [stepAll_length]; omega
    rw [ih _ hlen']
    congr 1
    · -- k = 0 term
      have : ∀ (as ss : List ℕ), ss.length = as.length →
          (List.zipWith (fun a s => stream PP a s 0) as ss).sum = ss.sum := by
        intro as
        induction as with
        | nil => intro ss h; cases ss <;> simp_all
        | cons a as ih2 =>
          intro ss h
          cases ss with
          | nil => simp at h
          | cons s ss =>
            simp only [List.zipWith_cons_cons, List.sum_cons]
            rw [ih2 ss (by simpa using h)]; rfl
      exact (this as ss hlen).symm
    · -- shift
      apply List.map_congr_left
      intro k _
      simp only [Function.comp_apply]
      have : ∀ (as ss : List ℕ), ss.length = as.length →
          (List.zipWith (fun a s => stream PP a s (k + 1)) as ss).sum =
          (List.zipWith (fun a s => stream PP a s k) as (stepAll as ss)).sum := by
        intro as
        induction as with
        | nil => intro ss h; cases ss <;> simp_all [stepAll]
        | cons a as ih2 =>
          intro ss h
          cases ss with
          | nil => simp at h
          | cons s ss =>
            simp only [stepAll, List.zipWith_cons_cons, List.sum_cons, stream_shift] at ih2 ⊢
            rw [ih2 ss (by simpa using h)]
      exact (this as ss hlen).symm

def coefsFrom : ℕ → List ℕ → List ℤ
  | _, [] => []
  | k, S :: Ss => (-(coefNum k S : ℤ)) :: coefsFrom (k + 1) Ss

def glFast (as ss : List ℕ) (cnum : ℤ) (n : ℕ) : List ℤ :=
  cnum :: coefsFrom 1 ((aggLoop as (n + 1) ss).tail)

theorem coefsFrom_eq : ∀ (Ss : List ℕ) (j : ℕ),
    coefsFrom j Ss = (List.range Ss.length).map fun i => -(coefNum (j + i) (Ss.getD i 0) : ℤ)
  | [], j => by simp [coefsFrom]
  | S :: Ss, j => by
    rw [coefsFrom, coefsFrom_eq Ss (j + 1), List.length_cons, List.range_succ_eq_map, List.map_cons, List.map_map]
    simp only [List.getD_cons_zero, Nat.add_zero, List.cons.injEq, true_and]
    apply List.map_congr_left
    intro i _
    simp only [Function.comp_apply, List.getD_cons_succ]
    congr 3
    omega

theorem Sagg_eq_zip (recs : List BinRec) (k : ℕ) :
    Sagg PP recs k = (List.zipWith (fun a s => stream PP a s k) (recs.map BinRec.a) (recs.map BinRec.s0)).sum := by
  unfold Sagg
  induction recs with
  | nil => simp
  | cons r recs ih => simp [ih]

theorem glFast_eq (recs : List BinRec) (cnum : ℤ) (n : ℕ) :
    glFast (recs.map BinRec.a) (recs.map BinRec.s0) cnum n = GasCert.glPos PP recs cnum n := by
  unfold glFast GasCert.glPos
  congr 1
  have hlen : (recs.map BinRec.s0).length = (recs.map BinRec.a).length := by simp
  rw [aggLoop_spec _ (n + 1) _ hlen, coefsFrom_eq]
  simp only [List.length_tail, List.length_map, List.length_range, Nat.add_sub_cancel]
  apply List.map_congr_left
  intro k hk
  have hk0 : k < n := by simpa using hk
  have h1 : 1 + k = k + 1 := by omega
  rw [h1]
  congr 3
  rw [Sagg_eq_zip]
  simp [List.getD_eq_getElem?_getD, List.getElem?_tail, List.getElem?_map, List.getElem?_range, hk0]



/-! ### The gas side of the certificate -/

theorem recs_cells (T : List Tri) : (T.map recOf).map BinRec.cells = (T.map Prod.fst).map (List.map QC.toY) := by
  simp [List.map_map, Function.comp_def, recOf]

theorem constTrue_err {T : List Tri} (hT : passAll T) {S H : ℚ} (hS : constSum T = some (S, H))
    {cnum : ℤ} (hc1 : (cnum : ℚ) ≤ S * 2 ^ PP) (hc2 : S * 2 ^ PP < cnum + 1) :
    |(cnum : ℝ) / 2 ^ PP - constTrue ((capSource.rad 1) ^ 2) 1 (T.map recOf)| ≤ ((1 / 2 ^ PP + H : ℚ) : ℝ) := by
  have h := constSum_spec T hT hS
  have hP2 : (0 : ℝ) < 2 ^ PP := by positivity
  have hP2q : (0 : ℚ) < 2 ^ PP := by positivity
  have a1 : (cnum : ℚ) / 2 ^ PP ≤ S := by rw [div_le_iff₀ hP2q]; exact hc1
  have a2 : S ≤ (cnum : ℚ) / 2 ^ PP + 1 / 2 ^ PP := by
    rw [← add_div, le_div_iff₀ hP2q]; linarith
  have a1' := (Rat.cast_le (K := ℝ)).2 a1
  have a2' := (Rat.cast_le (K := ℝ)).2 a2
  push_cast at a1' a2'
  have hc : constTrue ((capSource.rad 1) ^ 2) 1 (T.map recOf) =
      ((T.map recOf).map fun r => massL r.cells / 2 * Real.log (binD ((capSource.rad 1) ^ 2) 1 r.cells)).sum := rfl
  rw [hc]
  push_cast
  rw [abs_le] at h ⊢
  constructor <;> linarith [h.1, h.2]

theorem gas_cert (T : List Tri) (hT : passAll T) (hbins : T.map Prod.fst = binsQ) {S H : ℚ}
    (hS : constSum T = some (S, H)) {cnum : ℤ} (hc1 : (cnum : ℚ) ≤ S * 2 ^ PP)
    (hc2 : S * 2 ^ PP < cnum + 1) (n : ℕ) :
    AngularSource.Binning (capSource.gas Sign.pos) ((T.map recOf).map BinRec.cells) ∧
    ∑ j ∈ Finset.range (n + 1),
      |AngularCap.gasA capSource Sign.pos 1 ((T.map recOf).map BinRec.cells) j -
        (((GasCert.glPos PP (T.map recOf) cnum n).getD j 0 : ℤ) : ℝ) / ((2 ^ PP : ℕ) : ℝ)| ≤
      (((1 / 2 ^ PP + H) + n * cbQ T : ℚ) : ℝ) := by
  have hp : Partitioned (capSource.gas Sign.pos) ((T.map recOf).map BinRec.cells) := by
    rw [recs_cells, hbins]; exact partitioned_pos
  have h := GasCert.gasCert_pos capSource (recs := T.map recOf) 1 hp (n := n) (P := PP) (δ := deltaR)
    (recOK_family hT) cnum (η0 := ((1 / 2 ^ PP + H : ℚ) : ℝ)) (constTrue_err hT hS hc1 hc2)
  refine ⟨h.1, ?_⟩
  have e := coefBudget_eq hT
  have := h.2
  rw [e] at this
  push_cast at this ⊢
  exact this



/-! ### Structure of the auxiliary coefficients of the positive species -/

open AngularSource in
theorem group_sum' {α : Type*} (L : List α) (c : α → ℕ) (N : ℕ) (hc : ∀ a ∈ L, c a < N) (F : ℕ → ℝ) (h : α → ℝ) :
    (L.map fun a => F (c a) * h a).sum =
      ∑ r ∈ Finset.range N, F r * (L.map fun a => if c a = r then h a else 0).sum := by
  induction L with
  | nil => simp
  | cons a L ih =>
    have ih' := ih (fun b hb => hc b (by simp [hb]))
    have hca := hc a (by simp)
    simp only [List.map_cons, List.sum_cons]
    rw [ih']
    have : ∀ r ∈ Finset.range N, F r * ((if c a = r then h a else 0) + (L.map fun a => if c a = r then h a else 0).sum) =
        F r * (if c a = r then h a else 0) + F r * (L.map fun a => if c a = r then h a else 0).sum := fun r _ => by ring
    rw [Finset.sum_congr rfl this, Finset.sum_add_distrib]
    congr 1
    simp [Finset.sum_ite_eq', hca]

def Maux : ℤ := 365106132092
def Spos : ℤ := 634893793683

theorem Maux_eq : sumP paT = Maux := by decide +kernel
theorem Spos_eq : sumP gasPosT = Spos := by decide +kernel

/-- the auxiliary mass of the positive species, as a rational. -/
def tgtQ : ℚ := ((Tt - Spos : ℤ) : ℚ) / (Tt : ℚ)

theorem tgt_pos_val : tgt Sign.pos = (tgtQ : ℝ) := by
  have hT : (0 : ℝ) < Tt := by
    have : 0 < Tt := by rw [← Tt_eq]; exact row0_tot
    exact_mod_cast this
  show 1 - massL (gasCells Sign.pos) = _
  rw [massPos, Tt_eq, Spos_eq]
  unfold tgtQ
  push_cast
  field_simp

theorem mkAux_fields {g : ℝ} {M : ℤ} {t : Tr} (hg : 0 ≤ g) (hM : 0 ≤ M) (h0 : 0 ≤ t.2.2) :
    (mkAux g M t).rad = t.1.toNat ∧ (mkAux g M t).phase = Real.pi * (t.2.1 : ℝ) / 93 ∧
      (mkAux g M t).w = g * (t.2.2 : ℝ) / (M : ℝ) := by
  have hh : 0 ≤ t.2.2 ∧ 0 ≤ M ∧ 0 ≤ g := ⟨h0, hM, hg⟩
  unfold mkAux
  rw [dif_pos hh]
  exact ⟨rfl, rfl, rfl⟩

/-- the exponential of the radius ratio. -/
def tauR (r : ℕ) : ℝ := capSource.q * (capSource.rad (max 1 r) / capSource.rad (min 1 r))

def Gk (k : ℕ) : ℝ := (1 + capSource.strength * k + capSource.curvature * (k : ℝ) ^ 2) / k

/-- class sums of the weighted cosines. -/
def Sr (r k : ℕ) : ℝ :=
  (paT.map fun t => if t.1.toNat = r then (tgt Sign.pos * (t.2.2 : ℝ) / (Maux : ℝ)) *
    Real.cos ((k : ℝ) * (Real.pi * (t.2.1 : ℝ) / 93)) else 0).sum

theorem paT_ok : ∀ t ∈ paT, 0 ≤ t.2.2 ∧ t.1 < 16 := pa_ok

theorem auxA_eq (k : ℕ) (hk : 1 ≤ k) :
    AngularCap.auxA capSource Sign.pos 1 k = -Gk k * ∑ r ∈ Finset.range 16, tauR r ^ k * Sr r k := by
  have hk0 : k ≠ 0 := by omega
  have hT : (0 : ℝ) < Tt := by
    have : 0 < Tt := by rw [← Tt_eq]; exact row0_tot
    exact_mod_cast this
  have hMaux : (0 : ℤ) ≤ sumP paT := pa_tot.le
  have hgt : 0 ≤ tgt Sign.pos := tgt_nonneg _
  unfold AngularCap.auxA AngularSource.auxCoefHat
  simp only [hk0, if_false]
  show ((auxCells Sign.pos).map fun e => e.w * AngularSource.auxFun capSource Sign.pos 1 k e).sum = _
  unfold auxCells auxT
  rw [List.map_map]
  have hterm : ∀ t ∈ paT, ((fun e => e.w * AngularSource.auxFun capSource Sign.pos 1 k e) ∘ mkAux (tgt Sign.pos) (sumP paT)) t =
      (fun r => -Gk k * tauR r ^ k) t.1.toNat * ((tgt Sign.pos * (t.2.2 : ℝ) / (Maux : ℝ)) *
        Real.cos ((k : ℝ) * (Real.pi * (t.2.1 : ℝ) / 93))) := by
    intro t ht
    obtain ⟨hp, hr⟩ := paT_ok t ht
    obtain ⟨f1, f2, f3⟩ := mkAux_fields hgt hMaux hp
    simp only [Function.comp_apply, AngularSource.auxFun, f1, f2, f3]
    rw [show (sumP paT : ℝ) = (Maux : ℝ) by rw [Maux_eq]]
    unfold Gk tauR CapFields.CapSource.coef
    have : (if Sign.pos = Sign.neg then (capSource.rad 1 * capSource.rad t.1.toNat) ^ k else 0 : ℝ) = 0 := by
      simp
    rw [this, add_zero, mul_pow]
    have hkr : (k : ℝ) ≠ 0 := by exact_mod_cast hk0
    field_simp
  rw [List.map_congr_left hterm]
  have hcl : ∀ t ∈ paT, t.1.toNat < 16 := fun t ht => by
    have := (paT_ok t ht).2; omega
  rw [group_sum' paT (fun t => t.1.toNat) 16 hcl (fun r => -Gk k * tauR r ^ k)
    (fun t => (tgt Sign.pos * (t.2.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (t.2.1 : ℝ) / 93)))]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro r _
  unfold Sr
  ring



/-! ### Enclosures of `q`, `tau_r`, `strength`, `curvature` -/

def sigq (k : ℕ) : ℚ := (sigN.getD (min k 15) 0 : ℚ) / 10 ^ 17

theorem sigma_eq (k : ℕ) : capSource.sigma k = (sigq k : ℝ) := by
  show (sigN.getD (min k 15) 0 : ℝ) / 10 ^ 17 = _
  unfold sigq; push_cast; rfl

theorem rad_eq (k : ℕ) : capSource.rad k = Real.exp (-(sigq k : ℝ)) := by
  show Real.exp (-capSource.sigma k) = _
  rw [sigma_eq]

theorem q_eq : capSource.q = Real.exp (-((27 / 500 : ℚ) : ℝ)) := by
  show Real.exp (-capSource.eps / 2) = _
  have : capSource.eps = 27 / 250 := rfl
  rw [this]; congr 1; push_cast; ring

/-- exponent of `tau_r`. -/
def tq (r : ℕ) : ℚ := 27 / 500 + (sigq (max 1 r) - sigq (min 1 r))

theorem tauR_eq (r : ℕ) : tauR r = Real.exp (-(tq r : ℝ)) := by
  unfold tauR
  rw [q_eq, rad_eq, rad_eq, ← Real.exp_sub, ← Real.exp_add]
  congr 1
  unfold tq; push_cast; ring

-- kcost: 0.05 s estimated; 16 radius classes, integer-sized rationals.
theorem tq_range : ∀ r < 16, 0 ≤ tq r ∧ tq r ≤ 8 := by decide +kernel

theorem tauR_enc {r : ℕ} (hr : r < 16) (N : ℕ) (hN : 0 < N) :
    (expLoQ (tq r) N : ℝ) ≤ tauR r ∧ tauR r ≤ (expHiQ (tq r) N : ℝ) := by
  rw [tauR_eq]
  exact expQ_enc (tq r) (tq_range r hr).1 (tq_range r hr).2 N hN

theorem tauR_le_one {r : ℕ} (hr : r < 16) : 0 ≤ tauR r ∧ tauR r ≤ 1 := by
  rw [tauR_eq]
  refine ⟨(Real.exp_pos _).le, ?_⟩
  rw [Real.exp_le_one_iff]
  have : (0 : ℚ) ≤ tq r := (tq_range r hr).1
  have : (0 : ℝ) ≤ (tq r : ℝ) := by exact_mod_cast this
  linarith

/-- a fixed-point power stream approximates `tau^k` -/
theorem pow_stream_err {τ lo hi : ℝ} {a P : ℕ} (hlo : lo ≤ τ) (hhi : τ ≤ hi) (h0 : 0 ≤ τ) (h1 : τ ≤ 1)
    (ha : (a : ℝ) / 2 ^ P ≤ lo) (haP : a ≤ 2 ^ P) (k : ℕ) :
    |τ ^ k - (stream P a (2 ^ P) k : ℝ) / 2 ^ P| ≤ k * (hi - (a : ℝ) / 2 ^ P) + k / 2 ^ P := by
  have hP : (0 : ℝ) < 2 ^ P := by positivity
  have hα0 : (0 : ℝ) ≤ (a : ℝ) / 2 ^ P := by positivity
  have hα1 : (a : ℝ) / 2 ^ P ≤ 1 := by rw [div_le_one hP]; exact_mod_cast haP
  have hu := stream_upper P a (2 ^ P) k
  have hl := stream_lower P a (2 ^ P) haP k
  have hs : ((2 ^ P : ℕ) : ℝ) / 2 ^ P = 1 := by push_cast; field_simp
  rw [hs, one_mul] at hu hl
  have hp := abs_pow_sub_pow_le_unit h0 h1 hα0 hα1 k
  have hd : |τ - (a : ℝ) / 2 ^ P| ≤ hi - (a : ℝ) / 2 ^ P := by
    rw [abs_of_nonneg (by linarith)]; linarith
  have hk : (0 : ℝ) ≤ k := Nat.cast_nonneg k
  have h2 : |τ ^ k - ((a : ℝ) / 2 ^ P) ^ k| ≤ k * (hi - (a : ℝ) / 2 ^ P) :=
    hp.trans (mul_le_mul_of_nonneg_left hd hk)
  rw [abs_le] at h2 ⊢
  constructor <;> nlinarith [h2.1, h2.2, hu, hl]

/-! ### `strength` and `curvature` as monotone functions of `q^2` -/

def Af (x : ℚ) : ℚ := 3 * (1 - x ^ 2) / (2 * (1 + 4 * x + x ^ 2))
def Bf (x : ℚ) : ℚ := (1 - x) ^ 2 / (2 * (1 + 4 * x + x ^ 2))
def AfR (x : ℝ) : ℝ := 3 * (1 - x ^ 2) / (2 * (1 + 4 * x + x ^ 2))
def BfR (x : ℝ) : ℝ := (1 - x) ^ 2 / (2 * (1 + 4 * x + x ^ 2))

theorem Af_cast (x : ℚ) : AfR (x : ℝ) = (Af x : ℝ) := by unfold AfR Af; push_cast; rfl
theorem Bf_cast (x : ℚ) : BfR (x : ℝ) = (Bf x : ℝ) := by unfold BfR Bf; push_cast; rfl

theorem q_lt_one' : capSource.q < 1 := by
  rw [q_eq, ← Real.exp_zero]; exact Real.exp_lt_exp.2 (by norm_num)

theorem q_pos' : 0 < capSource.q := Real.exp_pos _

theorem strength_eq : capSource.strength = AfR (capSource.q ^ 2) := by
  have h1 := q_lt_one'
  have h0 := q_pos'
  have hx : capSource.q ^ 2 < 1 := by nlinarith
  have hx0 : 0 < capSource.q ^ 2 := by positivity
  have hD : (0 : ℝ) < 1 - capSource.q ^ 2 := by linarith
  unfold CapFields.CapSource.strength CapFields.CapSource.normalizer AfR
  have hDx : (0 : ℝ) < 1 + 4 * capSource.q ^ 2 + (capSource.q ^ 2) ^ 2 := by positivity
  field_simp
  ring

theorem curvature_eq : capSource.curvature = BfR (capSource.q ^ 2) := by
  have h1 := q_lt_one'
  have h0 := q_pos'
  have hx : capSource.q ^ 2 < 1 := by nlinarith
  have hD : (0 : ℝ) < 1 - capSource.q ^ 2 := by linarith
  unfold CapFields.CapSource.curvature CapFields.CapSource.normalizer BfR
  have hDx : (0 : ℝ) < 1 + 4 * capSource.q ^ 2 + (capSource.q ^ 2) ^ 2 := by positivity
  field_simp

theorem AfR_anti {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) : AfR y ≤ AfR x := by
  unfold AfR
  have hDx : (0 : ℝ) < 2 * (1 + 4 * x + x ^ 2) := by positivity
  have hDy : (0 : ℝ) < 2 * (1 + 4 * y + y ^ 2) := by nlinarith
  rw [div_le_div_iff₀ hDy hDx]
  nlinarith [mul_nonneg (sub_nonneg.2 hxy) (by nlinarith : (0:ℝ) ≤ 4 + 2 * (x + y) + 4 * x * y)]

theorem BfR_anti {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) (hy : y ≤ 1) : BfR y ≤ BfR x := by
  unfold BfR
  have hDx : (0 : ℝ) < 2 * (1 + 4 * x + x ^ 2) := by positivity
  have hDy : (0 : ℝ) < 2 * (1 + 4 * y + y ^ 2) := by nlinarith
  rw [div_le_div_iff₀ hDy hDx]
  have h1 : (1 - y) ^ 2 ≤ (1 - x) ^ 2 := by nlinarith
  have h2 : 2 * (1 + 4 * x + x ^ 2) ≤ 2 * (1 + 4 * y + y ^ 2) := by nlinarith
  exact mul_le_mul h1 h2 hDx.le (by positivity)



/-! ### Taylor bound for cos -/
section cosT
open Complex

theorem cos_taylor_re (x : ℝ) : ∀ N : ℕ,
    (∑ m ∈ Finset.range (2 * N), ((x : ℂ) * I) ^ m / (m.factorial : ℂ)).re =
      ∑ k ∈ Finset.range N, (-1 : ℝ) ^ k * x ^ (2 * k) / ((2 * k).factorial : ℝ) := by
  intro N
  induction N with
  | zero => simp
  | succ N ih =>
    rw [show 2 * (N + 1) = 2 * N + 1 + 1 by ring, Finset.sum_range_succ, Finset.sum_range_succ,
      Complex.add_re, Complex.add_re, ih, Finset.sum_range_succ]
    have e1 : ((x : ℂ) * I) ^ (2 * N) / ((2 * N).factorial : ℂ) =
        (((-1 : ℝ) ^ N * x ^ (2 * N) / ((2 * N).factorial : ℝ) : ℝ) : ℂ) := by
      rw [mul_pow, pow_mul I, Complex.I_sq]
      push_cast
      ring
    have e2 : (((x : ℂ) * I) ^ (2 * N + 1) / ((2 * N + 1).factorial : ℂ)).re = 0 := by
      have : ((x : ℂ) * I) ^ (2 * N + 1) / ((2 * N + 1).factorial : ℂ) =
          (((-1 : ℝ) ^ N * x ^ (2 * N + 1) / ((2 * N + 1).factorial : ℝ) : ℝ) : ℂ) * I := by
        rw [mul_pow, pow_succ I, pow_succ (x : ℂ), pow_mul I, Complex.I_sq]
        push_cast
        ring
      rw [this]
      simp only [Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im]
      ring
    rw [e2, e1, Complex.ofReal_re]
    ring

theorem cos_taylor (x : ℝ) (hx : |x| ≤ 1) (N : ℕ) (hN : 0 < N) :
    |Real.cos x - ∑ k ∈ Finset.range N, (-1 : ℝ) ^ k * x ^ (2 * k) / ((2 * k).factorial : ℝ)| ≤
      |x| ^ (2 * N) * (((2 * N).succ : ℝ) / (((2 * N).factorial : ℝ) * ((2 * N : ℕ) : ℝ))) := by
  have hxc : ‖(x : ℂ) * I‖ ≤ 1 := by simpa using hx
  have hb := Complex.exp_bound hxc (n := 2 * N) (by omega)
  have hre : (Complex.exp ((x : ℂ) * I)).re = Real.cos x := Complex.exp_ofReal_mul_I_re x
  have h1 := Complex.abs_re_le_norm (Complex.exp ((x : ℂ) * I) -
    ∑ m ∈ Finset.range (2 * N), ((x : ℂ) * I) ^ m / (m.factorial : ℂ))
  rw [Complex.sub_re, hre, cos_taylor_re] at h1
  refine h1.trans ?_
  refine hb.trans (le_of_eq ?_)
  have hn : ‖(x : ℂ) * I‖ = |x| := by
    rw [norm_mul, Complex.norm_real, Complex.norm_I, mul_one, Real.norm_eq_abs]
  rw [hn]
  push_cast
  ring


end cosT


/-! ### Cosine table `cos (pi l / 93)` -/

def cosS (x : ℚ) : ℕ → ℚ
  | 0 => 0
  | n + 1 => cosS x n + (-1) ^ n * x ^ (2 * n) / ((2 * n).factorial : ℚ)

theorem cosS_cast (x : ℚ) (N : ℕ) :
    (cosS x N : ℝ) = ∑ k ∈ Finset.range N, (-1 : ℝ) ^ k * (x : ℝ) ^ (2 * k) / ((2 * k).factorial : ℝ) := by
  induction N with
  | zero => simp [cosS]
  | succ n ih => rw [Finset.sum_range_succ, ← ih]; simp [cosS]

/-- a rational lower bound of pi with `pi - piQ <= 10^-20`. -/
def piQ : ℚ := 314159265358979323846 / 10 ^ 20

theorem piQ_enc : (piQ : ℝ) ≤ Real.pi ∧ Real.pi ≤ piQ + 1 / 10 ^ 20 := by
  have h1 := Real.pi_gt_d20
  have h2 := Real.pi_lt_d20
  unfold piQ
  push_cast
  constructor <;> norm_num at h1 h2 ⊢ <;> linarith

/-- the cosine value used for `l <= 93`: two doublings of a 12-term Taylor value at `pi l / 372`. -/
def cosY (l : ℕ) : ℚ :=
  let P := cosS (piQ * l / 372) 12
  let v := 2 * P ^ 2 - 1
  2 * v ^ 2 - 1

/-- error propagation of `u -> 2 u^2 - 1`. -/
def dblE (e : ℚ) : ℚ := 2 * e * (2 + e)

def eCos1 : ℚ := 1 / (4 * 10 ^ 20) + 25 / (((24).factorial : ℚ) * 24)
def dY : ℚ := dblE (dblE eCos1)

theorem dbl_err {u û : ℝ} {e : ℝ} (hu : |u| ≤ 1) (he : 0 ≤ e) (h : |u - û| ≤ e) :
    |(2 * u ^ 2 - 1) - (2 * û ^ 2 - 1)| ≤ 2 * e * (2 + e) := by
  have e1 : (2 * u ^ 2 - 1) - (2 * û ^ 2 - 1) = 2 * (u - û) * (u + û) := by ring
  rw [e1, abs_mul, abs_mul]
  have h2 : |u + û| ≤ 2 + e := by
    have : |û| ≤ 1 + e := by
      have := abs_sub_abs_le_abs_sub û u
      rw [abs_sub_comm] at this
      linarith
    calc |u + û| ≤ |u| + |û| := abs_add_le _ _
      _ ≤ 2 + e := by linarith
  have h3 : |(2 : ℝ)| = 2 := by norm_num
  rw [h3]
  calc 2 * |u - û| * |u + û| ≤ 2 * e * (2 + e) := by
        apply mul_le_mul (mul_le_mul_of_nonneg_left h (by norm_num)) h2 (abs_nonneg _) (by positivity)

theorem cosY_spec {l : ℕ} (hl : l ≤ 93) :
    |Real.cos (Real.pi * l / 93) - (cosY l : ℝ)| ≤ (dY : ℝ) := by
  obtain ⟨hp1, hp2⟩ := piQ_enc
  have hl' : (l : ℝ) ≤ 93 := by exact_mod_cast hl
  have hl0 : (0 : ℝ) ≤ l := Nat.cast_nonneg l
  have hpi4 : Real.pi < 4 := Real.pi_lt_four
  set φ : ℝ := Real.pi * l / 372 with hφ
  set φh : ℝ := (piQ : ℝ) * l / 372 with hφh
  have hpiQ0 : (0 : ℝ) ≤ piQ := by
    have : (0 : ℚ) ≤ piQ := by unfold piQ; norm_num
    exact_mod_cast this
  have hφ1 : |φ| ≤ 1 := by
    rw [abs_le]; constructor
    · have : 0 ≤ φ := by rw [hφ]; positivity
      linarith
    · rw [hφ, div_le_one (by norm_num)]; nlinarith [Real.pi_pos]
  have hφh1 : |φh| ≤ 1 := by
    rw [abs_le]; constructor
    · have : 0 ≤ φh := by rw [hφh]; positivity
      linarith
    · rw [hφh, div_le_one (by norm_num)]; nlinarith [Real.pi_pos]
  have hdiff : |φ - φh| ≤ 1 / (4 * 10 ^ 20) := by
    have : φ - φh = (Real.pi - piQ) * l / 372 := by rw [hφ, hφh]; ring
    rw [this, abs_le]
    constructor
    · have : 0 ≤ (Real.pi - piQ) * l / 372 := by
        apply div_nonneg (mul_nonneg (by linarith) hl0) (by norm_num)
      have : (0 : ℝ) ≤ 1 / (4 * 10 ^ 20) := by norm_num
      linarith
    · have h1 : (Real.pi - piQ) * l ≤ 1 / 10 ^ 20 * 93 := by
        apply mul_le_mul (by linarith) hl' hl0 (by norm_num)
      calc (Real.pi - piQ) * l / 372 ≤ 1 / 10 ^ 20 * 93 / 372 := by
            apply div_le_div_of_nonneg_right h1 (by norm_num)
        _ = 1 / (4 * 10 ^ 20) := by norm_num
  have hcosd : |Real.cos φ - Real.cos φh| ≤ 1 / (4 * 10 ^ 20) :=
    (Real.abs_cos_sub_cos_le φ φh).trans hdiff
  have hT := cos_taylor φh hφh1 12 (by norm_num)
  have hrem : |φh| ^ (2 * 12) * (((2 * 12).succ : ℝ) / (((2 * 12).factorial : ℝ) * ((2 * 12 : ℕ) : ℝ))) ≤
      25 / (((24).factorial : ℝ) * 24) := by
    have : |φh| ^ (2 * 12) ≤ 1 := pow_le_one₀ (abs_nonneg _) hφh1
    have hpos : (0 : ℝ) ≤ ((2 * 12).succ : ℝ) / (((2 * 12).factorial : ℝ) * ((2 * 12 : ℕ) : ℝ)) := by positivity
    calc _ ≤ 1 * (((2 * 12).succ : ℝ) / (((2 * 12).factorial : ℝ) * ((2 * 12 : ℕ) : ℝ))) :=
          mul_le_mul_of_nonneg_right this hpos
      _ = _ := by norm_num
  have hP : (cosS (piQ * l / 372) 12 : ℝ) = ∑ k ∈ Finset.range 12, (-1 : ℝ) ^ k * φh ^ (2 * k) / ((2 * k).factorial : ℝ) := by
    rw [cosS_cast]; push_cast; rw [hφh]
  have hT' : |Real.cos φh - (cosS (piQ * l / 372) 12 : ℝ)| ≤ 25 / (((24).factorial : ℝ) * 24) := by
    rw [hP]; exact hT.trans hrem
  have e1 : |Real.cos φ - (cosS (piQ * l / 372) 12 : ℝ)| ≤ (eCos1 : ℝ) := by
    have t := abs_add_le (Real.cos φ - Real.cos φh) (Real.cos φh - (cosS (piQ * l / 372) 12 : ℝ))
    have e : Real.cos φ - (cosS (piQ * l / 372) 12 : ℝ) =
        (Real.cos φ - Real.cos φh) + (Real.cos φh - (cosS (piQ * l / 372) 12 : ℝ)) := by ring
    rw [e]
    have : (eCos1 : ℝ) = 1 / (4 * 10 ^ 20) + 25 / (((24).factorial : ℝ) * 24) := by
      unfold eCos1; push_cast; ring
    rw [this]
    linarith
  have hcu : |Real.cos φ| ≤ 1 := Real.abs_cos_le_one φ
  have hc2 : Real.cos (2 * φ) = 2 * Real.cos φ ^ 2 - 1 := Real.cos_two_mul φ
  have hc4 : Real.cos (2 * (2 * φ)) = 2 * Real.cos (2 * φ) ^ 2 - 1 := Real.cos_two_mul (2 * φ)
  have hθ : Real.pi * l / 93 = 2 * (2 * φ) := by rw [hφ]; ring
  have e1' : (0 : ℝ) ≤ (eCos1 : ℝ) := by unfold eCos1; positivity
  have s1 := dbl_err hcu e1' e1
  have hv1 : |Real.cos (2 * φ)| ≤ 1 := Real.abs_cos_le_one _
  have e2' : (0 : ℝ) ≤ 2 * (eCos1 : ℝ) * (2 + eCos1) := by positivity
  rw [← hc2] at s1
  have s2 := dbl_err hv1 e2' s1
  rw [hθ, hc4]
  have hy : (cosY l : ℝ) = 2 * (2 * (cosS (piQ * l / 372) 12 : ℝ) ^ 2 - 1) ^ 2 - 1 := by
    unfold cosY; push_cast; ring
  have hd : (dY : ℝ) = 2 * (2 * (eCos1 : ℝ) * (2 + eCos1)) * (2 + 2 * (eCos1 : ℝ) * (2 + eCos1)) := by
    unfold dY dblE; push_cast; ring
  rw [hy, hd]
  exact s2


/-! ### The shared cosine table -/

def PY : ℕ := 100

def foldI (l : ℕ) : ℕ := if l ≤ 93 then l else 186 - l

def dC : ℚ := dY + 1 / 2 ^ PY

theorem cos_mod (m : ℕ) : Real.cos (Real.pi * m / 93) = Real.cos (Real.pi * ((m % 186 : ℕ) : ℝ) / 93) := by
  have h : (m : ℝ) = ((m % 186 : ℕ) : ℝ) + ((m / 186 : ℕ) : ℝ) * 186 := by
    have := Nat.mod_add_div m 186
    have h2 : ((m % 186 + 186 * (m / 186) : ℕ) : ℝ) = (m : ℝ) := by exact_mod_cast this
    push_cast at h2
    linarith
  have : Real.pi * m / 93 = Real.pi * ((m % 186 : ℕ) : ℝ) / 93 + ((m / 186 : ℕ) : ℝ) * (2 * Real.pi) := by
    rw [h]; ring
  rw [this, Real.cos_add_nat_mul_two_pi]

theorem cos_fold {l : ℕ} (hl : l < 186) : Real.cos (Real.pi * l / 93) = Real.cos (Real.pi * (foldI l : ℕ) / 93) := by
  unfold foldI
  split_ifs with h
  · rfl
  · have : Real.pi * l / 93 = 2 * Real.pi - Real.pi * ((186 - l : ℕ) : ℝ) / 93 := by
      have : ((186 - l : ℕ) : ℝ) = 186 - l := by
        rw [Nat.cast_sub (by omega)]; norm_num
      rw [this]; ring
    rw [this, Real.cos_two_pi_sub]

theorem Ycos_err (Y : List ℤ) (hY : ∀ l < 94, (Y.getD l 0 : ℚ) ≤ cosY l * 2 ^ PY ∧ cosY l * 2 ^ PY < Y.getD l 0 + 1)
    {l : ℕ} (hl : l < 186) :
    |Real.cos (Real.pi * l / 93) - ((Y.getD (foldI l) 0 : ℤ) : ℝ) / 2 ^ PY| ≤ (dC : ℝ) := by
  rw [cos_fold hl]
  have hf : foldI l ≤ 93 := by unfold foldI; split_ifs <;> omega
  have h1 := cosY_spec hf
  obtain ⟨a1, a2⟩ := hY (foldI l) (by omega)
  have hP : (0 : ℚ) < 2 ^ PY := by positivity
  have hP' : (0 : ℝ) < 2 ^ PY := by positivity
  have b1 : ((Y.getD (foldI l) 0 : ℤ) : ℚ) / 2 ^ PY ≤ cosY (foldI l) := by rw [div_le_iff₀ hP]; exact a1
  have b2 : cosY (foldI l) ≤ ((Y.getD (foldI l) 0 : ℤ) : ℚ) / 2 ^ PY + 1 / 2 ^ PY := by
    rw [← add_div, le_div_iff₀ hP]; linarith
  have c1 := (Rat.cast_le (K := ℝ)).2 b1
  have c2 := (Rat.cast_le (K := ℝ)).2 b2
  push_cast at c1 c2
  unfold dC
  push_cast
  rw [abs_le] at h1 ⊢
  constructor <;> linarith [h1.1, h1.2]



/-! ### The class sums `S_r(k)` and their integer tables -/

theorem ite_sum_filter {α : Type*} (L : List α) (p : α → Prop) [DecidablePred p] (f : α → ℝ) :
    (L.map fun a => if p a then f a else 0).sum = ((L.filter fun a => decide (p a)).map f).sum := by
  induction L with
  | nil => simp
  | cons a L ih =>
    by_cases h : p a
    · simp [List.filter_cons, h, ih]
    · simp [List.filter_cons, h, ih]

theorem paJ_nonneg : ∀ t ∈ paT, 0 ≤ t.2.1 ∧ t.2.1 < 186 := by decide +kernel

/-- entries `(jj, p)` of the radius class `r` of the positive auxiliary population. -/
def clsOf (r : ℕ) : List (ℕ × ℤ) := (paT.filter fun t => decide (t.1.toNat = r)).map fun t => (t.2.1.toNat, t.2.2)

def PwC (Y : List ℤ) (cls : List (List (ℕ × ℤ))) (r jm : ℕ) : ℤ :=
  ((cls.getD r []).map fun x => x.2 * Y.getD (foldI ((jm * x.1) % 186)) 0).sum

def Pcls (cls : List (List (ℕ × ℤ))) (r : ℕ) : ℤ := ((cls.getD r []).map Prod.snd).sum

theorem Sr_eq_cls (r k : ℕ) :
    Sr r k = ((clsOf r).map fun x => (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) *
      Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))).sum := by
  unfold Sr clsOf
  rw [ite_sum_filter paT (fun t => t.1.toNat = r)]
  rw [List.map_map]
  congr 1
  apply List.map_congr_left
  intro t ht
  obtain ⟨hj, _⟩ := paJ_nonneg t (List.mem_of_mem_filter ht)
  simp only [Function.comp_apply]
  rw [show (((t.2.1.toNat : ℕ)) : ℝ) = (t.2.1 : ℝ) by exact_mod_cast Int.toNat_of_nonneg hj]

theorem cls_sum_err (Y : List ℤ) (hY : ∀ l < 94, (Y.getD l 0 : ℚ) ≤ cosY l * 2 ^ PY ∧ cosY l * 2 ^ PY < Y.getD l 0 + 1)
    (cls : List (List (ℕ × ℤ))) (r k : ℕ) (hcl : cls.getD r [] = clsOf r)
    (hjj : ∀ x ∈ clsOf r, x.1 < 186) (hp : ∀ x ∈ clsOf r, 0 ≤ x.2) :
    |Sr r k - (tgt Sign.pos / (Maux : ℝ)) * (PwC Y cls r (k % 186) : ℝ) / 2 ^ PY| ≤
      (tgt Sign.pos / (Maux : ℝ)) * (Pcls cls r : ℝ) * (dC : ℝ) ∧
    |Sr r k| ≤ (tgt Sign.pos / (Maux : ℝ)) * (Pcls cls r : ℝ) := by
  have hg := tgt_nonneg Sign.pos
  have hM : (0 : ℝ) < (Maux : ℝ) := by unfold Maux; norm_num
  have hP : (0 : ℝ) < 2 ^ PY := by positivity
  rw [Sr_eq_cls]
  unfold PwC Pcls
  rw [hcl]
  have hdC : (0 : ℝ) ≤ (dC : ℝ) := by
    have : (0 : ℚ) ≤ dC := by unfold dC dY dblE eCos1 PY; norm_num
    exact_mod_cast this
  -- both statements by induction on the class list
  have key : ∀ (L : List (ℕ × ℤ)), (∀ x ∈ L, x.1 < 186) → (∀ x ∈ L, 0 ≤ x.2) →
      |(L.map fun x => (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))).sum
        - (tgt Sign.pos / (Maux : ℝ)) * ((L.map fun x => x.2 * Y.getD (foldI (((k % 186) * x.1) % 186)) 0).sum : ℤ) / 2 ^ PY|
        ≤ (tgt Sign.pos / (Maux : ℝ)) * ((L.map Prod.snd).sum : ℤ) * (dC : ℝ) ∧
      |(L.map fun x => (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))).sum|
        ≤ (tgt Sign.pos / (Maux : ℝ)) * ((L.map Prod.snd).sum : ℤ) := by
    intro L
    induction L with
    | nil => intro _ _; simp
    | cons x L ih =>
      intro h1 h2
      obtain ⟨ih1, ih2⟩ := ih (fun y hy => h1 y (by simp [hy])) (fun y hy => h2 y (by simp [hy]))
      have hx1 := h1 x (by simp)
      have hx2 := h2 x (by simp)
      have hxr : (0 : ℝ) ≤ (x.2 : ℝ) := by exact_mod_cast hx2
      have hcos : Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93)) = Real.cos (Real.pi * ((k * x.1 : ℕ) : ℝ) / 93) := by
        congr 1; push_cast; ring
      have hmod : (k * x.1) % 186 = ((k % 186) * x.1) % 186 := by
        rw [Nat.mul_mod k x.1 186, Nat.mul_mod (k % 186) x.1 186, Nat.mod_mod]
      have he := Ycos_err Y hY (l := (k * x.1) % 186) (Nat.mod_lt _ (by norm_num))
      rw [← cos_mod, ← hcos] at he
      rw [hmod] at he
      simp only [List.map_cons, List.sum_cons, Int.cast_add, Int.cast_mul]
      constructor
      · set c := Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93)) with hc
        set yv : ℝ := ((Y.getD (foldI (((k % 186) * x.1) % 186)) 0 : ℤ) : ℝ) / 2 ^ PY with hyv
        have e : (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ) * c + (L.map fun x => (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))).sum) -
            (tgt Sign.pos / (Maux : ℝ)) * (x.2 * Y.getD (foldI (((k % 186) * x.1) % 186)) 0 +
              (L.map fun x => x.2 * Y.getD (foldI (((k % 186) * x.1) % 186)) 0).sum : ℤ) / 2 ^ PY =
            (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * (c - yv) +
            ((L.map fun x => (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))).sum -
              (tgt Sign.pos / (Maux : ℝ)) * ((L.map fun x => x.2 * Y.getD (foldI (((k % 186) * x.1) % 186)) 0).sum : ℤ) / 2 ^ PY) := by
          rw [hyv]; simp only [Int.cast_add, Int.cast_mul]; ring
        simp only [Int.cast_add, Int.cast_mul] at e
        rw [e]
        have t1 : |(tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * (c - yv)| ≤ (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * (dC : ℝ) := by
          rw [abs_mul, abs_of_nonneg (by positivity)]
          exact mul_le_mul_of_nonneg_left he (by positivity)
        have t2 := abs_add_le ((tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * (c - yv))
          ((L.map fun x => (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))).sum -
              (tgt Sign.pos / (Maux : ℝ)) * ((L.map fun x => x.2 * Y.getD (foldI (((k % 186) * x.1) % 186)) 0).sum : ℤ) / 2 ^ PY)
        have e3 : (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * (dC : ℝ) + (tgt Sign.pos / (Maux : ℝ)) * ((L.map Prod.snd).sum : ℤ) * (dC : ℝ) =
            (tgt Sign.pos / (Maux : ℝ)) * ((x.2 + (L.map Prod.snd).sum : ℤ) : ℝ) * (dC : ℝ) := by simp only [Int.cast_add]; ring
        simp only [Int.cast_add] at e3
        linarith
      · have hc1 := Real.abs_cos_le_one ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))
        have t1 : |(tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))| ≤
            tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ) := by
          rw [abs_mul, abs_of_nonneg (by positivity)]
          calc _ ≤ (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * 1 := mul_le_mul_of_nonneg_left hc1 (by positivity)
            _ = _ := by ring
        have t2 := abs_add_le ((tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93)))
          ((L.map fun x => (tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ)) * Real.cos ((k : ℝ) * (Real.pi * (x.1 : ℝ) / 93))).sum)
        have e3 : tgt Sign.pos * (x.2 : ℝ) / (Maux : ℝ) + (tgt Sign.pos / (Maux : ℝ)) * ((L.map Prod.snd).sum : ℤ) =
            (tgt Sign.pos / (Maux : ℝ)) * ((x.2 : ℝ) + ((L.map Prod.snd).sum : ℤ)) := by ring
        linarith
  exact key _ hjj hp



/-! ### The error of one auxiliary coefficient (abstract) -/

theorem aux_j_err {j : ℕ} (hj1 : 1 ≤ j) (hj : j ≤ 384) {A B Ah Bh wA wB δ GM : ℝ}
    (hA : |A - Ah| ≤ wA) (hB : |B - Bh| ≤ wB) (hAh : 0 ≤ Ah) (hBh : 0 ≤ Bh)
    (hGM : 1 + Ah + 384 * Bh ≤ GM) (hδ : 0 ≤ δ)
    {τJ T S Sh m eT : ℕ → ℝ}
    (hτ0 : ∀ r < 16, 0 ≤ τJ r ∧ τJ r ≤ 1) (hT0 : ∀ r < 16, 0 ≤ T r ∧ T r ≤ 1)
    (hτT : ∀ r < 16, |τJ r - T r| ≤ eT r) (hS : ∀ r < 16, |S r| ≤ m r)
    (hSS : ∀ r < 16, |S r - Sh r| ≤ m r * δ) (hm0 : ∀ r < 16, 0 ≤ m r) :
    |(-((1 + A * j + B * (j : ℝ) ^ 2) / j) * ∑ r ∈ Finset.range 16, τJ r * S r) -
      (-((1 + Ah * j + Bh * (j : ℝ) ^ 2) / j) * ∑ r ∈ Finset.range 16, T r * Sh r)| ≤
    (wA + 384 * wB) * (∑ r ∈ Finset.range 16, m r) + GM * ∑ r ∈ Finset.range 16, m r * (eT r + δ) := by
  have hjr : (1 : ℝ) ≤ j := by exact_mod_cast hj1
  have hjr2 : (j : ℝ) ≤ 384 := by exact_mod_cast hj
  have hj0 : (0 : ℝ) < j := by linarith
  set G : ℝ := (1 + A * j + B * (j : ℝ) ^ 2) / j with hG
  set Gh : ℝ := (1 + Ah * j + Bh * (j : ℝ) ^ 2) / j with hGh
  set M : ℝ := ∑ r ∈ Finset.range 16, τJ r * S r with hM
  set Mh : ℝ := ∑ r ∈ Finset.range 16, T r * Sh r with hMh
  have hGd : G - Gh = (A - Ah) + (B - Bh) * j := by
    rw [hG, hGh]; field_simp; ring
  have hGdab : |G - Gh| ≤ wA + 384 * wB := by
    rw [hGd]
    have t1 := abs_add_le (A - Ah) ((B - Bh) * j)
    have t2 : |(B - Bh) * j| ≤ wB * 384 := by
      rw [abs_mul, abs_of_pos hj0]
      exact mul_le_mul hB hjr2 hj0.le ((abs_nonneg _).trans hB)
    linarith
  have hGhle : |Gh| ≤ GM := by
    have h1 : Gh = 1 / j + Ah + Bh * j := by rw [hGh]; field_simp
    have h2 : 1 / (j : ℝ) ≤ 1 := by rw [div_le_one hj0]; exact hjr
    have h3 : Bh * j ≤ Bh * 384 := mul_le_mul_of_nonneg_left hjr2 hBh
    have h4 : 0 ≤ Gh := by rw [h1]; positivity
    rw [abs_of_nonneg h4]; rw [h1]; linarith
  have hMle : |M| ≤ ∑ r ∈ Finset.range 16, m r := by
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun r hr => ?_)
    have hr' := Finset.mem_range.1 hr
    rw [abs_mul, abs_of_nonneg (hτ0 r hr').1]
    calc τJ r * |S r| ≤ 1 * m r := mul_le_mul (hτ0 r hr').2 (hS r hr') (abs_nonneg _) zero_le_one
      _ = m r := one_mul _
  have hMd : |M - Mh| ≤ ∑ r ∈ Finset.range 16, m r * (eT r + δ) := by
    rw [hM, hMh, ← Finset.sum_sub_distrib]
    refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun r hr => ?_)
    have hr' := Finset.mem_range.1 hr
    have e : τJ r * S r - T r * Sh r = (τJ r - T r) * S r + T r * (S r - Sh r) := by ring
    rw [e]
    have a1 : |(τJ r - T r) * S r| ≤ eT r * m r := by
      rw [abs_mul]; exact mul_le_mul (hτT r hr') (hS r hr') (abs_nonneg _) ((abs_nonneg _).trans (hτT r hr'))
    have a2 : |T r * (S r - Sh r)| ≤ m r * δ := by
      rw [abs_mul, abs_of_nonneg (hT0 r hr').1]
      calc T r * |S r - Sh r| ≤ 1 * (m r * δ) := mul_le_mul (hT0 r hr').2 (hSS r hr') (abs_nonneg _) zero_le_one
        _ = m r * δ := one_mul _
    calc _ ≤ |(τJ r - T r) * S r| + |T r * (S r - Sh r)| := abs_add_le _ _
      _ ≤ eT r * m r + m r * δ := add_le_add a1 a2
      _ = m r * (eT r + δ) := by ring
  have e : (-G * M) - (-Gh * Mh) = -((G - Gh) * M + Gh * (M - Mh)) := by ring
  rw [e, abs_neg]
  have hsumm : 0 ≤ ∑ r ∈ Finset.range 16, m r := Finset.sum_nonneg fun r hr => hm0 r (Finset.mem_range.1 hr)
  have hsume : 0 ≤ ∑ r ∈ Finset.range 16, m r * (eT r + δ) :=
    (abs_nonneg _).trans hMd
  calc |(G - Gh) * M + Gh * (M - Mh)| ≤ |(G - Gh) * M| + |Gh * (M - Mh)| := abs_add_le _ _
    _ ≤ (wA + 384 * wB) * (∑ r ∈ Finset.range 16, m r) + GM * ∑ r ∈ Finset.range 16, m r * (eT r + δ) := by
      apply add_le_add
      · rw [abs_mul]
        exact mul_le_mul hGdab hMle (abs_nonneg _) ((abs_nonneg _).trans hGdab)
      · rw [abs_mul]
        exact mul_le_mul hGhle hMd (abs_nonneg _) ((abs_nonneg _).trans hGhle)



/-! ### The auxiliary list: data, evaluator, specification -/

def Pa : ℕ := 100
def PA : ℕ := 100
def NE : ℕ := 26
def adN : ℕ := 2 ^ 64

structure AuxD where
  Y : List ℤ
  cls : List (List (ℕ × ℤ))
  pw : List (List ℤ)
  aL : List ℕ
  bL : List ℕ
  an : ℤ
  bn : ℤ

/-- one step of the 16 fixed-point power streams -/
def stepA (as ss : List ℕ) : List ℕ := List.zipWith (fun a s => s * a / 2 ^ Pa) as ss

/-- `sum_r ss_r * pw_r` -/
def Xsum (D : AuxD) (j : ℕ) (ss : List ℕ) : ℤ :=
  ((List.range 16).map fun r => ((ss.getD r 0 : ℕ) : ℤ) * ((D.pw.getD (j % 186) []).getD r 0)).sum

/-- `-G^_j * M^_j`, with `M^_j = (tgt/Maux) * sum_r ss_r pw_r / 2^(Pa+PY)` -/
def valAt (D : AuxD) (j : ℕ) (ss : List ℕ) : ℚ :=
  -((1 + ((D.an : ℚ) / 2 ^ PA) * j + ((D.bn : ℚ) / 2 ^ PA) * (j : ℚ) ^ 2) / j) *
    ((tgtQ / (Maux : ℚ)) * (Xsum D j ss : ℚ) / 2 ^ (Pa + PY))

def auxLoop (D : AuxD) : ℕ → ℕ → List ℕ → List ℤ
  | 0, _, _ => []
  | n + 1, j, ss => ⌊valAt D j ss * adN⌋ :: auxLoop D n (j + 1) (stepA D.aL ss)

def statesAt (aL : List ℕ) (j : ℕ) : List ℕ := aL.map fun a => stream Pa a (2 ^ Pa) j

theorem stepA_statesAt (aL : List ℕ) (j : ℕ) : stepA aL (statesAt aL j) = statesAt aL (j + 1) := by
  unfold stepA statesAt
  induction aL with
  | nil => rfl
  | cons a aL ih => simp [List.zipWith_cons_cons, stream, ih]

theorem auxLoop_spec (D : AuxD) : ∀ (n j : ℕ),
    auxLoop D n j (statesAt D.aL j) = (List.range n).map fun i => ⌊valAt D (j + i) (statesAt D.aL (j + i)) * adN⌋ := by
  intro n
  induction n with
  | zero => intro j; simp [auxLoop]
  | succ n ih =>
    intro j
    rw [auxLoop, stepA_statesAt, ih (j + 1), List.range_succ_eq_map, List.map_cons, List.map_map]
    congr 1
    apply List.map_congr_left
    intro i _
    simp only [Function.comp_apply, Nat.succ_eq_add_one]
    rw [show j + (i + 1) = j + 1 + i by ring]

/-- constant term of the auxiliary Chebyshev coefficients, exact rational. -/
def A0Q (D : AuxD) : ℚ :=
  -(tgtQ / (Maux : ℚ)) * (((List.range 16).map fun r => (Pcls D.cls r : ℚ) * sigq (min 1 r)).sum) +
    (53 * sigq 1 - (radN.getD (min 1 15) 0 : ℚ) / 10 ^ 17 / 2) / 58

def auxList (D : AuxD) : List ℤ :=
  ⌊A0Q D * adN⌋ :: auxLoop D 384 1 (statesAt D.aL 1)

theorem auxList_length (D : AuxD) : (auxList D).length = 385 := by
  have : ∀ n j ss, (auxLoop D n j ss).length = n := by
    intro n
    induction n with
    | zero => intro j ss; rfl
    | succ n ih => intro j ss; simp [auxLoop, ih]
  simp [auxList, this]

theorem auxList_getD (D : AuxD) {j : ℕ} (hj1 : 1 ≤ j) (hj : j ≤ 384) :
    (auxList D).getD j 0 = ⌊valAt D j (statesAt D.aL j) * adN⌋ := by
  unfold auxList
  rw [auxLoop_spec D 384 1]
  obtain ⟨i, rfl⟩ : ∃ i, j = i + 1 := ⟨j - 1, by omega⟩
  simp only [List.getD_cons_succ]
  rw [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_range (by omega)]
  simp only [Option.map_some, Option.getD_some]
  rw [show 1 + i = i + 1 by ring]



/-! ### Error of the integer auxiliary list -/

def Pq : ℕ := 140
def QLN : ℕ := 1320527625000233275470811989573145307439723
def QHN : ℕ := 1320527625000233275470811989573145307439724
def qlo : ℚ := (QLN : ℚ) / 2 ^ Pq
def qhi : ℚ := (QHN : ℚ) / 2 ^ Pq

def AuxOK (D : AuxD) : Prop :=
  (∀ l < 94, (D.Y.getD l 0 : ℚ) ≤ cosY l * 2 ^ PY ∧ cosY l * 2 ^ PY < D.Y.getD l 0 + 1) ∧
  (∀ r < 16, D.cls.getD r [] = clsOf r) ∧
  (∀ jm < 186, ∀ r < 16, (D.pw.getD jm []).getD r 0 = PwC D.Y D.cls r jm) ∧
  D.aL.length = 16 ∧
  (∀ r < 16, ((D.aL.getD r 0 : ℕ) : ℚ) ≤ expLoQ (tq r) NE * 2 ^ Pa ∧ D.aL.getD r 0 ≤ 2 ^ Pa) ∧
  ((D.an : ℚ) / 2 ^ PA ≤ Af (qhi ^ 2) ∧ Af (qlo ^ 2) ≤ (D.an + 1) / 2 ^ PA) ∧
  ((D.bn : ℚ) / 2 ^ PA ≤ Bf (qhi ^ 2) ∧ Bf (qlo ^ 2) ≤ (D.bn + 1) / 2 ^ PA) ∧
  0 ≤ D.an ∧ 0 ≤ D.bn ∧ 0 ≤ qlo ∧ qhi ≤ 1 ∧
  (qlo ≤ expLoQ (27 / 500) NE ∧ expHiQ (27 / 500) NE ≤ qhi) ∧
  (∀ r < 16, expHiQ (tq r) NE ≤ ((D.bL.getD r 0 : ℕ) : ℚ) / 2 ^ Pa)

def mq (D : AuxD) (r : ℕ) : ℚ := (tgtQ / (Maux : ℚ)) * (Pcls D.cls r : ℚ)
def eTq (D : AuxD) (r : ℕ) : ℚ :=
  384 * (((D.bL.getD r 0 : ℕ) : ℚ) / 2 ^ Pa - ((D.aL.getD r 0 : ℕ) : ℚ) / 2 ^ Pa) + 384 / 2 ^ Pa
def GMq (D : AuxD) : ℚ := 1 + (D.an : ℚ) / 2 ^ PA + 384 * ((D.bn : ℚ) / 2 ^ PA)
def eJq (D : AuxD) : ℚ :=
  (1 / 2 ^ PA + 384 * (1 / 2 ^ PA)) * ((List.range 16).map (mq D)).sum +
    GMq D * ((List.range 16).map fun r => mq D r * (eTq D r + dC)).sum

theorem sum_range_list (f : ℕ → ℝ) (n : ℕ) : ((List.range n).map f).sum = ∑ r ∈ Finset.range n, f r := by
  induction n with
  | zero => simp
  | succ n ih => rw [List.range_succ, List.map_append, List.sum_append, Finset.sum_range_succ, ih]; simp

theorem sum_range_list_q (f : ℕ → ℚ) (n : ℕ) : (((List.range n).map f).sum : ℚ) = ∑ r ∈ Finset.range n, f r := by
  induction n with
  | zero => simp
  | succ n ih => rw [List.range_succ, List.map_append, List.sum_append, Finset.sum_range_succ, ih]; simp

theorem q_enc (h : qlo ≤ expLoQ (27 / 500) NE ∧ expHiQ (27 / 500) NE ≤ qhi) :
    (qlo : ℝ) ≤ capSource.q ∧ capSource.q ≤ (qhi : ℝ) := by
  rw [q_eq]
  obtain ⟨e1, e2⟩ := expQ_enc (27 / 500) (by norm_num) (by norm_num) NE (by norm_num [NE])
  have h1 := (Rat.cast_le (K := ℝ)).2 h.1
  have h2 := (Rat.cast_le (K := ℝ)).2 h.2
  exact ⟨h1.trans e1, e2.trans h2⟩

theorem AB_enc {D : AuxD} (h : AuxOK D) :
    |capSource.strength - ((D.an : ℚ) / 2 ^ PA : ℚ)| ≤ (1 / 2 ^ PA : ℚ) ∧
    |capSource.curvature - ((D.bn : ℚ) / 2 ^ PA : ℚ)| ≤ (1 / 2 ^ PA : ℚ) := by
  obtain ⟨-, -, -, -, -, ⟨a1, a2⟩, ⟨b1, b2⟩, -, -, hqlo0, hqhi1, hqe, -⟩ := h
  obtain ⟨hq1, hq2⟩ := q_enc hqe
  have hql0 : (0 : ℝ) ≤ qlo := by exact_mod_cast hqlo0
  have hqh1 : (qhi : ℝ) ≤ 1 := by exact_mod_cast hqhi1
  have hq0 := q_pos'
  have hqq1 := q_lt_one'
  have hx1 : (qlo : ℝ) ^ 2 ≤ capSource.q ^ 2 := by gcongr
  have hx2 : capSource.q ^ 2 ≤ (qhi : ℝ) ^ 2 := by gcongr
  have hx3 : (qhi : ℝ) ^ 2 ≤ 1 := by nlinarith
  have hx4 : capSource.q ^ 2 ≤ 1 := by nlinarith
  have hs := strength_eq
  have hc := curvature_eq
  have sA1 := AfR_anti (by positivity : (0 : ℝ) ≤ capSource.q ^ 2) hx2 hx3
  have sA2 := AfR_anti (by positivity : (0 : ℝ) ≤ (qlo : ℝ) ^ 2) hx1 hx4
  have sB1 := BfR_anti (by positivity : (0 : ℝ) ≤ capSource.q ^ 2) hx2 hx3
  have sB2 := BfR_anti (by positivity : (0 : ℝ) ≤ (qlo : ℝ) ^ 2) hx1 hx4
  have eA1 : AfR ((qhi : ℝ) ^ 2) = (Af (qhi ^ 2) : ℝ) := by
    have := Af_cast (qhi ^ 2); push_cast at this; exact this
  have eA2 : AfR ((qlo : ℝ) ^ 2) = (Af (qlo ^ 2) : ℝ) := by
    have := Af_cast (qlo ^ 2); push_cast at this; exact this
  have eB1 : BfR ((qhi : ℝ) ^ 2) = (Bf (qhi ^ 2) : ℝ) := by
    have := Bf_cast (qhi ^ 2); push_cast at this; exact this
  have eB2 : BfR ((qlo : ℝ) ^ 2) = (Bf (qlo ^ 2) : ℝ) := by
    have := Bf_cast (qlo ^ 2); push_cast at this; exact this
  have a1' := (Rat.cast_le (K := ℝ)).2 a1
  have a2' := (Rat.cast_le (K := ℝ)).2 a2
  have b1' := (Rat.cast_le (K := ℝ)).2 b1
  have b2' := (Rat.cast_le (K := ℝ)).2 b2
  push_cast at a1' a2' b1' b2' ⊢
  rw [hs, hc]
  rw [eA1] at sA1; rw [eA2] at sA2; rw [eB1] at sB1; rw [eB2] at sB2
  have ea : ((D.an : ℝ) + 1) / 2 ^ PA = (D.an : ℝ) / 2 ^ PA + 1 / 2 ^ PA := by ring
  have eb : ((D.bn : ℝ) + 1) / 2 ^ PA = (D.bn : ℝ) / 2 ^ PA + 1 / 2 ^ PA := by ring
  rw [ea] at a2'
  rw [eb] at b2'
  constructor <;> rw [abs_le] <;> constructor <;> linarith



theorem statesAt_getD {aL : List ℕ} (hlen : aL.length = 16) {r : ℕ} (hr : r < 16) (j : ℕ) :
    (statesAt aL j).getD r 0 = stream Pa (aL.getD r 0) (2 ^ Pa) j := by
  unfold statesAt
  have hr' : r < aL.length := by omega
  rw [List.getD_eq_getElem _ _ (by simpa using hr'), List.getD_eq_getElem _ _ hr']
  simp

theorem stream_le_one (a P : ℕ) (haP : a ≤ 2 ^ P) (k : ℕ) : (stream P a (2 ^ P) k : ℝ) / 2 ^ P ≤ 1 := by
  have hP : (0 : ℝ) < 2 ^ P := by positivity
  have hu := stream_upper P a (2 ^ P) k
  have hs : ((2 ^ P : ℕ) : ℝ) / 2 ^ P = 1 := by push_cast; field_simp
  rw [hs, one_mul] at hu
  have hα0 : (0 : ℝ) ≤ (a : ℝ) / 2 ^ P := by positivity
  have hα1 : (a : ℝ) / 2 ^ P ≤ 1 := by rw [div_le_one hP]; exact_mod_cast haP
  exact hu.trans (pow_le_one₀ hα0 hα1)

theorem aux_coef_err (D : AuxD) (h : AuxOK D) {j : ℕ} (hj1 : 1 ≤ j) (hj : j ≤ 384) :
    |AngularCap.auxA capSource Sign.pos 1 j - (((auxList D).getD j 0 : ℤ) : ℝ) / (adN : ℝ)| ≤
