      |tauR r ^ j - (stream Pa (D.aL.getD r 0) (2 ^ Pa) j : ℝ) / 2 ^ Pa| ≤ (eTq D r : ℝ) ∧
      |Sr r j| ≤ (mq D r : ℝ) ∧
      |Sr r j - ((tgtQ / (Maux : ℚ) : ℚ) : ℝ) * (((D.pw.getD (j % 186) []).getD r 0 : ℤ) : ℝ) / 2 ^ PY| ≤ (mq D r : ℝ) * (dC : ℝ) := by
    intro r hr
    obtain ⟨hτ0, hτ1⟩ := tauR_le_one hr
    obtain ⟨hlo, hhi0⟩ := tauR_enc hr NE (by norm_num [NE])
    obtain ⟨ha1, ha2⟩ := haL r hr
    have hhi : tauR r ≤ ((D.bL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa := by
      have := (Rat.cast_le (K := ℝ)).2 (hbL r hr)
      push_cast at this
