theorem auxOK_len : auxD.aL.length = 16 := by decide +kernel
theorem auxOK_aL : ∀ r < 16, ((auxD.aL.getD r 0 : ℕ) : ℚ) ≤ expLoQ (tq r) NE * 2 ^ Pa ∧ auxD.aL.getD r 0 ≤ 2 ^ Pa := by decide +kernel
theorem auxOK_bL : ∀ r < 16, expHiQ (tq r) NE ≤ ((auxD.bL.getD r 0 : ℕ) : ℚ) / 2 ^ Pa := by decide +kernel
theorem auxOK_A : (auxD.an : ℚ) / 2 ^ PA ≤ Af (qhi ^ 2) ∧ Af (qlo ^ 2) ≤ (auxD.an + 1) / 2 ^ PA := by decide +kernel
theorem auxOK_B : (auxD.bn : ℚ) / 2 ^ PA ≤ Bf (qhi ^ 2) ∧ Bf (qlo ^ 2) ≤ (auxD.bn + 1) / 2 ^ PA := by decide +kernel
theorem auxOK_q : qlo ≤ expLoQ (27 / 500) NE ∧ expHiQ (27 / 500) NE ≤ qhi := by decide +kernel
theorem auxOK_misc : 0 ≤ auxD.an ∧ 0 ≤ auxD.bn ∧ 0 ≤ qlo ∧ qhi ≤ 1 := by decide +kernel

theorem auxOK : AuxOK auxD :=
  ⟨auxOK_Y, auxOK_cls, auxOK_pw, auxOK_len, auxOK_aL, auxOK_A, auxOK_B, auxOK_misc.1, auxOK_misc.2.1,
    auxOK_misc.2.2.1, auxOK_misc.2.2.2, auxOK_q, auxOK_bL⟩

-- streams, aggregation, ceilings: the gas coefficient list
theorem hgl_eq : GasCert.glPos PP (triL.map recOf) cnumD 255 = glL := by
  rw [← glFast_eq]
  have : glFast ((triL.map recOf).map BinRec.a) ((triL.map recOf).map BinRec.s0) cnumD 255 = glL := by
    -- kcost: 30 bins x 255 power steps in 192-bit integer arithmetic (measured below, about 8 s).
    decide +kernel
  exact this

-- the auxiliary list (16 streams x 384 steps, 384 floors)
theorem haux_eq : auxList auxD = auxL := by decide +kernel

theorem heps : eGq + eAq auxD + tailQ auxD ≤ epsQ := by decide +kernel

-- power -> Chebyshev conversion and combination
theorem hconv : AngularCap.combineP (AngularCap.Nlist glL) auxL (2 ^ PP * 2 ^ (glL.length - 1)) adN = pL := by
  decide +kernel

-- the weighted square identity (Kronecker packed) and the margin
theorem hkron : KronSquare.KronSquare KD pL qL [] rL ((2 ^ PP * 2 ^ (glL.length - 1)) * adN) capQ epsQ := by
  decide +kernel

open CatalanMeasure.Signed.ChebSquare in
theorem hmarg : l1 rL.tail < rL.headD 0 := by decide +kernel

open CatalanMeasure.Signed.ChebSquare in
theorem hid_final : SquareIdentity (AngularCap.combineP (AngularCap.Nlist glL) auxL (2 ^ PP * 2 ^ (glL.length - 1)) adN)
    qL [] rL ((2 ^ PP * 2 ^ (glL.length - 1)) * adN) capQ epsQ := by
  rw [hconv]; exact hkron.squareIdentity

/-- **The pilot certificate**: positive species, radius index 1, gas degree 255. -/
def angPilot : AngularCap.AngRadiusCert capSource Sign.pos 1 capQ :=
  angPilot_of_data triL passAll_tri hbins_tri cnumD const_ok cb_ok auxD auxOK qhi_lt glL auxL qL rL
    hgl_eq haux_eq epsQ heps hid_final hmarg

#print axioms angPilot

end

