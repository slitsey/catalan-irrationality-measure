    have ha1' : ((D.aL.getD r 0 : ℕ) : ℝ) / 2 ^ Pa ≤ (expLoQ (tq r) NE : ℝ) := by
      have := (Rat.cast_le (K := ℝ)).2 ha1
      push_cast at this
