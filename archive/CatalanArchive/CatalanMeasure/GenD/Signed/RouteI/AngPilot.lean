      (GMq D : ℝ) * ∑ r ∈ Finset.range 16, (mq D r : ℝ) * ((eTq D r : ℝ) + dC) := by
    unfold eJq
    rw [sum_range_list_q (mq D) 16, sum_range_list_q (fun r => mq D r * (eTq D r + dC)) 16]
    push_cast
    ring
  exact (abs_sub_le _ _ _).trans (add_le_add (key.trans (le_of_eq hJ.symm)) d1)



/-! ### Constant term, total l1 error, and the tail of the auxiliary part -/

theorem auxA_zero (D : AuxD) (hcl : ∀ r < 16, D.cls.getD r [] = clsOf r) :
    AngularCap.auxA capSource Sign.pos 1 0 = (A0Q D : ℝ) := by
  have hgt : 0 ≤ tgt Sign.pos := tgt_nonneg _
  have hMaux : (0 : ℤ) ≤ sumP paT := pa_tot.le
  have hM : (0 : ℝ) < (Maux : ℝ) := by unfold Maux; norm_num
  unfold AngularCap.auxA
  simp only [if_true]
  unfold AngularSource.auxConst AngularSource.extTerm
  show ((auxCells Sign.pos).map fun e => e.w * (-capSource.sigma (min 1 e.rad))).sum + _ = _
  unfold auxCells auxT
  rw [List.map_map]
  have hterm : ∀ t ∈ paT, ((fun e => e.w * (-capSource.sigma (min 1 e.rad))) ∘ mkAux (tgt Sign.pos) (sumP paT)) t =
      (fun r => -(sigq (min 1 r) : ℝ)) t.1.toNat * (tgt Sign.pos * (t.2.2 : ℝ) / (Maux : ℝ)) := by
    intro t ht
    obtain ⟨hp, hr⟩ := paT_ok t ht
    obtain ⟨f1, f2, f3⟩ := mkAux_fields hgt hMaux hp
    simp only [Function.comp_apply, f1, f3]
    rw [show (sumP paT : ℝ) = (Maux : ℝ) by rw [Maux_eq], sigma_eq]
    ring
  rw [List.map_congr_left hterm]
  have hcl' : ∀ t ∈ paT, t.1.toNat < 16 := fun t ht => by
    have := (paT_ok t ht).2; omega
  rw [group_sum' paT (fun t => t.1.toNat) 16 hcl' (fun r => -(sigq (min 1 r) : ℝ))
    (fun t => tgt Sign.pos * (t.2.2 : ℝ) / (Maux : ℝ))]
  have hinner : ∀ r < 16, (paT.map fun t => if t.1.toNat = r then tgt Sign.pos * (t.2.2 : ℝ) / (Maux : ℝ) else 0).sum =
      tgt Sign.pos / (Maux : ℝ) * (Pcls D.cls r : ℝ) := by
    intro r hr
    rw [ite_sum_filter paT (fun t => t.1.toNat = r)]
    unfold Pcls
    rw [hcl r hr]
    unfold clsOf
    rw [List.map_map]
    generalize paT.filter (fun t => decide (t.1.toNat = r)) = L
    induction L with
    | nil => simp
    | cons t L ih => simp only [List.map_cons, List.sum_cons, Function.comp_apply, Int.cast_add] at ih ⊢; rw [ih]; ring
  have hsum : ∑ r ∈ Finset.range 16, -(sigq (min 1 r) : ℝ) *
        (paT.map fun t => if t.1.toNat = r then tgt Sign.pos * (t.2.2 : ℝ) / (Maux : ℝ) else 0).sum =
      -(tgt Sign.pos / (Maux : ℝ)) * ∑ r ∈ Finset.range 16, (Pcls D.cls r : ℝ) * (sigq (min 1 r) : ℝ) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro r hr
    rw [hinner r (Finset.mem_range.1 hr)]
    ring
  rw [hsum]
  have hrad : capSource.radial 1 = ((radN.getD (min 1 15) 0 : ℚ) / 10 ^ 17 : ℚ) := by
    show (radN.getD (min 1 15) 0 : ℝ) / 10 ^ 17 = _
    push_cast; rfl
  rw [sigma_eq, hrad]
  unfold A0Q
  rw [sum_range_list_q (fun r => (Pcls D.cls r : ℚ) * sigq (min 1 r)) 16, tgt_pos_val]
  push_cast
  ring



def eAq (D : AuxD) : ℚ := 1 / (adN : ℚ) + 384 * (eJq D + 1 / (adN : ℚ))

theorem hA_bound (D : AuxD) (h : AuxOK D) :
    ∑ j ∈ Finset.range (384 + 1),
      |AngularCap.auxA capSource Sign.pos 1 j - (((auxList D).getD j 0 : ℤ) : ℝ) / (adN : ℝ)| ≤ (eAq D : ℝ) := by
  have hcl : ∀ r < 16, D.cls.getD r [] = clsOf r := h.2.1
  have hadN : (0 : ℝ) < adN := by unfold adN; positivity
  rw [Finset.sum_range_succ']
  have h0 : |AngularCap.auxA capSource Sign.pos 1 0 - (((auxList D).getD 0 0 : ℤ) : ℝ) / (adN : ℝ)| ≤ 1 / (adN : ℝ) := by
    rw [auxA_zero D hcl]
    have hg : (auxList D).getD 0 0 = ⌊A0Q D * adN⌋ := rfl
    rw [hg]
    have hfl1 := Int.floor_le (A0Q D * adN)
    have hfl2 := Int.lt_floor_add_one (A0Q D * adN)
    set fl : ℤ := ⌊A0Q D * adN⌋
    have c1 : (fl : ℝ) ≤ (A0Q D : ℝ) * adN := by exact_mod_cast hfl1
    have c2 : (A0Q D : ℝ) * adN < fl + 1 := by exact_mod_cast hfl2
    have e1 : (fl : ℝ) / adN ≤ (A0Q D : ℝ) := by rw [div_le_iff₀ hadN]; exact c1
    have e2 : (A0Q D : ℝ) ≤ (fl : ℝ) / adN + 1 / adN := by
      rw [← add_div, le_div_iff₀ hadN]; linarith
    rw [abs_le]; constructor <;> linarith
  have hs : ∑ j ∈ Finset.range 384,
      |AngularCap.auxA capSource Sign.pos 1 (j + 1) - (((auxList D).getD (j + 1) 0 : ℤ) : ℝ) / (adN : ℝ)| ≤
      384 * ((eJq D : ℝ) + 1 / (adN : ℝ)) := by
    have : ∀ j ∈ Finset.range 384,
        |AngularCap.auxA capSource Sign.pos 1 (j + 1) - (((auxList D).getD (j + 1) 0 : ℤ) : ℝ) / (adN : ℝ)| ≤
        (eJq D : ℝ) + 1 / (adN : ℝ) := by
      intro j hj
      have := Finset.mem_range.1 hj
      exact aux_coef_err D h (by omega) (by omega)
    refine (Finset.sum_le_sum this).trans (le_of_eq ?_)
    simp
    ring
  unfold eAq
  push_cast
  linarith

/-- bound for the tail of the auxiliary series. -/
def tailQ (D : AuxD) : ℚ :=
  qhi ^ 385 * ((1 / 385 + ((D.an : ℚ) + 1) / 2 ^ PA) * (1 / (1 - qhi)) +
    ((D.bn : ℚ) + 1) / 2 ^ PA * (385 * (1 / (1 - qhi)) + qhi * (1 / (1 - qhi)) ^ 2)) * tgtQ

theorem tail_bound (D : AuxD) (h : AuxOK D) (hq1 : qhi < 1) :
    capSource.auxTail (Trunc.finite 384) Sign.pos ≤ (tailQ D : ℝ) := by
  obtain ⟨hAe, hBe⟩ := AB_enc h
  obtain ⟨hq1', hq2'⟩ := q_enc h.2.2.2.2.2.2.2.2.2.2.2.1
  have hqh1 : (qhi : ℝ) < 1 := by exact_mod_cast hq1
  have hq0 := q_pos'
  have hqq1 := q_lt_one'
  have hS := capSource_admissible
  have hA0 := AngularSource.strength_nonneg capSource hS
  have hB0 := AngularSource.curvature_nonneg capSource hS
  have hmass : capSource.auxMass Sign.pos = (tgtQ : ℝ) := by rw [auxMass_eq, tgt_pos_val]
  have hA1 : capSource.strength ≤ ((D.an : ℝ) + 1) / 2 ^ PA := by
    have := (abs_le.1 hAe).2
    push_cast at this
    have e : ((D.an : ℝ) + 1) / 2 ^ PA = (D.an : ℝ) / 2 ^ PA + 1 / 2 ^ PA := by ring
    rw [e]; linarith
  have hB1 : capSource.curvature ≤ ((D.bn : ℝ) + 1) / 2 ^ PA := by
    have := (abs_le.1 hBe).2
    push_cast at this
    have e : ((D.bn : ℝ) + 1) / 2 ^ PA = (D.bn : ℝ) / 2 ^ PA + 1 / 2 ^ PA := by ring
    rw [e]; linarith
  have hqhi0 : (0 : ℝ) ≤ qhi := by linarith
  have hu : 1 / (1 - capSource.q) ≤ 1 / (1 - (qhi : ℝ)) :=
    one_div_le_one_div_of_le (by linarith) (by linarith)
  have hu0 : 0 ≤ 1 / (1 - capSource.q) := by
    have : 0 < 1 - capSource.q := by linarith
    positivity
  have htg : (0 : ℝ) ≤ (tgtQ : ℝ) := by
    rw [← tgt_pos_val]; exact tgt_nonneg _
  rw [AngularSource.auxTail_eq, hmass]
  unfold AngularSource.tailUnit tailQ
  simp only [if_neg (by decide : ¬ (Sign.pos = Sign.neg)), mul_one]
  push_cast
  have e385 : (384 : ℝ) + 1 = 385 := by norm_num
  rw [e385]
  set u : ℝ := 1 / (1 - capSource.q) with hudef
  set uh : ℝ := 1 / (1 - (qhi : ℝ)) with huhdef
  set Ah : ℝ := ((D.an : ℝ) + 1) / 2 ^ PA with hAhdef
  set Bh : ℝ := ((D.bn : ℝ) + 1) / 2 ^ PA with hBhdef
  have hP : capSource.q ^ 385 ≤ (qhi : ℝ) ^ 385 := pow_le_pow_left₀ hq0.le hq2' 385
  have hP0 : 0 ≤ capSource.q ^ 385 := by positivity
  have hAhnn : 0 ≤ Ah := by
    have : (0 : ℝ) ≤ D.an := by exact_mod_cast h.2.2.2.2.2.2.2.1
    rw [hAhdef]; positivity
  have h1 : (1 / 385 + capSource.strength) * u ≤ (1 / 385 + Ah) * uh := by
    apply mul_le_mul (by linarith) hu hu0 (by linarith)
  have hu2 : u ^ 2 ≤ uh ^ 2 := pow_le_pow_left₀ hu0 hu 2
  have h2 : capSource.q * u ^ 2 ≤ (qhi : ℝ) * uh ^ 2 :=
    mul_le_mul hq2' hu2 (by positivity) hqhi0
  have h3 : capSource.curvature * (385 * u + capSource.q * u ^ 2) ≤ Bh * (385 * uh + (qhi : ℝ) * uh ^ 2) := by
    apply mul_le_mul hB1 (by linarith) (by positivity) (by
      have : (0 : ℝ) ≤ capSource.curvature := hB0
      exact le_trans hB0 hB1)
  have hX : (1 / 385 + capSource.strength) * u + capSource.curvature * (385 * u + capSource.q * u ^ 2) ≤
      (1 / 385 + Ah) * uh + Bh * (385 * uh + (qhi : ℝ) * uh ^ 2) := by linarith
  have hX0 : 0 ≤ (1 / 385 + capSource.strength) * u + capSource.curvature * (385 * u + capSource.q * u ^ 2) := by
    positivity
  calc capSource.q ^ 385 * ((1 / 385 + capSource.strength) * u + capSource.curvature * (385 * u + capSource.q * u ^ 2)) * (tgtQ : ℝ)
      ≤ (qhi : ℝ) ^ 385 * ((1 / 385 + Ah) * uh + Bh * (385 * uh + (qhi : ℝ) * uh ^ 2)) * (tgtQ : ℝ) := by
        apply mul_le_mul_of_nonneg_right _ htg
        exact mul_le_mul hP hX hX0 (pow_nonneg hqhi0 _)



/-! ### The certificate -/

def constOK (T : List Tri) (cnum : ℤ) : Bool :=
  match constSum T with
  | some (S, H) => decide ((cnum : ℚ) ≤ S * 2 ^ PP ∧ S * 2 ^ PP < cnum + 1 ∧ H ≤ 1 / 10 ^ 20)
  | none => false

theorem constOK_spec {T : List Tri} {cnum : ℤ} (h : constOK T cnum = true) :
    ∃ S H : ℚ, constSum T = some (S, H) ∧ (cnum : ℚ) ≤ S * 2 ^ PP ∧ S * 2 ^ PP < cnum + 1 ∧ H ≤ 1 / 10 ^ 20 := by
  unfold constOK at h
  cases hc : constSum T with
  | none => rw [hc] at h; simp at h
  | some t =>
    obtain ⟨S, H⟩ := t
    rw [hc] at h
    simp only [decide_eq_true_eq] at h
    exact ⟨S, H, rfl, h.1, h.2.1, h.2.2⟩

def eGq : ℚ := 1 / 2 ^ PP + 1 / 10 ^ 20 + 255 * (1 / 10 ^ 22)

def capQ : ℚ := 29557 / 200000

theorem gas_final (T : List Tri) (hT : passAll T) (hbins : T.map Prod.fst = binsQ)
    (cnum : ℤ) (hc : constOK T cnum = true) (hcb : cbQ T ≤ 1 / 10 ^ 22) :
    AngularSource.Binning (capSource.gas Sign.pos) ((T.map recOf).map BinRec.cells) ∧
    ∑ j ∈ Finset.range (255 + 1),
      |AngularCap.gasA capSource Sign.pos 1 ((T.map recOf).map BinRec.cells) j -
        (((GasCert.glPos PP (T.map recOf) cnum 255).getD j 0 : ℤ) : ℝ) / ((2 ^ PP : ℕ) : ℝ)| ≤ (eGq : ℝ) := by
  obtain ⟨S, H, hS, hc1, hc2, hH⟩ := constOK_spec hc
  have hg := gas_cert T hT hbins hS hc1 hc2 255
  refine ⟨hg.1, hg.2.trans ?_⟩
  unfold eGq
  have h1 : H ≤ 1 / 10 ^ 20 := hH
  have h2 : cbQ T ≤ 1 / 10 ^ 22 := hcb
  have : (1 / 2 ^ PP + H + (255 : ℕ) * cbQ T : ℚ) ≤ 1 / 2 ^ PP + 1 / 10 ^ 20 + 255 * (1 / 10 ^ 22) := by
    push_cast; nlinarith
  exact_mod_cast this

open CatalanMeasure.Signed.ChebSquare in
def angPilot_of_data (T : List Tri) (hT : passAll T) (hbins : T.map Prod.fst = binsQ)
    (cnum : ℤ) (hc : constOK T cnum = true) (hcb : cbQ T ≤ 1 / 10 ^ 22)
    (D : AuxD) (hD : AuxOK D) (hqhi1 : qhi < 1)
    (glL auxL qL rL : List ℤ) (hgl : GasCert.glPos PP (T.map recOf) cnum 255 = glL) (haux : auxList D = auxL)
    (εQ : ℚ) (hε : eGq + eAq D + tailQ D ≤ εQ)
    (hid : SquareIdentity (AngularCap.combineP (AngularCap.Nlist glL) auxL (2 ^ PP * 2 ^ (glL.length - 1)) adN)
      qL [] rL ((2 ^ PP * 2 ^ (glL.length - 1)) * adN) capQ εQ)
    (hm : l1 rL.tail < rL.headD 0) :
    AngularCap.AngRadiusCert capSource Sign.pos 1 capQ := by
  have hg := gas_final T hT hbins cnum hc hcb
  refine
    { bins := (T.map recOf).map BinRec.cells
      hb := hg.1
      n := 255
      hn := by decide
      gl := glL
      gd := 2 ^ PP
      hgd := by positivity
      hgl := ?_
      hgl0 := ?_
      aux := auxL
      ad := adN
      had := by unfold adN; positivity
      hax := ?_
      eG := eGq
      eA := eAq D
      eT := tailQ D
      ε := εQ
      hG := ?_
      hA := ?_
      hT := tail_bound D hD hqhi1
      hε := hε
      q := qL
      s := []
      r := rL
      hid := hid
      hm := hm }
  · rw [← hgl, GasCert.glPos_length]
  · rw [← hgl]; exact GasCert.glPos_ne_nil _ _ _ _
  · rw [← haux, auxList_length]
  · rw [← hgl]; exact hg.2
  · rw [← haux]; exact hA_bound D hD



