theorem map_getD_range {α : Type*} (l : List α) (d : α) (n : ℕ) (h : l.length = n) :
    (List.range n).map (fun k => l.getD k d) = l := by
  subst h
  apply List.ext_getElem
  · simp
  · intro i h1 h2
    simp [List.getD_eq_getElem?_getD, h2]

theorem hbins : TL.map BD.pcs = binsQ 64 TtD (gasT Sign.pos) := by
  rw [binsQ_eq]
  unfold TL
  rw [List.map_map]
  exact map_getD_range binsLit [] 59 binsLit_length

theorem part_pos : Partitioned (capSource.gas Sign.pos) (binsY TL) :=
  partitioned_pos (K := 64) (by norm_num) sum_row0 cuts_ok hbins

