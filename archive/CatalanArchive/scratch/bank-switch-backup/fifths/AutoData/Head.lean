import CatalanCore.Uniform.Content.BankShared.Check.Split
import CatalanCore.Uniform.Content.BankShared.Check.UF
set_option Elab.async false

/-! # Data header: the fifths bank parameters (lane C1L)

Generated by `scripts/claude/bank/check/emit_bank_uf.py fifths`.  The header bank `bankHead` carries the parameters
of the fifths UF bank (`P_bad = 9`, `c_Fr ≤ 49`, depth `≤ 64`, catalogue
`tableT ++ [LP1, LP2, R, S] ++ windows`) with `Λ := 0` and no templates; the per-class modules `U<j>` check their
template against it, and `AutoData` assembles the bank (`Check.Split`). -/

namespace CatalanCore.Uniform.Bank.FifthsContent.Auto
open CatalanCore.Uniform.Content.BankShared.Check

/-- `n / d`. -/
abbrev qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

/-- LP1, LP2, the rank branch, the UF branch and the M3D windows (indices 6, 7, 8, 9, 10, ...). -/
def bankExtra : List Branch := [brLP1, brLP2, brRank, brS, brWin 5 5, brWin 5 6, brWin 6 6, brWin 6 7, brWin 7 7, brWin 7 8, brWin 8 8, brWin 8 9, brWin 9 9, brWin 9 10]

/-- The fifths bank parameters, without templates. -/
def bankHead : BankData where
  q := 5
  M := 10
  α := qq 1 9
  members := [1, 2, 3, 4]
  depth := 64
  cF := 49
  Pbad := 9
  α0 := qq 20 9
  τ := qq 64 9
  Λ := 0
  α0b := qq 20 9
  t0 := qq 1 900
  extra := bankExtra
  tmpls := []

end CatalanCore.Uniform.Bank.FifthsContent.Auto
