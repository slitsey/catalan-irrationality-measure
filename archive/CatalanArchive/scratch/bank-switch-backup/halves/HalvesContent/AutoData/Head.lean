import CatalanCore.Uniform.Content.BankShared.Check.Split
import CatalanCore.Uniform.Content.BankShared.Check.UF
set_option Elab.async false

/-! # Data header: the halves bank parameters (lane C1L)

Generated by `scripts/claude/bank/check/emit_bank_uf.py halves`.  The header bank `bankHead` carries the parameters
of the halves UF bank (`P_bad = 4`, `c_Fr ≤ 16`, depth `≤ 64`, catalogue
`tableT ++ [LP1, LP2, R, S] ++ windows`) with `Λ := 0` and no templates; the per-class modules `U<j>` check their
template against it, and `AutoData` assembles the bank (`Check.Split`). -/

namespace CatalanCore.Uniform.Bank.HalvesContent.Auto
open CatalanCore.Uniform.Content.BankShared.Check

/-- `n / d`. -/
abbrev qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

/-- LP1, LP2, the rank branch, the UF branch and the M3D windows (indices 6, 7, 8, 9, 10, ...). -/
def bankExtra : List Branch := [brLP1, brLP2, brRank, brS, brWin 3 4, brWin 4 4, brWin 4 5, brWin 5 5, brWin 5 6, brWin 6 6, brWin 6 7, brWin 7 7, brWin 7 8]

/-- The halves bank parameters, without templates. -/
def bankHead : BankData where
  q := 2
  M := 2
  α := qq 3 20
  members := [1]
  depth := 64
  cF := 16
  Pbad := 4
  α0 := qq 23 10
  τ := qq 18 5
  Λ := 0
  α0b := qq 23 10
  t0 := qq 1 1000
  extra := bankExtra
  tmpls := []

end CatalanCore.Uniform.Bank.HalvesContent.Auto
