/-- The lambda bank parameters, without templates. -/
def bankHead : BankData where
  q := 4
  M := 4
  α := qq 1 10
  members := [1, 3]
  depth := 64
  cF := 36
  Pbad := 28
  α0 := qq 11 5
  τ := qq 14 1
  Λ := 0
  α0b := qq 11 5
  t0 := qq 1 1000
  extra := bankExtra
  tmpls := []

end CatalanCore.Uniform.Bank.LambdaContent.Auto
