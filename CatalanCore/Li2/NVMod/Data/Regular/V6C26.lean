def regularNumerators : List ℤ := raw_ints% [-0x141d3,0x3f3b5,-0x19d4c5,-0x216c89,0x862ae7,-0x5d3fd,-0x7184efd,0x68dd92c74089f0f228c7bd,-0x4eaec8c425451eff806848b69]
def regularDenominators : List ℤ := raw_ints% [0xaa00677f11dbdb2d78000,0x1c0cdde07c8bf4cde70000,0x10db6cb95e8a431e3370000,0x2bd41aaec29aae81b8f0000,0x2bd41aaec29aae81b8f0000,0x8c4055626ebbc805830000,0xdb248569cd0568889cb0000,0x3fc026cfa6b272310d0000,0x2bd41aaec29aae81b8f0000]
def regularValueAt (e : ℕ) : ℚ := (regularNumerators.getD e 0:ℚ)/(regularDenominators.getD e 1:ℚ)
