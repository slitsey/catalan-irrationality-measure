def regularNumerators : List ℤ := raw_ints% [-0x27c85d,0x93276b,-0xaf525,0x3ebc1,0x77d5,-0x16b1,0x178e9d,0x276fe573c00712516e0f466833,-0x279c1150e45da9256f808ad9a32b5]
def regularDenominators : List ℤ := raw_ints% [0x77dfd84a4b9e3bc597064eae00,0xefbfb094973c778b2e0c9d5c00,0xc9e4ca9813913c3f4f330b400,0x5fe646a1d6182fd1459ea5580,0xb2f018510c1e33e781280400,0x88ffd29e0d471fbd3ee2a31,0x15cb9bb06ad6f3984a01259400,0x17f991a875860bf45167a95600,0xefbfb094973c778b2e0c9d5c00]
def regularValueAt (e : ℕ) : ℚ := (regularNumerators.getD e 0:ℚ)/(regularDenominators.getD e 1:ℚ)
-- kcost: 2 s estimated; one original regularMoment value at z=1 through proved residues
set_option trace.profiler true in
