def regularNumerators : List ℤ := raw_ints% [-0x469,0xc2f,-0x69683,0x1848e9,-0x223,-0x4cf33,0x1379a0b7948e8dc965c1a1d32e5,-0x2e9da490ca7fb79ad2af96628a9]
def regularDenominators : List ℤ := raw_ints% [0x37eefbf26ab5bda0fe6d0000,0x45fa3a191e701e00d3eb0000,0x150c43798e27b9063fbdaf0000,0x3f24ca6caa772b12bf390d0000,0x2177ac7b515703380c4f0000,0x4db72085be1c83c84dd010000,0xbd6e5f45ff6581383dab270000,0x100957fb16f9b18adb3b30000]
def regularValueAt (e : ℕ) : ℚ := (regularNumerators.getD e 0:ℚ)/(regularDenominators.getD e 1:ℚ)
-- kcost: 2 s estimated; one original regularMoment value at z=1 through proved residues
set_option trace.profiler true in
