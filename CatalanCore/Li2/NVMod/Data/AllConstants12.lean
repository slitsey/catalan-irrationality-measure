-- kcost: 2 s estimated; finite coverage of the unchanged needed/special key sets
set_option trace.profiler true in
theorem coverage : (table.map (fun c=>c.input.key)).toFinset=needed 12 \ specialKeys := by
  exact (show (table.map (fun c=>c.input.key)).toFinset=Needed12Keys.keys.toFinset from rfl).trans Needed12Keys.coverage

theorem exists_certificate (A : TypeKey) (hA : A∈needed 12) (hS : A∉specialKeys) :
    ∃c : KeyCertificate,c.input.key=A := by
  have hm : A∈(table.map (fun c=>c.input.key)).toFinset := by
    rw [coverage]
    exact Finset.mem_sdiff.mpr ⟨hA,hS⟩
  obtain ⟨c,hc,he⟩:=List.mem_map.mp (List.mem_toFinset.mp hm)
  exact ⟨c,he⟩

def lookup (A : TypeKey) (hA : A∈needed 12) (hS : A∉specialKeys) : KeyCertificate :=
  Classical.choose (exists_certificate A hA hS)

theorem lookup_key (A : TypeKey) (hA : A∈needed 12) (hS : A∉specialKeys) :
    (lookup A hA hS).input.key=A := Classical.choose_spec (exists_certificate A hA hS)

def checked : AllConstantsChecked 12 where
  input:=fun A hA hS=>(lookup A hA hS).input
  key_eq:=lookup_key
  prime:=fun A hA hS=>(lookup A hA hS).prime
  endpoint0:=fun A hA hS=>(lookup A hA hS).endpoint0
  endpoint1:=fun A hA hS=>(lookup A hA hS).endpoint1
  endpointInf:=fun A hA hS=>(lookup A hA hS).endpointInf
  interiorChecked:=fun A hA hS=>(lookup A hA hS).interior
#print axioms checked
end
end CatalanCore.Li2.NVMod.Data.AllConstants12
