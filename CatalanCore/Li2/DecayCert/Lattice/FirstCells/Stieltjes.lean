theorem center_eq : center=first.mid.1-first.half.1*((phi+phi⁻¹)/2) := by decide +kernel
theorem actual_source_inverse_moments : sm.length=45 ∧ ∀k≤44,
    inverseMoment first.measure (center:ℝ) k=(coeffQ sm k:ℝ) := by
  have h := stieltjesMomentCheck_sound first phi 44 sm first_positive stieltjes_table
  simpa only [← center_eq] using h
