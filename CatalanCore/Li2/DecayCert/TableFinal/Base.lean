/-- The lattice frame: the whole half-line, no free part. -/
def latticeFrame : DualFrame := ⟨Ici 0,fun _ => ∅,fun _ hx => hx,Or.inl rfl,true,fun _ => rfl,fun _ _ => rfl⟩
def frames : FrameKey → DualFrame
  | .lattice => latticeFrame | .G2 => BentData.frameG2.frame | .G3 => BentData.frameG3.frame
  | .G4 => BentData.frameG4.frame | .G15 => BentData.frameG15.frame
def geometry : ∀ f : FrameKey,FrameGeometry (frames f)
  | .lattice => .pure rfl rfl (fun _ => rfl) | .G2 => BentData.frameG2.geometry | .G3 => BentData.frameG3.geometry
  | .G4 => BentData.frameG4.geometry | .G15 => BentData.frameG15.geometry
theorem bent_cut : ∀ f : FrameKey,f ≠ .lattice → frameCut (geometry f)=some 0 := by
  intro f hf
  cases f with
  | lattice => exact absurd rfl hf
  | G2 => exact congrArg some BentData.frameG2.cut_zero
  | G3 => exact congrArg some BentData.frameG3.cut_zero
  | G4 => exact congrArg some BentData.frameG4.cut_zero
  | G15 => exact congrArg some BentData.frameG15.cut_zero
def LP : Fin 0 → LatticePackage := fun i => i.elim0
