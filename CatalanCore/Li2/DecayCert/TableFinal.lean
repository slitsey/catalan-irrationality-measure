/-- **The Li₂ measure bound from the certified decay table.** -/
theorem li2_measure_of_table (a b : ℤ) (hb : 0<b) (hab : IsCoprime a b) (ha : a≠0) (h2 : 2*|a|≤b)
    (ρ D μ : ℝ) (hρ : 0<ρ)
    (hD : Candidate nodeTable (Int.sign a) (Real.log ((b:ℝ)/|(a:ℝ)|)) ρ D)
    (hη : 0<D+CatalanCore.Li2.cRate a b) (hμ : ρ*max (2/(D+CatalanCore.Li2.cRate a b)) (39/98)<μ)
    (nvCerts : CatalanCore.Li2.NVMod.AllConstantsChecked 12) :
    ∀ᶠ q : ℕ in Filter.atTop,∀ p : ℤ,(q:ℝ)^(-μ)<
      |(∑' k : ℕ,((a:ℝ)/b)^(k+1)/((k:ℝ)+1)^2)-(p:ℝ)/q| :=
  CatalanCore.Li2.li2_measure_general_of_tableSound nodeTable (tableSoundOfCertificatesS nodeTable certificates)
    a b hb hab ha h2 ρ D μ hρ hD hη hμ nvCerts
