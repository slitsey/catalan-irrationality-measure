  simp only [sourceDataCheck,Bool.and_eq_true,decide_eq_true_eq,List.all_eq_true]
  constructor
  · decide +kernel
  · intro j hj
    have hj' : j<2 := by simpa only [List.length_cons,List.length_nil] using List.mem_range.mp hj
