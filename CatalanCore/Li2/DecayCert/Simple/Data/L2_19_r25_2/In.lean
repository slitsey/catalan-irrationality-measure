      exact ⟨firstGeometry_ok,firstDensity_ok⟩
    · change (secondGeometry && bernCheck second.density (-1) 1 secondTree)=true
      simp only [Bool.and_eq_true]
      exact ⟨secondGeometry_ok,secondDensity_ok⟩
