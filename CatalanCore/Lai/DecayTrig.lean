module

public import CatalanMeasure.GenD.Signed.LogEval
public import Mathlib.Analysis.SpecialFunctions.Trigonometric.Bounds
public import Mathlib.Analysis.Complex.Trigonometric

@[expose] public section

/-!
# The trigonometric node table `cos / sin (π j / 128)`, `j ≤ 128` (Lai decay, LD20)

The A cells of the wedge certificate have dyadic centres `φ_c = π θ_c`, `θ_c ∈ 2⁻⁷ℤ`, so the point
values of the own-potential tower need `cos φ_c`, `sin φ_c` exactly at `π j / 128`.  This module
checks once, by a kernel `decide`, a packed table of the 33 base values (`j ≤ 32`, `2⁻¹²⁸`
fixed point, slot width 132 bits, `TCT`/`TST`), against the order-`NT` Taylor polynomial of
`exp (i x)` at `x = j π₄ / 32` (`π₄ = PI4`, the Machin value of `π/4` of `LogEval`) with the
`Complex.exp_bound` remainder and the error `PI4E` of `π₄`.  The other `j ≤ 128` follow by the
reflections `cos (π/2 - y) = sin y`, `cos (π - y) = - cos y`.

* `trigChk_all`: the one kernel check;
* `trig_enc`: for every `j ≤ 128`, `Enc (cos (π j / 128)) (cosT j, trigE)` and the same for `sin`,
  with `trigE = 2⁻¹²⁴`.
-/

namespace CatalanCore.Lai.DecayTrig

open CatalanMeasure.GenD.Signed.LogEval
open CatalanMeasure.Cert (qabs qabs_eq)

noncomputable section

/-! ### 1. The packed table (generated by `gen_trig.py`, mpmath at 600 bits) -/

def TCT : ℕ := 

def TST : ℕ := 

/-- `cos (π j / 128)` at scale `2⁻¹²⁸`, `j ≤ 32` (slot `j` of `TCT`). -/
def cosB (j : ℕ) : ℚ := (((TCT >>> (132 * j)) % 2 ^ 132 : ℕ) : ℚ) / 2 ^ 128

/-- `sin (π j / 128)` at scale `2⁻¹²⁸`, `j ≤ 32` (slot `j` of `TST`). -/
def sinB (j : ℕ) : ℚ := (((TST >>> (132 * j)) % 2 ^ 132 : ℕ) : ℚ) / 2 ^ 128

/-! ### 2. Taylor polynomials of `exp (i x)` by a term recurrence -/

/-- The partial sum `(sr, si)` and the next term `(tr, ti)` of `Σ (i x)^m / m!`, real and imaginary
parts. -/
structure ExpSt where
  sr : ℚ
  si : ℚ
  tr : ℚ
  ti : ℚ

/-- After `n` steps: the sum of the first `n` terms and the `n`-th term. -/
def expSt (x : ℚ) : ℕ → ExpSt
  | 0 => ⟨0, 0, 1, 0⟩
  | n + 1 =>
    match expSt x n with
    | ⟨a, b, c, d⟩ => ⟨a + c, b + d, -(d * x) / ((n + 1 : ℕ) : ℚ), (c * x) / ((n + 1 : ℕ) : ℚ)⟩

def toC (a b : ℚ) : ℂ := (a : ℂ) + (b : ℂ) * Complex.I

theorem expSt_spec (x : ℚ) : ∀ n : ℕ,
    toC (expSt x n).sr (expSt x n).si =
        ∑ m ∈ Finset.range n, (((x : ℂ) * Complex.I) ^ m / (m.factorial : ℂ)) ∧
      toC (expSt x n).tr (expSt x n).ti = ((x : ℂ) * Complex.I) ^ n / (n.factorial : ℂ) := by
  intro n
  induction n with
  | zero => simp [expSt, toC]
  | succ n ih =>
    obtain ⟨h1, h2⟩ := ih
    have hn : ((n + 1 : ℕ) : ℂ) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero n
    constructor
    · rw [Finset.sum_range_succ, ← h1, ← h2]
      simp only [expSt, toC]
      push_cast
      ring
    · have e : toC (-((expSt x n).ti * x) / ((n + 1 : ℕ) : ℚ)) ((expSt x n).tr * x / ((n + 1 : ℕ) : ℚ)) =
          toC (expSt x n).tr (expSt x n).ti * ((x : ℂ) * Complex.I) / ((n + 1 : ℕ) : ℂ) := by
        unfold toC
        push_cast
        field_simp
        ring_nf
        rw [Complex.I_sq]
        ring
      simp only [expSt]
      rw [e, h2, pow_succ, Nat.factorial_succ]
      push_cast
      field_simp

/-- The remainder bound `|x|^n (n+1) / (n! n)` of `Complex.exp_bound`. -/
def remQ (n : ℕ) (x : ℚ) : ℚ := qabs x ^ n * (((n + 1 : ℕ) : ℚ) / ((n.factorial : ℚ) * (n : ℚ)))

theorem taylor_cos_sin {x : ℚ} (hx : qabs x ≤ 1) {n : ℕ} (hn : 0 < n) :
    |Real.cos (x : ℝ) - ((expSt x n).sr : ℝ)| ≤ (remQ n x : ℝ) ∧
      |Real.sin (x : ℝ) - ((expSt x n).si : ℝ)| ≤ (remQ n x : ℝ) := by
  set z : ℂ := ((x : ℂ)) * Complex.I with hz
  have hzn : ‖z‖ = |(x : ℝ)| := by
    rw [hz, norm_mul, Complex.norm_I, mul_one]
    rw [show (x : ℂ) = ((x : ℝ) : ℂ) by simp, Complex.norm_real, Real.norm_eq_abs]
  have hxabs : |(x : ℝ)| = ((qabs x : ℚ) : ℝ) := by
    rw [qabs_eq]; push_cast; rfl
  have hz1 : ‖z‖ ≤ 1 := by
    rw [hzn, hxabs]; exact_mod_cast hx
  have hb := Complex.exp_bound hz1 hn
  obtain ⟨hs, -⟩ := expSt_spec x n
  rw [← hs] at hb
  have hexp : Complex.exp z = (Complex.exp (((x : ℝ) : ℂ) * Complex.I)) := by
    rw [hz]; simp
  have hrem : ‖z‖ ^ n * (((n.succ : ℕ) : ℝ) * ((n.factorial : ℝ) * (n : ℝ))⁻¹) = (remQ n x : ℝ) := by
    rw [hzn, hxabs]
    unfold remQ
    push_cast
    rw [div_eq_mul_inv]
  rw [hrem] at hb
  have hre : Complex.exp z - toC (expSt x n).sr (expSt x n).si =
      (Complex.exp z - toC (expSt x n).sr (expSt x n).si) := rfl
  constructor
  · have := Complex.abs_re_le_norm (Complex.exp z - toC (expSt x n).sr (expSt x n).si)
    have h2 : (Complex.exp z - toC (expSt x n).sr (expSt x n).si).re =
        Real.cos (x : ℝ) - ((expSt x n).sr : ℝ) := by
      rw [Complex.sub_re, hexp, Complex.exp_ofReal_mul_I_re]
      simp [toC]
    rw [h2] at this
    exact this.trans hb
  · have := Complex.abs_im_le_norm (Complex.exp z - toC (expSt x n).sr (expSt x n).si)
    have h2 : (Complex.exp z - toC (expSt x n).sr (expSt x n).si).im =
        Real.sin (x : ℝ) - ((expSt x n).si : ℝ) := by
      rw [Complex.sub_im, hexp, Complex.exp_ofReal_mul_I_im]
      simp [toC]
    rw [h2] at this
    exact this.trans hb

/-! ### 3. The check, run once -/

/-- Order of the Taylor polynomial. -/
def NT : ℕ := 40

/-- Total error budget of a table entry, `2⁻¹²⁴`. -/
def trigE : ℚ := 1 / 2 ^ 124

/-- The argument `π j / 128 = (j / 32) (π / 4)` with `π / 4` replaced by `PI4`. -/
def trigX (j : ℕ) : ℚ := (j : ℚ) * PI4 / 32

/-- The check of base entry `j`: the argument is at most `1`, and the table entry is within
`trigE` of `cos` and of `sin` by the Taylor polynomial, its remainder and the error of `PI4`. -/
def trigChk (j : ℕ) : Bool :=
  decide (j ≤ 32) && decide (qabs (trigX j) ≤ 1) &&
    decide (qabs (cosB j - (expSt (trigX j) NT).sr) + remQ NT (trigX j) + PI4E ≤ trigE) &&
    decide (qabs (sinB j - (expSt (trigX j) NT).si) + remQ NT (trigX j) + PI4E ≤ trigE)

-- kcost: 3.0 s measured (type checking of this declaration alone, 33 entries, `Elab.async false`)
theorem trigChk_all : ∀ j < 33, trigChk j = true := by decide +kernel

/-! ### 4. Soundness -/

theorem base_enc {j : ℕ} (hj : j ≤ 32) :
    Enc (Real.cos (Real.pi * (j : ℝ) / 128)) (cosB j, trigE) ∧
      Enc (Real.sin (Real.pi * (j : ℝ) / 128)) (sinB j, trigE) := by
  have hc := trigChk_all j (by omega)
  simp only [trigChk, Bool.and_eq_true, decide_eq_true_eq] at hc
  obtain ⟨⟨⟨-, hx⟩, hC⟩, hS⟩ := hc
  obtain ⟨h1, h2⟩ := taylor_cos_sin hx (n := NT) (by decide)
  have hpi := pi4_spec
  -- the argument error
  have hj' : (j : ℝ) ≤ 32 := by exact_mod_cast hj
  have hj0 : (0 : ℝ) ≤ j := Nat.cast_nonneg j
  have hu : |Real.pi * (j : ℝ) / 128 - (trigX j : ℝ)| ≤ (PI4E : ℝ) := by
    have e : Real.pi * (j : ℝ) / 128 - (trigX j : ℝ) =
        ((j : ℝ) / 32) * (Real.pi / 4 - (PI4 : ℝ)) := by
      unfold trigX; push_cast; ring
    rw [e, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (j : ℝ) / 32)]
    calc (j : ℝ) / 32 * |Real.pi / 4 - (PI4 : ℝ)| ≤ 1 * |Real.pi / 4 - (PI4 : ℝ)| :=
          mul_le_mul_of_nonneg_right (by linarith) (abs_nonneg _)
      _ ≤ _ := by rw [one_mul]; exact hpi
  have hcl := Real.abs_cos_sub_cos_le (Real.pi * (j : ℝ) / 128) (trigX j : ℝ)
  have hsl := Real.abs_sin_sub_sin_le (Real.pi * (j : ℝ) / 128) (trigX j : ℝ)
  have hC' : |(cosB j : ℝ) - ((expSt (trigX j) NT).sr : ℝ)| +
      (remQ NT (trigX j) : ℝ) + (PI4E : ℝ) ≤ (trigE : ℝ) := by
    have := (Rat.cast_le (K := ℝ)).2 hC
    rw [qabs_eq] at this
    push_cast at this ⊢
    exact this
  have hS' : |(sinB j : ℝ) - ((expSt (trigX j) NT).si : ℝ)| +
      (remQ NT (trigX j) : ℝ) + (PI4E : ℝ) ≤ (trigE : ℝ) := by
    have := (Rat.cast_le (K := ℝ)).2 hS
    rw [qabs_eq] at this
    push_cast at this ⊢
    exact this
  constructor
  · unfold Enc
    simp only
    have t1 : |Real.cos (Real.pi * (j : ℝ) / 128) - (cosB j : ℝ)| ≤
        |Real.cos (Real.pi * (j : ℝ) / 128) - Real.cos (trigX j : ℝ)| +
        |Real.cos (trigX j : ℝ) - ((expSt (trigX j) NT).sr : ℝ)| +
        |((expSt (trigX j) NT).sr : ℝ) - (cosB j : ℝ)| := by
      have := abs_add_three (Real.cos (Real.pi * (j : ℝ) / 128) - Real.cos (trigX j : ℝ))
        (Real.cos (trigX j : ℝ) - ((expSt (trigX j) NT).sr : ℝ))
        (((expSt (trigX j) NT).sr : ℝ) - (cosB j : ℝ))
      convert this using 2; ring
    have t2 : |((expSt (trigX j) NT).sr : ℝ) - (cosB j : ℝ)| =
        |(cosB j : ℝ) - ((expSt (trigX j) NT).sr : ℝ)| := abs_sub_comm _ _
    linarith
  · unfold Enc
    simp only
    have t1 : |Real.sin (Real.pi * (j : ℝ) / 128) - (sinB j : ℝ)| ≤
        |Real.sin (Real.pi * (j : ℝ) / 128) - Real.sin (trigX j : ℝ)| +
        |Real.sin (trigX j : ℝ) - ((expSt (trigX j) NT).si : ℝ)| +
        |((expSt (trigX j) NT).si : ℝ) - (sinB j : ℝ)| := by
      have := abs_add_three (Real.sin (Real.pi * (j : ℝ) / 128) - Real.sin (trigX j : ℝ))
        (Real.sin (trigX j : ℝ) - ((expSt (trigX j) NT).si : ℝ))
        (((expSt (trigX j) NT).si : ℝ) - (sinB j : ℝ))
      convert this using 2; ring
    have t2 : |((expSt (trigX j) NT).si : ℝ) - (sinB j : ℝ)| =
        |(sinB j : ℝ) - ((expSt (trigX j) NT).si : ℝ)| := abs_sub_comm _ _
    linarith

/-! ### 5. The full table `j ≤ 128` by reflection -/

/-- `cos (π j / 128)`, `j ≤ 128`. -/
def cosT (j : ℕ) : ℚ :=
  if j ≤ 32 then cosB j else if j ≤ 64 then sinB (64 - j)
  else if j ≤ 96 then -sinB (j - 64) else -cosB (128 - j)

/-- `sin (π j / 128)`, `j ≤ 128`. -/
def sinT (j : ℕ) : ℚ :=
  if j ≤ 32 then sinB j else if j ≤ 64 then cosB (64 - j)
  else if j ≤ 96 then cosB (j - 64) else sinB (128 - j)

theorem Enc_neg {x : ℝ} {v e : ℚ} (h : Enc x (v, e)) : Enc (-x) (-v, e) := by
  unfold Enc at *
  push_cast
  rw [show -x - -(v : ℝ) = -(x - v) by ring, abs_neg]
  exact h

/-- **LD20.**  Rational enclosures of `cos (π j / 128)` and `sin (π j / 128)` for all `j ≤ 128`,
with the error `trigE = 2⁻¹²⁴`. -/
theorem trig_enc {j : ℕ} (hj : j ≤ 128) :
    Enc (Real.cos (Real.pi * (j : ℝ) / 128)) (cosT j, trigE) ∧
      Enc (Real.sin (Real.pi * (j : ℝ) / 128)) (sinT j, trigE) := by
  unfold cosT sinT
  by_cases h1 : j ≤ 32
  · simp only [h1, if_true]; exact base_enc h1
  by_cases h2 : j ≤ 64
  · simp only [h1, h2, if_true, if_false]
    obtain ⟨hc, hs⟩ := base_enc (j := 64 - j) (by omega)
    have e : Real.pi * (j : ℝ) / 128 = Real.pi / 2 - Real.pi * ((64 - j : ℕ) : ℝ) / 128 := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, Real.cos_pi_div_two_sub, Real.sin_pi_div_two_sub]
    exact ⟨hs, hc⟩
  by_cases h3 : j ≤ 96
  · simp only [h1, h2, h3, if_true, if_false]
    obtain ⟨hc, hs⟩ := base_enc (j := j - 64) (by omega)
    have e : Real.pi * (j : ℝ) / 128 = Real.pi * ((j - 64 : ℕ) : ℝ) / 128 + Real.pi / 2 := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, Real.cos_add_pi_div_two, Real.sin_add_pi_div_two]
    exact ⟨Enc_neg hs, hc⟩
  · simp only [h1, h2, h3, if_false]
    obtain ⟨hc, hs⟩ := base_enc (j := 128 - j) (by omega)
    have e : Real.pi * (j : ℝ) / 128 = Real.pi - Real.pi * ((128 - j : ℕ) : ℝ) / 128 := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, Real.cos_pi_sub, Real.sin_pi_sub]
    exact ⟨Enc_neg hc, hs⟩

/-! ### 6. Every multiple of `π / 128`, by the period `2π` -/

/-- `cos (π m / 128)` for every `m : ℕ`. -/
def cosTm (m : ℕ) : ℚ := if m % 256 ≤ 128 then cosT (m % 256) else cosT (256 - m % 256)

/-- `sin (π m / 128)` for every `m : ℕ`. -/
def sinTm (m : ℕ) : ℚ := if m % 256 ≤ 128 then sinT (m % 256) else -sinT (256 - m % 256)

theorem trig_enc_nat (m : ℕ) :
    Enc (Real.cos (Real.pi * (m : ℝ) / 128)) (cosTm m, trigE) ∧
      Enc (Real.sin (Real.pi * (m : ℝ) / 128)) (sinTm m, trigE) := by
  have hm : (m : ℝ) = 256 * ((m / 256 : ℕ) : ℝ) + ((m % 256 : ℕ) : ℝ) := by
    exact_mod_cast (Nat.div_add_mod m 256).symm
  have e : Real.pi * (m : ℝ) / 128 =
      Real.pi * ((m % 256 : ℕ) : ℝ) / 128 + ((m / 256 : ℕ) : ℝ) * (2 * Real.pi) := by
    rw [hm]; ring
  have hr : m % 256 < 256 := Nat.mod_lt _ (by norm_num)
  by_cases h : m % 256 ≤ 128
  · unfold cosTm sinTm
    simp only [h, if_true]
    rw [e, Real.cos_add_nat_mul_two_pi, Real.sin_add_nat_mul_two_pi]
    exact trig_enc h
  · unfold cosTm sinTm
    simp only [h, if_false]
    obtain ⟨hc, hs⟩ := trig_enc (j := 256 - m % 256) (by omega)
    have e2 : Real.pi * ((m % 256 : ℕ) : ℝ) / 128 =
        2 * Real.pi - Real.pi * ((256 - m % 256 : ℕ) : ℝ) / 128 := by
      rw [Nat.cast_sub (by omega)]; push_cast; ring
    rw [e, e2, Real.cos_add_nat_mul_two_pi, Real.sin_add_nat_mul_two_pi, Real.cos_two_pi_sub,
      Real.sin_two_pi_sub]
    exact ⟨hc, Enc_neg hs⟩

end

end CatalanCore.Lai.DecayTrig
