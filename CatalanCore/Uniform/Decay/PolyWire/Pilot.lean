def lineTab : List TCell := [⟨0, 1 / 1024, .pt⟩, lineL1]
def lineBad : TCell := match lineL1.kind with
  | .jet lo C Fs => ⟨1 / 16, 3 / 32, .jet (lo + 2) C Fs⟩
  | k => ⟨1 / 16, 3 / 32, k⟩
def endpointCell : TCell := ⟨0, (1 / 1677721600 : ℚ) / (787 / 10000), .pt⟩
def tubeTab : List ((Pt × Pt) × List TCell) := [(edge0, [endpointCell, tubeWide, tubeA])]

theorem line_ok : lineOkT nuP 8 4 50 51 lineTab sevData (1 / 16, 3 / 32) = true := by decide +kernel
theorem line_bad_lo : lineOkT nuP 8 4 50 51 [lineBad] sevData (1 / 16, 3 / 32) = false := by
  decide +kernel
theorem line_no_key : lineOkT nuP 8 4 50 51 lineTab sevData (1 / 8, 3 / 16) = false := by
  decide +kernel

theorem tube_A_ok : segNearT nuP 8 4 50 51 tubeTab sevData edge0 (tubeA.ulo, tubeA.uhi) = true := by
  decide +kernel
theorem tube_wide_ok :
    segNearT nuP 8 4 50 51 tubeTab sevData edge0 (tubeWide.ulo, tubeWide.uhi) = true := by
  decide +kernel
theorem tube_endpoint_fails :
    segNearT nuP 8 4 50 51 tubeTab sevData edge0 (endpointCell.ulo, endpointCell.uhi) = false := by
  decide +kernel
theorem tube_wrong_edge :
    segNearT nuP 8 4 50 51 tubeTab sevData ((0, 0), (1, 1)) (tubeA.ulo, tubeA.uhi) = false := by
  decide +kernel

end CatalanCore.Uniform.Decay.PolyWire.Pilot
