import CatalanCore.Uniform.Decay.PolyWire.Top
import CatalanCore.Uniform.Decay.PolyWire.PilotData
set_option Elab.async false
set_option maxRecDepth 100000
set_option profiler true
set_option profiler.threshold 50

/-!
# Pilot (lane D, package D11): the table glue on real cells

Sevenths trial `sevData`, node measure `RP = CP = [(1,0,1), (1/2,1,7/6)]` (`nodeSegs`, four half
segments).  Cell data (`lo`, aggregate `C`, `Fs`) are untrusted, generated by `PilotData.lean`; the
kernel re-runs `aggEval`/`aggEvalM` through `lineOkT`, `segNearT`, `farDataOk`.
Positive checks and negative controls (tampered bound, missing key, wrong edge, a cell that genuinely
fails: the endpoint cell at the base point, whose `ptOk` loses 5e-6 against a slack of 2e-6).
-/

namespace CatalanCore.Uniform.Decay.PolyWire.Pilot

open CatalanCore.Uniform.Decay.Cert CatalanCore.Uniform.Decay.Cert.Pilot
  CatalanCore.Uniform.Decay.NearCells CatalanCore.Uniform.Decay.NearCells.Pilot
  CatalanCore.Uniform.Decay.PolyCells CatalanCore.Uniform.Decay.Cells

/-! Far data -/
def farP : FarData := ⟨13 / 12 * (2 + 7 / 6), 4⟩

theorem far_ok : farDataOk farP (7 / 6) pieces0 pieces0 sevData = true := by decide +kernel
theorem far_bad_M1 : farDataOk ⟨1, 4⟩ (7 / 6) pieces0 pieces0 sevData = false := by decide +kernel
theorem far_bad_piece : farDataOk farP (7 / 6) [(-1, 0, 1)] pieces0 sevData = false := by
  decide +kernel
theorem far_bad_Rn : farDataOk farP (1 : ℚ) pieces0 pieces0 sevData = false := by decide +kernel

