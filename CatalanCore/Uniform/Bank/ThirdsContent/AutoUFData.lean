theorem uf_params : checkParams ufData = true := by decide +kernel

set_option profiler true in
theorem uf_classes : ufData.members.all (classOK ufData) = true := by decide +kernel

theorem uf_tmpls : ufData.tmpls.all (fun x => tmplOK ufData x.1 x.2) = true := by
  show [(1, ufT1), (2, ufT2)].all (fun x => tmplOK ufData x.1 x.2) = true
  simp only [List.all_cons, List.all_nil, ufT1_ok, ufT2_ok, Bool.and_self]

/-- **The bank check accepts the thirds UF data.** -/
theorem uf_check : check ufData = true := by
  unfold check
  rw [uf_params, uf_tmpls, uf_classes]
  rfl

