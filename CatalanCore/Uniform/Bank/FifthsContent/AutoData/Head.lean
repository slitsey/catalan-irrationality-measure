/-! # Data header: the fifths bank parameters (lane C1L)

Generated by `scripts/claude/bank/check/emit_bank_uf.py fifths`.  The header bank `bankHead` carries the parameters
of the fifths UF bank (`P_bad = 9`, `c_Fr ≤ 49`, depth `≤ 64`, catalogue
`tableT ++ [LP1, LP2w, R, S] ++ windows ++ prefixes`) with `Λ := 0` and no templates; the per-class modules `U<j>` check their
template against it, and `AutoData` assembles the bank (`Check.Split`). -/

namespace CatalanCore.Uniform.Bank.FifthsContent.Auto
open CatalanCore.Uniform.Content.BankShared.Check

/-- `n / d`. -/
abbrev qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

/-- The M3D windows of the catalogue. -/
def bankWins : List (ℕ × ℕ) := [(5, 5), (5, 6), (6, 6), (6, 7), (7, 7), (7, 8), (8, 8), (8, 9), (9, 9), (9, 10)]

/-- The prefix branches `brPre n j0 j1` (`1 ≤ n ≤ 8`, `j0 < 2`, `j1 < 3`). -/
def bankPres : List (ℕ × ℕ × ℕ) := [(1, 0, 0), (1, 0, 1), (1, 0, 2), (1, 1, 0), (1, 1, 1), (1, 1, 2), (2, 0, 0), (2, 0, 1), (2, 0, 2), (2, 1, 0), (2, 1, 1), (2, 1, 2), (3, 0, 0), (3, 0, 1), (3, 0, 2), (3, 1, 0), (3, 1, 1), (3, 1, 2), (4, 0, 0), (4, 0, 1), (4, 0, 2), (4, 1, 0), (4, 1, 1), (4, 1, 2), (5, 0, 0), (5, 0, 1), (5, 0, 2), (5, 1, 0), (5, 1, 1), (5, 1, 2), (6, 0, 0), (6, 0, 1), (6, 0, 2), (6, 1, 0), (6, 1, 1), (6, 1, 2), (7, 0, 0), (7, 0, 1), (7, 0, 2), (7, 1, 0), (7, 1, 1), (7, 1, 2), (8, 0, 0), (8, 0, 1), (8, 0, 2), (8, 1, 0), (8, 1, 1), (8, 1, 2)]

/-- LP1, LP2w, the rank branch, the UF branch (indices 6, 7, 8, 9), the M3D windows, then the prefix branches. -/
def bankExtra : List Branch :=
  ([brLP1, brLP2w, brRank, brS] ++ bankWins.map (fun w => brWin w.1 w.2)) ++
    bankPres.map (fun x => brPre x.1 x.2.1 x.2.2)

/-- The fifths bank parameters, without templates. -/
def bankHead : BankData where
  q := 5
  M := 10
  α := qq 1 9
  members := [1, 2, 3, 4]
  depth := 64
  cF := 49
  Pbad := 9
  α0 := qq 20 9
  τ := qq 64 9
  Λ := 0
  α0b := qq 20 9
  t0 := qq 1 900
  extra := bankExtra
  tmpls := []

end CatalanCore.Uniform.Bank.FifthsContent.Auto
