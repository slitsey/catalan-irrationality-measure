/-- The sevenths bank parameters, without templates. -/
def bankHead : BankData where
  q := 7
  M := 14
  α := qq 1 12
  members := [1, 2, 3, 4, 5, 6]
  depth := 64
  cF := 81
  Pbad := 13
  α0 := qq 13 6
  τ := qq 55 6
  Λ := 0
  α0b := qq 13 6
  t0 := qq 1 1000
  extra := bankExtra
  tmpls := []

end CatalanCore.Uniform.Bank.SeventhsContent.Auto
