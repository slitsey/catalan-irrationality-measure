/-- `n / d`. -/
abbrev qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

open KExpr in
/-- `min (k_A, k_B)`: the first singular index. -/
def kKq : KExpr := mn (vk 0) (vk 1)
open KExpr in
def kSv0 : KExpr :=
  add (add (tsub (mn kKq vr) (tsub vr vp)) (tsub (mn kKq vr) (tsub kN vp))) (tsub (mn kKq kN) (mx (tsub kN vp) vr))
open KExpr in
def kSv1 : KExpr := add kSv0 (tsub (mn vp kN) (mx (mx (vk 1) (tsub kN vp)) vr))
open KExpr in
def k2rm : KExpr := add (smul 2 vr) (smul 2 vm)

open KExpr in
/-- `2 (r + m)`. -/
def kD1 : KBranch := ⟨smul 2 (add vr vm), [], 0⟩
open KExpr in
/-- `2 r + 2 m - δ_p(m)`. -/
def kD1x : KBranch := ⟨tsub k2rm (dist vm), [], 0⟩
open KExpr in
/-- `Z0`: `2 r + 2 m - Sv₀`, `N ≤ 2 p`. -/
def kZ0 : KBranch := ⟨tsub k2rm kSv0, [⟨-1, 2, -2, [0, 0], 0, false⟩], 0⟩
open KExpr in
/-- `Z1`: `2 r + 2 m - Sv`, `N ≤ 2 p`, `k_A < k_B`. -/
def kZ1 : KBranch := ⟨tsub k2rm kSv1, [⟨-1, 2, -2, [0, 0], 0, false⟩, ⟨0, 0, 0, [-1, 1], -1, false⟩], 0⟩
open KExpr in
/-- `T0`: price `0` on `N < k_A`, `N < k_B` (the tail branch). -/
def kT0 : KBranch := ⟨cst 0, [⟨-1, 0, -2, [1, 0], 0, true⟩, ⟨-1, 0, -2, [0, 1], 0, true⟩], 0⟩

