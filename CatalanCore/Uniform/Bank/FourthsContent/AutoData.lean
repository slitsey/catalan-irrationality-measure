namespace CatalanCore.Uniform.Bank.FourthsContent.Auto
open CatalanCore.Uniform.Content.BankShared.Check

/-- The lambda UF bank data, with its finite `Λ_fin`. -/
def bankData : BankData := { bankHead with Λ := qq 16340825303276011738352586635878514341739783226417418262556570454093350959250470042769562541251916857459325347250219918386848697695083800637652731062440069512019717509595479112763 4647527398802197647901624957547417250486988566742154187845244937254087659145214486757150040664470442993534152032780141338554455225157488689939861885442235340102863073521298440000, tmpls := [(1, tmpl1), (3, tmpl3)] }

theorem tmpl1_okD : tmplOK bankData 1 tmpl1 = true :=
  tmplOK_withTmpls bankHead _ _ 1 tmpl1 tmpl1_ok

theorem tmpl3_okD : tmplOK bankData 3 tmpl3 = true :=
