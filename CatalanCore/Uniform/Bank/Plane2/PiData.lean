module

public import CatalanCore.Uniform.Bank.Plane2.PiData.U1

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Data: the halves UF bank for the bank check (lane C1L)

Generated by `scripts/claude/bank/check/emit_bank_uf.py halves`: the header `bankHead` (`AutoData/Head`) with the
templates of `AutoData/U<j>` and the finite content constant `Λ_fin` (prefix truncation `n = 74`).  The template
checks transport from `bankHead` (`tmplOK_withTmpls`); `bank_check : check bankData = true`. -/

namespace CatalanCore.Uniform.Bank.Plane2.PiAuto
open CatalanCore.Uniform.Content.BankShared.Check

/-- The halves UF bank data, with its finite `Λ_fin`. -/
def bankData : BankData := { bankHead with Λ := qq 624556468815374214606450196134703246952690796943073816522336951 239310612648665975034127866251330453760983309262702361452984000, tmpls := [(1, tmpl1)] }

theorem tmpl1_okD : tmplOK bankData 1 tmpl1 = true :=
  tmplOK_withTmpls bankHead _ _ 1 tmpl1 tmpl1_ok

/-- The catalogue of `bankData` in the shape of `catValid_bankUFwP`. -/
theorem bankData_cat : bankData.cat = tableT ++ ([brLP1, brLP2w, brRank, brS] ++
    bankWins.map (fun w => brWin w.1 w.2)) ++ bankPres.map (fun x => brPre x.1 x.2.1 x.2.2) :=
  (List.append_assoc _ _ _).symm

set_option profiler true in
theorem bank_params : checkParams bankData = true := by decide +kernel

set_option profiler true in
theorem bank_classes : bankData.members.all (classOK bankData) = true := by decide +kernel

theorem bank_tmpls : bankData.tmpls.all (fun x => tmplOK bankData x.1 x.2) = true := by
  show [(1, tmpl1)].all (fun x => tmplOK bankData x.1 x.2) = true
  simp only [List.all_cons, List.all_nil, tmpl1_okD, Bool.and_self]

/-- **The bank check accepts the halves UF data.** -/
theorem bank_check : check bankData = true := by
  unfold check
  rw [bank_params, bank_tmpls, bank_classes]
  rfl

/-- The finite content constant. -/
theorem bankData_Λ : bankData.Λ = (624556468815374214606450196134703246952690796943073816522336951 /
    239310612648665975034127866251330453760983309262702361452984000 : ℚ) := by
  decide +kernel

end CatalanCore.Uniform.Bank.Plane2.PiAuto
