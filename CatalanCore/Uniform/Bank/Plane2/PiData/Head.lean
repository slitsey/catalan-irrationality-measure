/-! # Data header: the halves bank parameters (lane C1L)

Generated by `scripts/claude/bank/check/emit_bank_uf.py halves`.  The header bank `bankHead` carries the parameters
of the halves UF bank (`P_bad = 4`, `c_Fr ≤ 16`, depth `≤ 64`, catalogue
`tableT ++ [LP1, LP2w, R, S] ++ windows ++ prefixes`) with `Λ := 0` and no templates; the per-class modules `U<j>` check their
template against it, and `AutoData` assembles the bank (`Check.Split`). -/

namespace CatalanCore.Uniform.Bank.Plane2.PiAuto
open CatalanCore.Uniform.Content.BankShared.Check

/-- `n / d`. -/
abbrev qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

/-- The M3D windows of the catalogue. -/
def bankWins : List (ℕ × ℕ) := [(7, 7), (7, 8), (8, 8), (8, 9), (9, 9), (9, 10), (10, 10), (10, 11), (11, 11), (11, 12), (12, 12), (12, 13), (13, 13), (13, 14), (14, 14), (14, 15)]

/-- The prefix branches `brPre n j0 j1` (`1 ≤ n ≤ 0`, `j0 < 2`, `j1 < 3`). -/
def bankPres : List (ℕ × ℕ × ℕ) := []

/-- LP1, LP2w, the rank branch, the UF branch (indices 6, 7, 8, 9), the M3D windows, then the prefix branches. -/
def bankExtra : List Branch :=
  ([brLP1, brLP2w, brRank, brS] ++ bankWins.map (fun w => brWin w.1 w.2)) ++
    bankPres.map (fun x => brPre x.1 x.2.1 x.2.2)

/-- The halves bank parameters, without templates. -/
def bankHead : BankData where
  q := 2
  M := 2
  α := qq 3 41
  members := [1]
  depth := 64
  cF := 16
  Pbad := 4
  α0 := qq 11 5
  τ := qq 135 41
  Λ := 0
  α0b := qq 11 5
  t0 := qq 1 1000
  extra := bankExtra
  tmpls := []

end CatalanCore.Uniform.Bank.Plane2.PiAuto
