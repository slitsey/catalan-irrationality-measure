module

public import CatalanCore.Uniform.Bank.Plane2.Content.Union
public import CatalanCore.Uniform.Content.BankShared.KTerm.Periodic

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Plane 2 content, closed form: common header (wave P210-L; ledger P210)

`p2H`: the header bank of the closed plane 2 content at `α = 3/41` (`c = 6/41`): `Q = M = 2`, `a = 1`, the single shift
`(2, 1, 1)` (`k₀ = (p+1)/2`), depth `64`, `c_F = 18`, `P_bad = 6`, `α₀ = α₀ᵇ = 132/41 = 3 + 3 α`, `t₀ = t₁`, `τ`, `R_t = 12`, the
catalogue `headList ++ brU56 :: p2kb` (`brTail` is the tail branch, index `4`); `Λ` is the value of the bank. -/

namespace CatalanCore.Uniform.Bank.Plane2.Content.Data
open CatalanCore.Uniform.Content.BankShared.KTerm CatalanCore.Uniform.Content.BankShared.Check CatalanCore.Uniform.Bank.Plane2.Content

/-- `n / d`. -/
abbrev qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

/-- The base catalogue (plain row and the bands `1 .. 6`), the one that is translated. -/
def p2kb : List KBranch := bandList 0 6

/-- The header bank (no templates). -/
def p2H : KBankData where
  Q := 2
  M := 2
  α := qq 3 41
  a := 1
  shifts := [⟨2, 1, 1⟩]
  depth := 64
  cF := 18
  Pbad := 6
  α0 := qq 132 41
  τ := (qq (417) 164)
  Λ := (qq () )
  α0b := qq 132 41
  t0 := (qq (3000000) 1025000003)
  Rt := (qq (12) 1)
  kcat := headList ++ brU56 :: p2kb
  tmpls := []

end CatalanCore.Uniform.Bank.Plane2.Content.Data
