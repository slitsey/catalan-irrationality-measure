module

public import CatalanCore.Uniform.Bank.Plane2.Content.Data.Table
public import CatalanCore.Uniform.Bank.Plane2.Content.Data.HeadAll

@[expose] public section
set_option Elab.async false
set_option maxRecDepth 100000

/-! # Plane 2 content, closed form: the bank (wave P210-L; ledger P210)

`p2T`: the periodic template (table `p2cells`, 8 strips and the 48 lowest-`u` cells of strip 8, head `p2head`,
tail branch `4`); `p2D`: the bank, `Λ = 3.476837530533`.  The facts for `hasScaledContent_of_periodic_ok`: `KParams`,
`ktmplHead` (chain of the expansion, its end `2 α - δ'`, chain of the head, tail test, `τ`), `kclassOK` (mass). -/

namespace CatalanCore.Uniform.Bank.Plane2.Content.Data
open CatalanCore.Uniform.Content.BankShared.KTerm CatalanCore.Uniform.Content.BankShared.Check CatalanCore.Uniform.Bank.Plane2.Content

def p2T : KTmplP := ⟨(qq (3000000) 1025000003), 8, 48, p2cells, p2head, 4⟩

def p2D : KBankData := { p2H with tmpls := [(1, p2T.toK 41 132 18)] }

theorem p2_chain : chainOK p2T.t1 (p2T.expP 41 132 18) = true := by
  -- kcost: 5.4 s measured, 2256 expansion pieces
  decide +kernel

theorem p2_end : tendQ p2T.t1 (p2T.expP 41 132 18) = (qq (3000000) 20500003) := by
  -- kcost: 0.05 s measured, list walk
  decide +kernel

theorem p2_hchain : chainOK (qq (3000000) 20500003) p2T.head = true := by
  -- kcost: 0.05 s measured, 44 pieces
  decide +kernel

theorem p2_hend : tendQ (qq (3000000) 20500003) p2T.head = (qq (417) 164) := by
  -- kcost: 0.05 s measured, list walk
  decide +kernel

theorem p2_tail : tailOK p2D 1 (qq (417) 164) 4 = true := by
  -- kcost: 0.05 s measured, one branch
  decide +kernel

theorem p2_expmass : ((p2T.expP 41 132 18).map (fun x => x.1.mass)).sum = (qq () ) := by
  -- kcost: 12.3 s measured, 2256 piece masses summed exactly
  decide +kernel

theorem p2_headmass : (p2T.head.map (fun x => x.1.mass)).sum = (qq (2557381497889580989789052354922331723) 849081133078713632455930000389420460) := by
  -- kcost: 0.16 s measured, 44 piece masses
  decide +kernel

theorem p2_params : KParams p2D := kparams_of (by decide +kernel)

theorem p2_t1pos : 0 < p2T.t1 := by
  -- kcost: 0.01 s measured (one rational comparison)
  decide +kernel

theorem p2_t1le : p2T.t1 ≤ p2D.t0 := by
  -- kcost: 0.01 s measured (one rational comparison)
  decide +kernel

theorem p2_shifts : p2D.shifts.all (fun x => decide (x.s * 1 % x.q ≠ 0)) = true := by
  -- kcost: 0.01 s measured (one shift)
  decide +kernel

theorem p2_tau : tendQ (qq (3000000) 20500003) p2T.head ≤ p2D.τ := by
  -- kcost: 0.01 s measured (one rational comparison)
  rw [p2_hend]
  decide +kernel

theorem p2_head : ktmplHead p2D 1 (p2T.toK 41 132 18) = true :=
  ktmplHead_toKP_of (e0 := (qq (3000000) 20500003)) p2_t1pos p2_t1le p2_chain p2_end p2_hchain p2_shifts
    (by rw [p2_hend]; exact p2_tail) p2_tau

theorem p2_mass : (p2T.toK 41 132 18).toQ.mass p2D.α0 = p2D.Λ := by
  rw [KTmplP.mass_toK, p2_expmass, p2_headmass]
  -- kcost: 0.06 s measured (one rational equation with 3500-digit numerals)
  decide +kernel

theorem p2_class : kclassOK p2D = true :=
  kclassOK_two p2D rfl rfl rfl (T1 := p2T.toK 41 132 18) (by simp [p2D, findK]) p2_mass

theorem p2_heads : ∀ x ∈ p2D.tmpls, ktmplHead p2D x.1 x.2 = true := by
  intro x hx
  simp only [p2D, List.mem_singleton] at hx
  subst hx
  exact p2_head

theorem p2_cells : ∀ y ∈ p2T.cells, cellOKb p2D p2kb 1 8 41 400 y = true := by
  intro y hy
  have h : cellOKb p2D p2kb 1 8 41 400 = cellOKb p2H p2kb 1 8 41 400 := rfl
  rw [h]
  exact List.all_eq_true.1 p2cells_ok y hy

theorem p2_headok : ∀ y ∈ p2T.head,
    pieceOK (p2D.cat 1) p2D.Q p2D.α ((1 : ℕ) / (p2D.Q : ℚ)) p2D.depth p2D.cF p2D.Pbad y.1 y.2 = true := by
  intro y hy
  have := List.all_eq_true.1 p2head_ok y hy
  exact this

end CatalanCore.Uniform.Bank.Plane2.Content.Data
#print axioms CatalanCore.Uniform.Bank.Plane2.Content.Data.p2_params
#print axioms CatalanCore.Uniform.Bank.Plane2.Content.Data.p2_head
#print axioms CatalanCore.Uniform.Bank.Plane2.Content.Data.p2_class
#print axioms CatalanCore.Uniform.Bank.Plane2.Content.Data.p2_cells
