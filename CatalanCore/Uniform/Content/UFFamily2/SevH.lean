module

public import CatalanCore.Uniform.Content.UFFamily2.Kill
public import CatalanCore.Uniform.Content.Shape.Alt

@[expose] public section

/-!
# UF family H (non-empty fibers): sevenths `a = 2`, `p ≡ 5 (mod 7)`, `7 m < p`, border wraps once (lane H, H11)

`q = 7`, `o = 5`, `c = 1/6`, `r = 12 m`, border `[12 m, 14 m)`, `N = 14 m`, and `7 m < p`, `13 p + 12 ≤ 98 m`
(non-vacuous from `m = 4`; e.g. `r = 48`, `p = 29`).  Then `p < r < 2 p`, so EVERY border node `v` has the
one-element fiber `{v - p}` (`fiberList_range`, `n = 1`).  The singular indices are `k₀ = (6p+5)/7 < r`
and `k₁ = (13p+5)/7`, with `r < k₁ < N`.  Border nodes `v < k₁` have `⌊(7v-5)/p⌋ = 11` or `12` (same
data `L = 0`), those with `v ≥ k₁` have `⌊(7v-5)/p⌋ = 13`.  The node `r` has the joint type
`famType 7 1 11 1 1`, every `v ≥ k₁` has `famType 7 1 13 1 1`; the kill certificate of `v ≥ k₁` against `t₀ = r` is
`KillCert.ofLu` with `u₀ = 1`, the two LU records below (generated by `H11/py/pilotH.py`) and the
integer cross wedge `-7865676 = -2² 3² 7⁵ 13`, prime to every `p > 13`.
-/

open Polynomial Matrix Finset CatalanCore CatalanCore.Basic CatalanCore.Arith.Hybrid
  CatalanCore.Arith.Hybrid.Periodic CatalanCore.Uniform.Content.UFMember
  CatalanCore.Uniform.Content.Hybrid CatalanCore.Uniform.Content.UFMoments
  CatalanCore.Uniform.Content.UFWedge CatalanCore.Uniform.Content.Smith
  CatalanCore.Uniform.Content.UFFamily

namespace CatalanCore.Uniform.Content.UFFamily2.SevH

/-- The second singular index of the class. -/
def k1 (p : ℕ) : ℕ := (13 * p + 5) / 7

/-- Validity window of the family (`m = r/12`). -/
structure Valid (r p : ℕ) : Prop where
  hr12 : r % 12 = 0
  hr0 : 0 < r
  hp7 : p % 7 = 5
  hlo : 7 * (r / 12) + 1 ≤ p
  hhi : 13 * p + 12 ≤ 98 * (r / 12)

theorem Valid.k1_spec {r p : ℕ} (h : Valid r p) : 7 * k1 p = 13 * p + 5 := by
  have := h.hp7; unfold k1; omega

theorem Valid.k1_lo {r p : ℕ} (h : Valid r p) : r + 2 ≤ k1 p := by
  have := h.hlo; have := h.hr12; have := h.hr0; have := h.k1_spec; omega

theorem Valid.k1_hi {r p : ℕ} (h : Valid r p) : k1 p + 1 ≤ 14 * (r / 12) := by
  have := h.hhi; have := h.k1_spec; omega

theorem Valid.p_lt_r {r p : ℕ} (h : Valid r p) : p < r := by
  have := h.hhi; have := h.hr12; have := h.hr0; omega

theorem Valid.p_big {r p : ℕ} (h : Valid r p) : 29 ≤ p := by
  have := h.hhi; have := h.hlo; omega

theorem Valid.two_p {r p : ℕ} (h : Valid r p) : 14 * (r / 12) + 2 ≤ 2 * p := by
  have := h.hlo; omega

variable {Fr : Frame}

/-- No singular index in `(p, k₁)`. -/
theorem not_sing {T : TwoTermData Fr 7 5} {r p : ℕ} [Fact p.Prime] (h : Valid r p) {k : ℕ}
    (h1 : p < k) (h2 : k < k1 p) : ¬ ttSing p 7 5 (k : ℤ) := by
  rw [ttSing_nat T (by omega)]
  have hk := h.k1_spec
  have hp7 := h.hp7
  have hk2 := h.two_p
  have hhi := h.k1_hi
  push Not
  refine ⟨fun hd => ?_, fun hd => ?_⟩
  · obtain ⟨j, hj⟩ := hd
    have hj2 : j < 2 := by
      by_contra hc
      push Not at hc
      have : p * 2 ≤ p * j := Nat.mul_le_mul_left p hc
      omega
    have hj1 : 1 < j := by
      by_contra hc
      push Not at hc
      have : p * j ≤ p * 1 := Nat.mul_le_mul_left p hc
      omega
    omega
  · obtain ⟨j, hj⟩ := hd
    have hj13 : j < 13 := by
      by_contra hc
      push Not at hc
      have : p * 13 ≤ p * j := Nat.mul_le_mul_left p hc
      omega
    have hj6 : 6 < j := by
      by_contra hc
      push Not at hc
      have : p * j ≤ p * 6 := Nat.mul_le_mul_left p hc
      omega
    interval_cases j <;> omega

theorem noSing {T : TwoTermData Fr 7 5} {r p N : ℕ} [Fact p.Prime] (h : Valid r p)
    (D : PoleData Fr p N) (hD : D.singular = ttSing p 7 5) (a Δ : ℕ) (ha : p ≤ a)
    (hb : a + Δ < k1 p) : NoSingWin D a Δ := by
  intro k h1 h2
  rw [hD]
  exact not_sing (T := T) h (by omega) (by omega)

/-! ### The two joint types and their LU records (generated by `H11/py/pilotH.py`) -/

def luJ : LuData where
  LM := [[1]]
  UM := [[6]]
  LA := [[1, 0], [1, 6]]
  UA := [[6, 0], [0, -6]]
  LB := [[1, 0], [1, 6]]
  UB := [[6, 6], [0, 42]]
  a := -6
  b := 42

def luK : LuData where
  LM := [[1]]
  UM := [[1105]]
  LA := [[1, 0], [-216, 1105]]
  UA := [[1105, -546], [0, -246714]]
  LB := [[1, 0], [-216, 1105]]
  UB := [[1105, 468], [0, 416052]]
  a := -246714
  b := 416052

theorem intOK_J : IntOK 7 5 5 (1 : ℚ) 1 (famType 7 1 11 1 1) 6 := by decide +kernel
theorem intOK_K : IntOK 7 5 5 (1 : ℚ) 1 (famType 7 1 13 1 1) 468 := by decide +kernel
theorem okJ : luJ.ok 1 (mkFib 7 5 5 (1 : ℚ) 1 (famType 7 1 11 1 1) 6) 6 = true := by decide +kernel
theorem okK : luK.ok 1 (mkFib 7 5 5 (1 : ℚ) 1 (famType 7 1 13 1 1) 468) 468 = true := by
  decide +kernel

theorem cross_val : luJ.b * luK.a - luJ.a * luK.b = -7865676 := by decide +kernel

theorem cross_not_dvd {p : ℕ} (hp : p.Prime) (h29 : 29 ≤ p) :
    ¬ (p : ℤ) ∣ luJ.b * luK.a - luJ.a * luK.b := by
  rw [cross_val]
  intro hd
  have h1 : (p : ℤ) ∣ 7865676 := (dvd_neg).1 hd
  have h2 : p ∣ 7865676 := Int.natCast_dvd_natCast.1 (by exact_mod_cast h1)
  refine not_dvd_of_factors hp (by norm_num) (fun q hq => ?_) h2
  have : Nat.primeFactorsList 7865676 = [2, 2, 3, 3, 7, 7, 7, 7, 7, 13] := by norm_num
  rw [this] at hq
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hq
  omega

variable {N : ℕ}
variable {ι κ : Type} [Fintype ι] [DecidableEq ι] [Fintype κ] [DecidableEq κ]

/-- **Kill certificate** of a border node `v ≥ k₁` against the representative `t₀ = r`:
types `famType 7 1 11 1 1` and `famType 7 1 13 1 1`, both with a one-element fiber. -/
noncomputable def killH (T : TwoTermData Fr 7 5) {r p N : ℕ} [Fact p.Prime] (h : Valid r p)
    (hNp : N < p * p) (hsq : ∀ t, 1 ≤ t → t < N → ¬ p ^ 2 ∣ 7 * t - 5) (hnorm : Fr.norm ∈ S p)
    (hnorm0 : red p Fr.norm ≠ 0) (hnrm : Fr.norm = 1) (hN : N = 14 * (r / 12))
    (c : ι → ℕ) (xs ys : κ → ℕ)
    (hc : ∀ a, c a < N) (hx : ∀ i, xs i < N) (hy : ∀ j, ys j < N) (hcinj : Function.Injective c)
    (hcr : ∀ a, c a < r) (hcov : ∀ x, x < r → ∃ a, c a = x) (v : ℕ) (hv1 : k1 p ≤ v) (hv2 : v < N) :
    KillCert (twoTermPoleData T hNp.le hsq hnorm hnorm0) hNp c xs ys hc hx hy r v := by
  have hp7 := h.hp7
  have hk := h.k1_spec
  have hlo := h.hlo
  have hhi := h.hhi
  have hr12 := h.hr12
  have hr0 := h.hr0
  have hpr := h.p_lt_r
  have hk2 := h.two_p
  have hk1 := h.k1_lo
  have hqp : 7 < p := by have := h.p_big; omega
  have hA0 : r / p = 1 := Nat.div_eq_of_lt_le (by omega) (by omega)
  have hB0 : (7 * r - 5) / p = 11 := Nat.div_eq_of_lt_le (by omega) (by omega)
  have hA1 : v / p = 1 := Nat.div_eq_of_lt_le (by omega) (by omega)
  have hB1 : (7 * v - 5) / p = 13 := Nat.div_eq_of_lt_le (by omega) (by omega)
  have FJ : FiberList p 7 5 c r (famType 7 1 11 1 1) :=
    fiberList_range 7 5 r r 1 1 1 11 c hcr hcov hcinj le_rfl (by norm_num) le_rfl
      (by omega) (fun j hj1 hj2 => by omega) (by omega) (Or.inr (by omega)) hA0 hB0
  have FK : FiberList p 7 5 c v (famType 7 1 13 1 1) :=
    fiberList_range 7 5 r v 1 1 1 13 c hcr hcov hcinj (by omega) (by norm_num) le_rfl
      (by omega) (fun j hj1 hj2 => by omega) (by omega) (Or.inr (by omega)) hA1 hB1
  refine KillCert.ofLu T hqp hNp hsq hnorm hnorm0 c xs ys hc hx hy hcinj r v (by omega) hv2 1
    (famType 7 1 11 1 1) (famType 7 1 13 1 1) 6 468 FJ FK ?_ ?_ luJ luK ?_ ?_
    (cross_not_dvd (Fact.out : p.Prime) h.p_big)
  · rw [hp7, hnrm]; exact intOK_J
  · rw [hp7, hnrm]; exact intOK_K
  · rw [hp7, hnrm]; exact okJ
  · rw [hp7, hnrm]; exact okK

end CatalanCore.Uniform.Content.UFFamily2.SevH
