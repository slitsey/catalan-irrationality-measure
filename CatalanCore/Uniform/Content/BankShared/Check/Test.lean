  show (true && pieceAll thirdsData 2 (c_prefTmpl0 ++ (c_prefTmpl1 ++ (c_prefTmpl2 ++ (c2_profTmpl2_0 ++ (c2_profTmpl2_1)))))) = true
  simp only [pieceAll_append, c_prefTmpl0_ok2, c_prefTmpl1_ok2, c_prefTmpl2_ok2, c2_profTmpl2_0_ok2, c2_profTmpl2_1_ok2, Bool.and_self]

set_option profiler true in
theorem thirds_params : checkParams thirdsData = true := by decide +kernel

set_option profiler true in
theorem thirds_classes : thirdsData.members.all (classOK thirdsData) = true := by decide +kernel

theorem thirds_tmpls : thirdsData.tmpls.all (fun x => tmplOK thirdsData x.1 x.2) = true := by
  show [(1, thirdsT1), (2, thirdsT2)].all (fun x => tmplOK thirdsData x.1 x.2) = true
  simp only [List.all_cons, List.all_nil, thirdsT1_ok, thirdsT2_ok, Bool.and_self]

/-- **Regression.** The existing thirds template passes the bank check. -/
theorem thirds_check : check thirdsData = true := by
  unfold check
  rw [thirds_params, thirds_tmpls, thirds_classes]
  rfl

/-- The real pieces of `thirdsT1` are those of `Tmpl/*.lean`. -/
theorem thirdsT1_real : thirdsT1.real = prefTmpl0 ++ (prefTmpl1 ++ (prefTmpl2 ++ (profTmpl1_0 ++ (profTmpl1_1)))) := by
  simp only [QTmpl.real, thirdsT1, List.map_append, c1_profTmpl1_0, c1_profTmpl1_1, c_prefTmpl0, c_prefTmpl1, c_prefTmpl2,
    List.map_cons, List.map_nil, toPiece_mkQ, prefTmpl0, prefTmpl1, prefTmpl2, profTmpl1_0, profTmpl1_1]

