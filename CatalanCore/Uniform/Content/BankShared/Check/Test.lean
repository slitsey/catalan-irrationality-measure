/-- `n / d`. -/
def qq (n : ℤ) (d : ℕ) : ℚ := (n : ℚ) / d

/-- The rational piece of `mkPiece sn sd tn td A B E D`. -/
def mkQ (sn sd tn td : ℕ) (A B E D : ℤ) : QPiece :=
  ⟨(sn : ℚ) / sd, (tn : ℚ) / td, (A : ℚ) / D, (B : ℚ) / D, (E : ℚ) / D⟩

theorem toPiece_mkQ (sn sd tn td : ℕ) (A B E D : ℤ) :
    (mkQ sn sd tn td A B E D).toPiece = mkPiece sn sd tn td A B E D := by
  simp only [mkQ, QPiece.toPiece, mkPiece]; push_cast; rfl

