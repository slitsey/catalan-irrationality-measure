theorem c1_profTmpl1_1_ok1 : pieceAll thirdsData 1 c1_profTmpl1_1 = true := by decide +kernel

set_option profiler true in
theorem thirdsT1_head : tmplHead thirdsData 1 thirdsT1 = true := by decide +kernel

theorem thirdsT1_ok : tmplOK thirdsData 1 thirdsT1 = true := by
  unfold tmplOK
  rw [thirdsT1_head]
  show (true && pieceAll thirdsData 1 (c_prefTmpl0 ++ (c_prefTmpl1 ++ (c_prefTmpl2 ++ (c1_profTmpl1_0 ++ (c1_profTmpl1_1)))))) = true
  simp only [pieceAll_append, c_prefTmpl0_ok1, c_prefTmpl1_ok1, c_prefTmpl2_ok1, c1_profTmpl1_0_ok1, c1_profTmpl1_1_ok1, Bool.and_self]

