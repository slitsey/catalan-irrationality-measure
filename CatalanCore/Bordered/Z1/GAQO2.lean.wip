module

public import CatalanCore.Bordered.Z1.GAQO

/-!
# Z1.5 (order K < c < K + s): node vector of a left eigenvector, and the column identity.
-/

@[expose] public section

open Finset Matrix

namespace CatalanCore.Bordered.Z1

lemma Gq_eq_lq (θ k : ℝ) : Gq θ (-k) = lq θ (k + 1) := by unfold Gq lq; ring

lemma Fq_eq_rq (s m : ℕ) (θ k : ℝ) : Fq s m θ (-(k + 2)) = rq s m θ (k + 1) := by
  unfold Fq rq; ring

/-- Node vector: `ωN a = ω (c - 1 - a)` on `A_O = {c - s, …, K - 1}`, zero elsewhere (`c = s+m+d`). -/
def omegaN (s m d : ℕ) (ω : ℕ → ℝ) (a : ℕ) : ℝ :=
  if m + d ≤ a ∧ a < s + m then ω (s + m + d - 1 - a) else 0

section QO2

variable (s m d : ℕ) (hd1 : 1 ≤ d) (hds : d < s)

local notation "θQ" => (-((s + m + d : ℕ) : ℝ))

include hd1 hds in
/-- Column identity for `Lᵀ ωN`. -/
theorem node_col (lam : ℝ) (ω : ℕ → ℝ) (hsupp : ∀ k, k < d ∨ s ≤ k → ω k = 0)
    (hX : ∀ k : Fin s, ((Xmat s m θQ)ᵀ *ᵥ (fun j : Fin s => ω j)) k = lam * ω k)
    (b : Fin (s + m)) :
    ((Lmat s m θQ)ᵀ *ᵥ (fun j : Fin (s + m) => omegaN s m d ω j)) b =
      lam * omegaN s m d ω b
        + (if (b : ℕ) + 1 = m + d then Gq θQ (-(s : ℝ)) * ω (s - 1) else 0) := by
  have hT : (Lmat s m θQ)ᵀ = tri3 (s + m) (fun a : ℕ => Gq θQ (θQ + a + 1))
      (fun a : ℕ => Dq s m θQ (θQ + a)) (fun a : ℕ => Fq s m θQ (θQ + (a : ℝ))) :=
    tri3_transpose _ _ _
  have hTX : (Xmat s m θQ)ᵀ = tri3 s (fun i : ℕ => rq s m θQ ((i : ℝ) + 1))
      (fun i : ℕ => Dq s m θQ (-((i : ℝ) + 1))) (fun i : ℕ => lq θQ ((i : ℝ) + 2)) :=
    tri3_transpose _ _ _
  rw [hT, tri3_row]
  have hb := b.2
  by_cases hA : m + d ≤ (b : ℕ)
  · -- b ∈ A_O
    obtain ⟨k, hk⟩ : ∃ k, k = s + m + d - 1 - (b : ℕ) := ⟨_, rfl⟩
    have hbk : (b : ℕ) + k + 1 = s + m + d := by omega
    have hks : k < s := by omega
    have hkd : d ≤ k := by omega
    have hbkR : ((b : ℕ) : ℝ) + k + 1 = s + m + d := by exact_mod_cast hbk
    have hωb : omegaN s m d ω b = ω k := by
      simp only [omegaN, if_pos (And.intro hA hb), hk]
    have hXk := hX ⟨k, hks⟩
    rw [hTX, tri3_row] at hXk
    simp only [] at hXk
    have t2 : (if (b : ℕ) + 1 < s + m then Gq θQ (θQ + ((b : ℕ) : ℝ) + 1) * omegaN s m d ω ((b : ℕ) + 1) else 0)
        = (if 0 < k then lq θQ (((k - 1 : ℕ) : ℝ) + 2) * ω (k - 1) else 0) := by
      by_cases hb1 : (b : ℕ) + 1 < s + m
      · rw [if_pos hb1, if_pos (by omega)]
        have : omegaN s m d ω ((b : ℕ) + 1) = ω (k - 1) := by
          simp only [omegaN, if_pos (And.intro (by omega) hb1)]
          congr 1; omega
        rw [this]
        have e1 : θQ + ((b : ℕ) : ℝ) + 1 = -(k : ℝ) := by push_cast at hbkR ⊢; linarith
        have e2 : ((k - 1 : ℕ) : ℝ) + 2 = (k : ℝ) + 1 := by
          rw [Nat.cast_sub (by omega)]; push_cast; ring
        rw [e1, e2, Gq_eq_lq]
      · rw [if_neg hb1]
        have : k = d := by omega
        subst this
        rw [if_pos (by omega), hsupp (k - 1) (Or.inl (by omega)), mul_zero]
    have t3 : (if 0 < (b : ℕ) then Fq s m θQ (θQ + (((b : ℕ) - 1 : ℕ) : ℝ)) * omegaN s m d ω ((b : ℕ) - 1) else 0)
        = (if k + 1 < s then rq s m θQ ((k : ℝ) + 1) * ω (k + 1) else 0) := by
      rw [if_pos (by omega)]
      by_cases hbb : m + d ≤ (b : ℕ) - 1
      · rw [if_pos (by omega)]
        have : omegaN s m d ω ((b : ℕ) - 1) = ω (k + 1) := by
          simp only [omegaN, if_pos (And.intro hbb (by omega))]
          congr 1; omega
        rw [this]
        have e1 : θQ + (((b : ℕ) - 1 : ℕ) : ℝ) = -((k : ℝ) + 2) := by
          rw [Nat.cast_sub (by omega)]; push_cast at hbkR ⊢; linarith
        rw [e1, Fq_eq_rq]
      · rw [if_neg (by omega)]
        have : omegaN s m d ω ((b : ℕ) - 1) = 0 := by
          simp only [omegaN]; rw [if_neg (by omega)]
        rw [this, mul_zero]
    have t1 : Dq s m θQ (θQ + ((b : ℕ) : ℝ)) = Dq s m θQ (-((k : ℝ) + 1)) := by
      congr 1; push_cast at hbkR ⊢; linarith
    rw [if_neg (by omega), add_zero, hωb, t1]
    rw [t2, t3]
    rw [← hXk]
    simp only [mul_comm]
    sorry
  · sorry

end QO2

end CatalanCore.Bordered.Z1
