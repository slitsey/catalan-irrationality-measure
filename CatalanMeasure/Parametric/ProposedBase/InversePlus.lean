  exact inverse_of_int_checks basePlusInt inversePlusInt inversePlus_int_checked

theorem basePlus_det_ne_zero : basePlusMod.det ≠ 0 := by
  have h := congrArg Matrix.det inversePlus_correct
  rw [Matrix.det_mul,Matrix.det_one] at h
  exact left_ne_zero_of_mul_eq_one h

