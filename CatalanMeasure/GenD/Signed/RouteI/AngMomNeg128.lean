theorem map_getD_range {α : Type*} (l : List α) (d : α) (n : ℕ) (h : l.length = n) :
    (List.range n).map (fun k => l.getD k d) = l := by
  subst h
  apply List.ext_getElem
  · simp
  · intro i h1 h2
    simp [List.getD_eq_getElem?_getD, h2]

theorem hbins : TL.map BD.pcs = binsQ 128 TtD (gasT Sign.neg) := by
  rw [binsQ_eq]
  unfold TL
  rw [List.map_map]
  exact map_getD_range binsLit [] 116 binsLit_length

theorem part_neg : Partitioned (reflectL (capSource.gas Sign.neg)) (binsY TL) :=
  partitioned_neg (K := 128) (by norm_num) sum_row0 cuts_ok hbins

end

end CatalanMeasure.GenD.Signed.RouteI.AngMomNeg128
