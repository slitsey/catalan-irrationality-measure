theorem tc8 : (List.range 16).all (fun i => tlOk (128 + i)) = true := by decide +kernel

-- kcost: 16 recursion steps on integer lists of at most 163 entries; 0.5 to 4 s measured per chunk of 16 (TestT)
theorem tc9 : (List.range 16).all (fun i => tlOk (144 + i)) = true := by decide +kernel

-- kcost: 1 recursion steps on integer lists of at most 163 entries; 0.5 to 4 s measured per chunk of 16 (TestT)
theorem tc10 : (List.range 1).all (fun i => tlOk (160 + i)) = true := by decide +kernel

theorem Tl_step : ∀ n < 161, T4Instance.chebStep (Tl.getD n []) (Tl.getD (n + 1) []) = Tl.getD (n + 2) [] := by
  intro n hn
  have h : tlOk n = true := by
    by_cases h0 : n < 16
    · have h : tlOk (0 + (n - 0)) = true := List.all_eq_true.mp tc0 (n - 0) (List.mem_range.mpr (by omega))
      rwa [show 0 + (n - 0) = n from by omega] at h
    by_cases h1 : n < 32
    · have h : tlOk (16 + (n - 16)) = true := List.all_eq_true.mp tc1 (n - 16) (List.mem_range.mpr (by omega))
      rwa [show 16 + (n - 16) = n from by omega] at h
    by_cases h2 : n < 48
    · have h : tlOk (32 + (n - 32)) = true := List.all_eq_true.mp tc2 (n - 32) (List.mem_range.mpr (by omega))
      rwa [show 32 + (n - 32) = n from by omega] at h
    by_cases h3 : n < 64
    · have h : tlOk (48 + (n - 48)) = true := List.all_eq_true.mp tc3 (n - 48) (List.mem_range.mpr (by omega))
      rwa [show 48 + (n - 48) = n from by omega] at h
    by_cases h4 : n < 80
    · have h : tlOk (64 + (n - 64)) = true := List.all_eq_true.mp tc4 (n - 64) (List.mem_range.mpr (by omega))
      rwa [show 64 + (n - 64) = n from by omega] at h
    by_cases h5 : n < 96
    · have h : tlOk (80 + (n - 80)) = true := List.all_eq_true.mp tc5 (n - 80) (List.mem_range.mpr (by omega))
      rwa [show 80 + (n - 80) = n from by omega] at h
    by_cases h6 : n < 112
    · have h : tlOk (96 + (n - 96)) = true := List.all_eq_true.mp tc6 (n - 96) (List.mem_range.mpr (by omega))
      rwa [show 96 + (n - 96) = n from by omega] at h
    by_cases h7 : n < 128
    · have h : tlOk (112 + (n - 112)) = true := List.all_eq_true.mp tc7 (n - 112) (List.mem_range.mpr (by omega))
      rwa [show 112 + (n - 112) = n from by omega] at h
    by_cases h8 : n < 144
    · have h : tlOk (128 + (n - 128)) = true := List.all_eq_true.mp tc8 (n - 128) (List.mem_range.mpr (by omega))
      rwa [show 128 + (n - 128) = n from by omega] at h
    by_cases h9 : n < 160
    · have h : tlOk (144 + (n - 144)) = true := List.all_eq_true.mp tc9 (n - 144) (List.mem_range.mpr (by omega))
      rwa [show 144 + (n - 144) = n from by omega] at h
    have h : tlOk (160 + (n - 160)) = true := List.all_eq_true.mp tc10 (n - 160) (List.mem_range.mpr (by omega))
    rwa [show 160 + (n - 160) = n from by omega] at h
  exact of_decide_eq_true h

theorem Tl_01 : Tl.getD 0 [] = [1] ∧ Tl.getD 1 [] = [0, 1] := by decide +kernel

def foldT : List ℤ → ℕ → List ℤ
  | [], _ => []
  | c :: cs, n => T4Instance.addL (T4Instance.smulL c (Tl.getD n [])) (foldT cs (n + 1))

theorem chebSum_Tl : ∀ (cs : List ℤ) (n : ℕ), n + cs.length ≤ 161 →
    T4Instance.chebSum cs (Tl.getD n []) (Tl.getD (n + 1) []) = foldT cs n := by
  intro cs
  induction cs with
  | nil => intro n _; rfl
  | cons c cs ih =>
    intro n hn
    simp only [T4Instance.chebSum, foldT]
    rw [Tl_step n (by simp only [List.length_cons] at hn; omega)]
    have := ih (n + 1) (by simp only [List.length_cons] at hn; omega)
    rw [this]

theorem chebPoly_eq (ws : List ℤ) (h : ws.length + 1 ≤ 161) :
    UnsignedInstance.chebPoly 0 ws = foldT (0 :: ws) 0 := by
  unfold UnsignedInstance.chebPoly
  obtain ⟨h0, h1⟩ := Tl_01
  rw [← chebSum_Tl (0 :: ws) 0 (by simp only [List.length_cons]; omega), h0, h1]

/-! ### Strict checkers and their equalities to the built ones -/

def horn2 : List ℤ → ℤ → ℕ → ℕ → ℤ
  | [], _, _, _ => 0
  | a :: q, n, S, e => a * (S : ℤ) ^ e + n * horn2 q n S (e - 1)

theorem hornS_horn2 (n : ℤ) (S : ℕ) : ∀ z : List ℤ, hornS z n S = (S : ℤ) * horn2 z n S (z.length - 1)
  | [] => by simp [hornS, horn2]
  | a :: q => by
    have ih := hornS_horn2 n S q
    simp only [hornS, horn2, List.length_cons, Nat.add_sub_cancel]
    rw [ih]
    ring

def FSq1 (W : List ℤ) (K : ℤ) (n : ℕ) (k : ℕ) : ℚ :=
  (horn2 W n (2 ^ k) (W.length - 1) : ℚ) * 2 ^ k / ((K : ℚ) * n * (((2 ^ k : ℕ) : ℚ)) ^ (W.length - 1))

theorem frac_aux (s h Kn : ℚ) (hs : s ≠ 0) (l : ℕ) : (s * h) * s / (Kn * s ^ (l + 1)) = h * s / (Kn * s ^ l) := by
  rw [pow_succ, show s * h * s = s * (h * s) by ring, show Kn * (s ^ l * s) = s * (Kn * s ^ l) by ring,
    mul_div_mul_left _ _ hs]

theorem FSq1_eq (W : List ℤ) (K : ℤ) (n k : ℕ) : FSq1 W K n k = FSq W K n k := by
  unfold FSq1 FSq
  rw [hornS_horn2]
  rcases W with _ | ⟨a, q⟩
  · simp [horn2]
  · have hs : ((2 ^ k : ℕ) : ℚ) ≠ 0 := by positivity
    have e : ((2 ^ k : ℕ) : ℚ) = 2 ^ k := by push_cast; ring
    simp only [List.length_cons, Nat.add_sub_cancel, Int.cast_mul, Int.cast_natCast]
    rw [e] at hs ⊢
    rw [frac_aux _ _ _ hs]

def cellUB1 (W : List ℤ) (K a1 : ℤ) (B : ℚ) (k N n1 n2 : ℕ) : ℚ :=
  FSq1 W K n2 k - FSq1 W K n1 k + (B * 2 ^ k / (n2 : ℚ) ^ 2 + |(a1 : ℚ)| / n2) +
    (B * 2 ^ k / (n1 : ℚ) ^ 2 + |(a1 : ℚ)| / n1) +
    max ((a1 : ℚ) * hiLogQ (((n1 : ℚ) + 1) / n2) N) ((a1 : ℚ) * loLogQ ((n1 : ℚ) / ((n2 : ℚ) + 1)) N)

theorem cellUB1_eq (W : List ℤ) (K a1 : ℤ) (B : ℚ) (k N n1 n2 : ℕ) :
    cellUB1 W K a1 B k N n1 n2 = cellUB W K a1 B k N n1 n2 := by
  simp only [cellUB1, cellUB, FSq1_eq]

def rowTerm1 (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) (t : Tr) (d : ℕ × ℕ) : ℚ :=
  match pickZ z t.1 with
  | a0 :: a1 :: r => roundUp (cellW T t * cellUB1 (Wpoly K a0 a1 r) K a1 B k N d.1 d.2)
  | _ => 0

theorem rowTerm1_eq (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) (t : Tr) (d : ℕ × ℕ) :
    rowTerm1 z K B k N T t d = rowTerm z K B k N T t d := by
  unfold rowTerm1 rowTerm
  generalize pickZ z t.1 = p
  match p with
  | a0 :: a1 :: r => simp only [cellUB1_eq]
  | [] => rfl
  | [_] => rfl

def rowSum1 (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) : List Tr → List (ℕ × ℕ) → ℚ
  | t :: ts, d :: ds => rowTerm1 z K B k N T t d + rowSum1 z K B k N T ts ds
  | _, _ => 0

theorem rowSum1_eq (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) :
    ∀ (ts : List Tr) (ds : List (ℕ × ℕ)), rowSum1 z K B k N T ts ds = rowSum z K B k N T ts ds
  | [], [] => rfl
  | [], _ :: _ => rfl
  | _ :: _, [] => rfl
  | t :: ts, d :: ds => by
    simp only [rowSum1, rowSum, rowTerm1_eq, rowSum1_eq z K B k N T ts ds]

theorem horn2_colS (V : List ℤ) (b : ℤ) (S : ℕ) (hS : (S : ℚ) ≠ 0) :
    (b : ℚ) / (S : ℚ) * (hornS V b S : ℚ) / (S : ℚ) ^ V.length =
      (b : ℚ) / (S : ℚ) * (horn2 V b S (V.length - 1) : ℚ) / (S : ℚ) ^ (V.length - 1) := by
  rw [hornS_horn2]
  rcases V with _ | ⟨a, q⟩
  · simp [horn2]
  · simp only [List.length_cons, Nat.add_sub_cancel, Int.cast_mul, Int.cast_natCast]
    rw [pow_succ]
    generalize (S : ℚ) = s at hS ⊢
    generalize ((horn2 (a :: q) b S q.length : ℤ) : ℚ) = h
    field_simp

theorem horn2_col (V : List ℤ) (b : ℤ) :
    (b : ℚ) / ((10 ^ 12 : ℕ) : ℚ) * (hornS V b (10 ^ 12) : ℚ) / ((10 ^ 12 : ℕ) : ℚ) ^ V.length =
      (b : ℚ) / ((10 ^ 12 : ℕ) : ℚ) * (horn2 V b (10 ^ 12) (V.length - 1) : ℚ) / ((10 ^ 12 : ℕ) : ℚ) ^ (V.length - 1) :=
  horn2_colS V b (10 ^ 12) (by positivity)

def colTerm1 (z : List ℤ) (K : ℤ) (T : ℤ) (t : Tr) : ℚ :=
  let V := wJ K 1 z
  let S : ℕ := 10 ^ 12
  roundDown (cellW T t * (((t.2.1 : ℚ) / S) * (horn2 V t.2.1 S (V.length - 1) : ℚ) / (S : ℚ) ^ (V.length - 1) -
    ((t.1 : ℚ) / S) * (horn2 V t.1 S (V.length - 1) : ℚ) / (S : ℚ) ^ (V.length - 1)) / K)

theorem colTerm1_eq (z : List ℤ) (K : ℤ) (T : ℤ) (t : Tr) : colTerm1 z K T t = colTerm z K T t := by
  unfold colTerm1 colTerm
  simp only [horn2_col]

def colSum1 (z : List ℤ) (K T : ℤ) : List Tr → ℚ
  | [] => 0
  | t :: ts => colTerm1 z K T t + colSum1 z K T ts

theorem colSum1_eq (z : List ℤ) (K T : ℤ) : ∀ ts : List Tr, colSum1 z K T ts = colSum z K T ts
  | [] => rfl
  | t :: ts => by simp only [colSum1, colSum, colTerm1_eq, colSum1_eq z K T ts]


/-! ### Groups of 8 cells and the chain lemmas -/

/-- The `m`-th group of 8 consecutive entries. -/
def grp {α : Type} (L : List α) (m : ℕ) : List α := (L.drop (8 * m)).take 8

def rowSumL (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) : List (List Tr × List (ℕ × ℕ)) → ℚ
  | [] => 0
  | p :: L => rowSum z K B k N T p.1 p.2 + rowSumL z K B k N T L

def rowOKL (z : List ℤ) (k : ℕ) : List (List Tr × List (ℕ × ℕ)) → Bool
  | [] => true
  | p :: L => rowOK z k p.1 p.2 && rowOKL z k L

def colSumL (z : List ℤ) (K T : ℤ) : List (List Tr) → ℚ
  | [] => 0
  | p :: L => colSum z K T p + colSumL z K T L

theorem rowSumL_nil (z K B k N T) : rowSumL z K B k N T [] = 0 := rfl
theorem rowSumL_cons (ts : List Tr) (ds : List (ℕ × ℕ)) {z K B k N T} {L : List (List Tr × List (ℕ × ℕ))}
    {v r : ℚ} (h0 : rowSum z K B k N T ts ds = v) (hr : rowSumL z K B k N T L = r) :
    rowSumL z K B k N T ((ts, ds) :: L) = v + r := by
  simp only [rowSumL, h0, hr]
theorem rowOKL_nil (z k) : rowOKL z k [] = true := rfl
theorem rowOKL_cons (ts : List Tr) (ds : List (ℕ × ℕ)) {z k} {L : List (List Tr × List (ℕ × ℕ))}
    (h0 : rowOK z k ts ds = true) (hr : rowOKL z k L = true) : rowOKL z k ((ts, ds) :: L) = true := by
  simp only [rowOKL, h0, hr, Bool.and_self]
theorem colSumL_nil (z K T) : colSumL z K T [] = 0 := rfl
theorem colSumL_cons (p : List Tr) {z K T} {L : List (List Tr)} {v r : ℚ}
    (h0 : colSum z K T p = v) (hr : colSumL z K T L = r) : colSumL z K T (p :: L) = v + r := by
  simp only [colSumL, h0, hr]

theorem rowSumL_app (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) :
    ∀ L1 L2 : List (List Tr × List (ℕ × ℕ)),
      rowSumL z K B k N T (L1 ++ L2) = rowSumL z K B k N T L1 + rowSumL z K B k N T L2 := by
  intro L1
  induction L1 with
  | nil => intro L2; simp [rowSumL]
  | cons p L ih => intro L2; simp only [List.cons_append, rowSumL]; rw [ih]; ring

theorem rowOKL_app (z : List ℤ) (k : ℕ) :
    ∀ L1 L2 : List (List Tr × List (ℕ × ℕ)), rowOKL z k (L1 ++ L2) = (rowOKL z k L1 && rowOKL z k L2) := by
  intro L1
  induction L1 with
  | nil => intro L2; simp [rowOKL]
  | cons p L ih => intro L2; simp only [List.cons_append, rowOKL]; rw [ih, Bool.and_assoc]

theorem colSumL_app (z : List ℤ) (K T : ℤ) :
    ∀ L1 L2 : List (List Tr), colSumL z K T (L1 ++ L2) = colSumL z K T L1 + colSumL z K T L2 := by
  intro L1
  induction L1 with
  | nil => intro L2; simp [colSumL]
  | cons p L ih => intro L2; simp only [List.cons_append, colSumL]; rw [ih]; ring

theorem rowSum_append (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) :
    ∀ (ts1 : List Tr) (ds1 : List (ℕ × ℕ)) (ts2 : List Tr) (ds2 : List (ℕ × ℕ)),
      ts1.length = ds1.length →
      rowSum z K B k N T (ts1 ++ ts2) (ds1 ++ ds2) = rowSum z K B k N T ts1 ds1 + rowSum z K B k N T ts2 ds2 := by
  intro ts1
  induction ts1 with
  | nil =>
    intro ds1 ts2 ds2 h
    cases ds1 with
    | nil => simp [rowSum]
    | cons d ds => simp at h
  | cons t ts ih =>
    intro ds1 ts2 ds2 h
    cases ds1 with
    | nil => simp at h
    | cons d ds =>
      simp only [List.length_cons, add_left_inj] at h
      simp only [List.cons_append, rowSum]
      rw [ih ds ts2 ds2 h]
      ring

theorem rowOK_append (z : List ℤ) (k : ℕ) :
    ∀ (ts1 : List Tr) (ds1 : List (ℕ × ℕ)) (ts2 : List Tr) (ds2 : List (ℕ × ℕ)),
      ts1.length = ds1.length →
      rowOK z k (ts1 ++ ts2) (ds1 ++ ds2) = (rowOK z k ts1 ds1 && rowOK z k ts2 ds2) := by
  intro ts1
  induction ts1 with
  | nil =>
    intro ds1 ts2 ds2 h
    cases ds1 with
    | nil => simp [rowOK]
    | cons d ds => simp at h
  | cons t ts ih =>
    intro ds1 ts2 ds2 h
    cases ds1 with
    | nil => simp at h
    | cons d ds =>
      simp only [List.length_cons, add_left_inj] at h
      simp only [List.cons_append, rowOK]
      rw [ih ds ts2 ds2 h, Bool.and_assoc]

theorem colSum_append (z : List ℤ) (K T : ℤ) :
    ∀ ts1 ts2 : List Tr, colSum z K T (ts1 ++ ts2) = colSum z K T ts1 + colSum z K T ts2 := by
  intro ts1
  induction ts1 with
  | nil => intro ts2; simp [colSum]
  | cons t ts ih => intro ts2; simp only [List.cons_append, colSum]; rw [ih]; ring

theorem rowSum_flat (z : List ℤ) (K : ℤ) (B : ℚ) (k N : ℕ) (T : ℤ) :
    ∀ L : List (List Tr × List (ℕ × ℕ)), (∀ p ∈ L, p.1.length = p.2.length) →
      rowSum z K B k N T (L.map Prod.fst).flatten (L.map Prod.snd).flatten = rowSumL z K B k N T L := by
  intro L
  induction L with
  | nil => intro _; simp [rowSum, rowSumL]
  | cons p L ih =>
    intro h
    simp only [List.map_cons, List.flatten_cons, rowSumL]
    rw [rowSum_append _ _ _ _ _ _ _ _ _ _ (h p (by simp)), ih (fun q hq => h q (by simp [hq]))]

theorem rowOK_flat (z : List ℤ) (k : ℕ) :
    ∀ L : List (List Tr × List (ℕ × ℕ)), (∀ p ∈ L, p.1.length = p.2.length) →
      rowOK z k (L.map Prod.fst).flatten (L.map Prod.snd).flatten = rowOKL z k L := by
  intro L
  induction L with
  | nil => intro _; simp [rowOK, rowOKL]
  | cons p L ih =>
    intro h
    simp only [List.map_cons, List.flatten_cons, rowOKL]
    rw [rowOK_append _ _ _ _ _ _ (h p (by simp)), ih (fun q hq => h q (by simp [hq]))]

theorem colSum_flat (z : List ℤ) (K T : ℤ) :
    ∀ L : List (List Tr), colSum z K T L.flatten = colSumL z K T L := by
  intro L
  induction L with
  | nil => simp [colSum, colSumL]
  | cons p L ih => simp only [List.flatten_cons, colSumL]; rw [colSum_append, ih]

