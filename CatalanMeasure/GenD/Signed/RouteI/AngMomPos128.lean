def TtD : ℤ := 999997120790
def eAu : ℚ := 1 / 2 ^ 80
def eBu : ℚ := 1 / 2 ^ 100

def d0 : MomD := ⟨0, 0, 0, 0⟩
/-- the bin record `k`. -/
def xk (k : ℕ) : BD :=
  ⟨binsLit.getD k [], (momD.getD k d0).m, (momD.getD k d0).A, (momD.getD k d0).B, (momD.getD k d0).s0⟩
def TL : List BD := (List.range 117).map xk

theorem sum_row0 : sumP row0 = TtD := by
  -- kcost: the sum of row0, 704 additions; well under 1 s.
  decide +kernel

theorem binsLit_length : binsLit.length = 117 := by
  -- kcost: list length, 117 steps.
  decide +kernel

theorem cuts_ok : cutsOK 128 TtD (gasT Sign.pos) = true := by
  -- kcost: about 300 cells, integer cross-multiplications, at most 2 cuts per cell; about 2 s.
  decide +kernel

theorem binsQ_eq : binsQ 128 TtD (gasT Sign.pos) = binsLit := by
  -- kcost: building and grouping 542 pieces, rational cut arithmetic; about 3 s at K = 32 (measured).
  decide +kernel

