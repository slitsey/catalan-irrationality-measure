/-!
# Route I `ChordTableData`: the frozen chord table of design C (GP §7.1, Cor 7.2; ledger G13)

Generated by `work/tools/g3/chord/gen_chord.py` from `rho-gap-scope-2026-11-06/pkg/out/p4.json`.
Data: 866 knots `k_i = knotN_i / 2^40` (three packed hexadecimal numerals), values `v_i = vN_i / 10^9`, `C₀ = 8263/250 = 33.052`,
and one packed witness word per knot (106 integer square roots of 52 bits, scale `2^8`).

What is proved here (no `sorry`, no `native_decide`):
* `kt_lt`: the knots increase; `seg_ok`: every segment between consecutive knots is `SegOK` for every
  interval, so `chordL` is concave on it (`hconc_table`, from `concaveOn_chordL`);
* `hv_table`: `-L(k_i) - C₀ ≤ v_i` for every knot, where `L = ivlL ivlLo ivlHi`.  Per knot and
  interval (flat index `j`), with `W = B_j - A_j`, `X = |2 n - A_j - B_j|`, `Xm = max X W` (all
  over `2^40`) and `r_j` the packed witness with `r_j^2 ≤ (Xm^2 - W^2) 2^16`, we have
  `log (w/4) + arcosh (max 1 |ℓ|) ≥ log ((Xm 2^8 + r_j) / (4·2^48))`
  (`term_ge`: `w y = Xm/2^40`, `w √(y²-1) = √(Xm²-W²)/2^40`).  The product of these 106 lower
  bounds is an exact natural number; with `y = 2 (v_i + C₀)` the check
  `P_n · T^128 ≥ (4·2^48)^106 (M^15 15!)^128`, `M = 128·10^9`, `T = Σ_{m<16} yn^m M^(15-m) 15!/m!`
  says `P_n/(4·2^48)^106 ≥ 1/E` with `E = (Σ_{m<16} (y/128)^m/m!)^128 ≤ exp y`, hence
  `½ log (Π) ≥ -(v_i + C₀)`;
* `neg_L_le_table`: Corollary 7.2 for this table, `-L(t) ≤ C₀ + δ̂(t)` on `[k_0, k_last]`.
-/

namespace CatalanMeasure.GenD.Signed.RouteI.ChordTableData

open CatalanMeasure.GenD.Signed.RouteI CatalanMeasure.GenD.Signed.RouteI.IntervalNodesData
  CatalanMeasure.GenD.Signed.RouteI.ChordTable Set Finset

/-- Packed knot numerators: field `i` (44 bits) is `knotN_i + 2^43`; `k_i = knotN_i / 2^40`. -/
def knotP : ℕ := 

/-- Packed knot values: field `i` (44 bits) is `vN_i + 2^43`; `v_i = vN_i / 10^9`. -/
def vP : ℕ := 

/-- Packed square-root witnesses: word `i` (`106 * 52` bits) holds `r_j`, `j < 106`, for knot `i`. -/
def witP : ℕ := 

def knotZ (i : ℕ) : ℤ := (((knotP >>> (44 * i)) % 2 ^ 44 : ℕ) : ℤ) - 2 ^ 43
def vZ (i : ℕ) : ℤ := (((vP >>> (44 * i)) % 2 ^ 44 : ℕ) : ℤ) - 2 ^ 43
def witZ (i : ℕ) : ℕ := (witP >>> (5512 * i)) % 2 ^ 5512

/-! ### The checker (natural numbers; kernel evaluated) -/

def Wd (c : ℕ) : ℕ := (ivlBN.getD c 0 - ivlAN.getD c 0).toNat
def Xd (n : ℤ) (c : ℕ) : ℕ := (2 * n - ivlAN.getD c 0 - ivlBN.getD c 0).natAbs
def Xm (n : ℤ) (c : ℕ) : ℕ := max (Xd n c) (Wd c)
def rd (w c : ℕ) : ℕ := (w >>> (52 * c)) % 2 ^ 52
def Qd (n : ℤ) (w c : ℕ) : ℕ := (Xm n c <<< 8) + rd w c
def sqOK (n : ℤ) (w c : ℕ) : Bool :=
  decide (rd w c ^ 2 ≤ ((Xm n c) ^ 2 - (Wd c) ^ 2) <<< 16)
def prodQ (n : ℤ) (w : ℕ) : ℕ := ((List.range 106).map (Qd n w)).prod
def yOf (vn : ℤ) : ℕ := (2 * vn + 66104000000).toNat
def Mc : ℕ := 128 * 10 ^ 9
def tSum (yn : ℕ) : ℕ :=
  ((List.range 16).map (fun m => yn ^ m * Mc ^ (15 - m) * (Nat.factorial 15 / Nat.factorial m))).sum
def knotOK (n vn : ℤ) (w : ℕ) : Bool :=
  decide (0 ≤ 2 * vn + 66104000000) && (List.range 106).all (sqOK n w) &&
  decide ((4 * 2 ^ 48) ^ 106 * (Mc ^ 15 * Nat.factorial 15) ^ 128 ≤ prodQ n w * (tSum (yOf vn)) ^ 128)

theorem hv_nat : (List.range 866).all
    (fun i => knotOK (knotZ i) (vZ i) (witZ i)) = true := by
  decide +kernel -- kcost: 130 s (866 knots, 106 integer squares and products each, one 128th power of a ~200-digit number), G3 7 Nov

theorem knot_inc_nat : (List.range 865).all
    (fun i => decide (knotZ i < knotZ (i + 1))) = true := by
  decide +kernel -- kcost: 1 s estimated (865 comparisons), G3 7 Nov

theorem seg_nat : (List.range 865).all (fun i => (List.range 106).all (fun c =>
    decide (knotZ (i + 1) ≤ ivlAN.getD c 0 ∨ ivlBN.getD c 0 ≤ knotZ i ∨
      (ivlAN.getD c 0 ≤ knotZ i ∧ knotZ (i + 1) ≤ ivlBN.getD c 0)))) = true := by
  decide +kernel -- kcost: 43 s (865 x 106 triples of comparisons), G3 7 Nov

theorem hull_nat : (List.range 106).all (fun c =>
    decide (knotZ 0 ≤ ivlAN.getD c 0 ∧ ivlBN.getD c 0 ≤ knotZ 865)) = true := by
  decide +kernel -- kcost: 1 s estimated (106 comparisons), G3 7 Nov

theorem lsum (f : ℕ → ℕ) (n : ℕ) : ((List.range n).map f).sum = ∑ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp
  | succ n ih => rw [List.range_succ, List.map_append, List.sum_append, ih, Finset.sum_range_succ]; simp

theorem lprod (f : ℕ → ℕ) (n : ℕ) : ((List.range n).map f).prod = ∏ i ∈ Finset.range n, f i := by
  induction n with
  | zero => simp
  | succ n ih => rw [List.range_succ, List.map_append, List.prod_append, ih, Finset.prod_range_succ]; simp

/-! ### Real-number statements -/

noncomputable section

/-- The knots. -/
def kt (i : ℕ) : ℝ := ((knotZ i : ℤ) : ℝ) / 2 ^ 40
/-- The knot values. -/
def vt (i : ℕ) : ℝ := ((vZ i : ℤ) : ℝ) / 10 ^ 9

theorem kt_lt : ∀ i, i < 865 → kt i < kt (i + 1) := by
  intro i hi
  have h1 := List.all_eq_true.mp knot_inc_nat i (List.mem_range.mpr hi)
  have h : knotZ i < knotZ (i + 1) := of_decide_eq_true h1
  unfold kt
  have : ((knotZ i : ℤ) : ℝ) < ((knotZ (i + 1) : ℤ) : ℝ) := by exact_mod_cast h
  exact div_lt_div_of_pos_right this (by positivity)

theorem hull_table (c : Fin 53 × Fin 2) : kt 0 ≤ ivlLo c ∧ ivlHi c ≤ kt 865 := by
  have h1 := List.all_eq_true.mp hull_nat (finProdFinEquiv c : Fin (53 * 2))
    (List.mem_range.mpr (finProdFinEquiv c).2)
  obtain ⟨h, h'⟩ := of_decide_eq_true h1
  have hp : (0 : ℝ) < 2 ^ 40 := by positivity
  unfold ivlLo ivlHi loF hiF kt
  constructor
  · have : ((knotZ 0 : ℤ) : ℝ) ≤ ((ivlAN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) := by exact_mod_cast h
    exact div_le_div_of_nonneg_right this hp.le
  · have : ((ivlBN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) ≤ ((knotZ 865 : ℤ) : ℝ) := by exact_mod_cast h'
    exact div_le_div_of_nonneg_right this hp.le

theorem seg_ok : ∀ i, i < 865 → ∀ c : Fin 53 × Fin 2,
    SegOK (ivlLo c) (ivlHi c) (Icc (kt i) (kt (i + 1))) := by
  intro i hi c
  have h1 := List.all_eq_true.mp seg_nat i (List.mem_range.mpr hi)
  have h2 := List.all_eq_true.mp h1 (finProdFinEquiv c : Fin (53 * 2)) (List.mem_range.mpr (finProdFinEquiv c).2)
  have h := of_decide_eq_true h2
  have hp : (0 : ℝ) < 2 ^ 40 := by positivity
  unfold SegOK ivlLo ivlHi loF hiF kt
  rcases h with h | h | ⟨h, h'⟩
  · left
    intro x hx
    have : ((knotZ (i + 1) : ℤ) : ℝ) ≤ ((ivlAN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) := by exact_mod_cast h
    exact le_trans hx.2 (div_le_div_of_nonneg_right this hp.le)
  · right; left
    intro x hx
    have : ((ivlBN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) ≤ ((knotZ i : ℤ) : ℝ) := by exact_mod_cast h
    exact le_trans (div_le_div_of_nonneg_right this hp.le) hx.1
  · right; right
    intro x hx
    have a1 : ((ivlAN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) ≤ ((knotZ i : ℤ) : ℝ) := by exact_mod_cast h
    have a2 : ((knotZ (i + 1) : ℤ) : ℝ) ≤ ((ivlBN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) := by exact_mod_cast h'
    exact ⟨le_trans (div_le_div_of_nonneg_right a1 hp.le) hx.1,
      le_trans hx.2 (div_le_div_of_nonneg_right a2 hp.le)⟩

theorem hconc_table : ∀ i, i < 865 → ConcaveOn ℝ (Icc (kt i) (kt (i + 1))) (chordL ivlLo ivlHi) :=
  fun i hi => concaveOn_chordL ivlLo ivlHi ivlLo_lt (convex_Icc _ _) (seg_ok i hi)

/-! #### One term of `L` -/

theorem term_ge {w y ρ : ℝ} (hw : 0 < w) (hy : 1 ≤ y) (hρ : 0 ≤ ρ)
    (hρ2 : ρ ^ 2 ≤ (w * y) ^ 2 - w ^ 2) :
    Real.log ((w * y + ρ) / 4) ≤ Real.log (w / 4) + Real.arcosh y := by
  have hs0 := Real.sqrt_nonneg (y ^ 2 - 1)
  have hs : 0 < y + √(y ^ 2 - 1) := by linarith
  have h1 : Real.arcosh y = Real.log (y + √(y ^ 2 - 1)) := by
    rw [← Real.exp_arcosh hy, Real.log_exp]
  rw [h1, ← Real.log_mul (by positivity) hs.ne']
  have hr : ρ ≤ w * √(y ^ 2 - 1) := by
    have e : w * √(y ^ 2 - 1) = √((w * y) ^ 2 - w ^ 2) := by
      rw [show (w * y) ^ 2 - w ^ 2 = w ^ 2 * (y ^ 2 - 1) by ring, Real.sqrt_mul (sq_nonneg w),
        Real.sqrt_sq hw.le]
    rw [e]
    exact le_trans (le_abs_self ρ) (Real.abs_le_sqrt hρ2)
  apply Real.log_le_log (by positivity)
  have : w / 4 * (y + √(y ^ 2 - 1)) = (w * y + w * √(y ^ 2 - 1)) / 4 := by ring
  rw [this]
  linarith

theorem exp_lower (x : ℝ) (hx : 0 ≤ x) :
    (∑ m ∈ Finset.range 16, x ^ m / (m.factorial : ℝ)) ^ 128 ≤ Real.exp (128 * x) := by
  have h := Real.sum_le_exp_of_nonneg hx 16
  have h0 : 0 ≤ ∑ m ∈ Finset.range 16, x ^ m / (m.factorial : ℝ) :=
    Finset.sum_nonneg (fun m _ => by positivity)
  calc (∑ m ∈ Finset.range 16, x ^ m / (m.factorial : ℝ)) ^ 128 ≤ (Real.exp x) ^ 128 :=
        pow_le_pow_left₀ h0 h 128
    _ = Real.exp (128 * x) := by
        rw [← Real.exp_nat_mul]; norm_num

/-- The per-interval step, in terms of the checker's naturals. -/
theorem term_nat (n : ℤ) (w : ℕ) (j : ℕ) (hj : j < 106) (hsq : sqOK n w j = true) :
    Real.log ((Qd n w j : ℝ) / (4 * 2 ^ 48)) ≤
      Real.log ((((ivlBN.getD j 0 : ℤ) : ℝ) / 2 ^ 40 - ((ivlAN.getD j 0 : ℤ) : ℝ) / 2 ^ 40) / 4) +
      Real.arcosh (max 1 |lcoord (((ivlAN.getD j 0 : ℤ) : ℝ) / 2 ^ 40) (((ivlBN.getD j 0 : ℤ) : ℝ) / 2 ^ 40)
        (((n : ℤ) : ℝ) / 2 ^ 40)|) := by
  have hlt := List.all_eq_true.mp ivl_lt_nat j (List.mem_range.mpr hj)
  have hAB : ivlAN.getD j 0 < ivlBN.getD j 0 := of_decide_eq_true hlt
  generalize hA : ivlAN.getD j 0 = A at *
  generalize hB : ivlBN.getD j 0 = B at *
  have hABr : (A : ℝ) < B := by exact_mod_cast hAB
  have hp : (0 : ℝ) < 2 ^ 40 := by positivity
  have hW : (Wd j : ℝ) = (B : ℝ) - A := by
    unfold Wd
    rw [hA, hB]
    have : ((B - A).toNat : ℤ) = B - A := Int.toNat_of_nonneg (by omega)
    have h2 : (((B - A).toNat : ℕ) : ℝ) = (((B - A).toNat : ℤ) : ℝ) := by norm_cast
    rw [h2, this]; push_cast; ring
  have hX : (Xd n j : ℝ) = |2 * (n : ℝ) - A - B| := by
    unfold Xd
    rw [hA, hB]
    rw [Nat.cast_natAbs, Int.cast_abs]; congr 1; push_cast; ring
  have hWpos : (0 : ℝ) < Wd j := by rw [hW]; linarith
  have hl : lcoord ((A : ℝ) / 2 ^ 40) ((B : ℝ) / 2 ^ 40) ((n : ℝ) / 2 ^ 40) =
      (2 * (n : ℝ) - A - B) / ((B : ℝ) - A) := by
    unfold lcoord; field_simp
  have hy : max 1 |lcoord ((A : ℝ) / 2 ^ 40) ((B : ℝ) / 2 ^ 40) ((n : ℝ) / 2 ^ 40)| =
      (Xm n j : ℝ) / Wd j := by
    rw [hl, abs_div, abs_of_pos (show 0 < (B : ℝ) - A by linarith), ← hX, ← hW]
    unfold Xm
    rw [Nat.cast_max]
    rcases le_total (Xd n j : ℝ) (Wd j) with h | h
    · rw [max_eq_right h, max_eq_left, div_self hWpos.ne']
      rw [div_le_one hWpos]; exact h
    · rw [max_eq_left h, max_eq_right]
      rw [one_le_div hWpos]; exact h
  have hw : ((B : ℝ) / 2 ^ 40 - (A : ℝ) / 2 ^ 40) = (Wd j : ℝ) / 2 ^ 40 := by
    rw [hW]; ring
  rw [hy, hw]
  have hmpos : (Wd j : ℝ) ≤ Xm n j := by exact_mod_cast le_max_right _ _
  have key := term_ge (w := (Wd j : ℝ) / 2 ^ 40) (y := (Xm n j : ℝ) / Wd j)
    (ρ := (rd w j : ℝ) / 2 ^ 48) (by positivity) ((one_le_div hWpos).mpr hmpos) (by positivity) ?_
  · have e : ((Wd j : ℝ) / 2 ^ 40 * ((Xm n j : ℝ) / Wd j) + (rd w j : ℝ) / 2 ^ 48) / 4 =
        (Qd n w j : ℝ) / (4 * 2 ^ 48) := by
      unfold Qd
      rw [Nat.shiftLeft_eq]
      push_cast
      field_simp
      ring
    rw [e] at key
    exact key
  · have hs := of_decide_eq_true hsq
    have hs' : ((rd w j : ℝ)) ^ 2 ≤ (((Xm n j : ℝ)) ^ 2 - (Wd j : ℝ) ^ 2) * 2 ^ 16 := by
      have h0 : (Wd j) ^ 2 ≤ (Xm n j) ^ 2 := Nat.pow_le_pow_left (le_max_right _ _) 2
      rw [Nat.shiftLeft_eq] at hs
      have h3 : ((rd w j ^ 2 : ℕ) : ℝ) ≤ (((Xm n j ^ 2 - Wd j ^ 2) * 2 ^ 16 : ℕ) : ℝ) := by exact_mod_cast hs
      push_cast [Nat.cast_sub h0] at h3
      have e16 : (2 : ℝ) ^ 16 = 65536 := by norm_num
      rw [e16]
      exact h3
    have e1 : ((Wd j : ℝ) / 2 ^ 40 * ((Xm n j : ℝ) / Wd j)) = (Xm n j : ℝ) / 2 ^ 40 := by
      field_simp
    rw [e1]
    have : ((rd w j : ℝ) / 2 ^ 48) ^ 2 = (rd w j : ℝ) ^ 2 / 2 ^ 96 := by ring
    rw [this]
    have e2 : ((Xm n j : ℝ) / 2 ^ 40) ^ 2 - ((Wd j : ℝ) / 2 ^ 40) ^ 2 =
        ((Xm n j : ℝ) ^ 2 - (Wd j : ℝ) ^ 2) * 2 ^ 16 / 2 ^ 96 := by ring
    rw [e2]
    exact div_le_div_of_nonneg_right hs' (by positivity)

/-- Positivity of the lower bounds. -/
theorem Qd_pos (n : ℤ) (w : ℕ) (j : ℕ) (hj : j < 106) : 0 < Qd n w j := by
  have hlt := List.all_eq_true.mp ivl_lt_nat j (List.mem_range.mpr hj)
  have hAB : ivlAN.getD j 0 < ivlBN.getD j 0 := of_decide_eq_true hlt
  have hW : 0 < Wd j := by unfold Wd; omega
  have h1 : Wd j ≤ Xm n j := le_max_right _ _
  unfold Qd
  rw [Nat.shiftLeft_eq]
  have : 0 < Xm n j * 2 ^ 8 := by
    have : 0 < Xm n j := lt_of_lt_of_le hW h1
    positivity
  exact lt_of_lt_of_le this (Nat.le_add_right _ _)

theorem Mc_pos : (0 : ℝ) < (Mc : ℝ) := by unfold Mc; norm_num

theorem tSum_eq (yn : ℕ) :
    (tSum yn : ℝ) = (Mc : ℝ) ^ 15 * (Nat.factorial 15 : ℝ) *
      ∑ m ∈ Finset.range 16, ((yn : ℝ) / Mc) ^ m / (m.factorial : ℝ) := by
  unfold tSum
  rw [lsum]
  push_cast
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro m hm
  have hm' : m ≤ 15 := by simp at hm; omega
  have hdiv : ((Nat.factorial 15 / Nat.factorial m : ℕ) : ℝ) = (Nat.factorial 15 : ℝ) / (Nat.factorial m : ℝ) :=
    Nat.cast_div (Nat.factorial_dvd_factorial hm') (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero m))
  rw [hdiv]
  have e : (Mc : ℝ) ^ 15 = (Mc : ℝ) ^ m * (Mc : ℝ) ^ (15 - m) := by
    rw [← pow_add]; congr 1; omega
  have hM := Mc_pos.ne'
  have hf : (Nat.factorial m : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero m)
  rw [e, div_pow]
  field_simp

theorem yOf_real (vn : ℤ) (h : 0 ≤ 2 * vn + 66104000000) :
    ((yOf vn : ℕ) : ℝ) = 2 * (vn : ℝ) + 66104000000 := by
  have e : ((yOf vn : ℕ) : ℤ) = 2 * vn + 66104000000 := by
    unfold yOf; exact Int.toNat_of_nonneg h
  have h2 : ((yOf vn : ℕ) : ℝ) = (((yOf vn : ℕ) : ℤ) : ℝ) := by norm_cast
  rw [h2, e]; push_cast; ring

theorem hv_of_knotOK (n vn : ℤ) (w : ℕ) (h : knotOK n vn w = true) :
    -chordL ivlLo ivlHi ((n : ℝ) / 2 ^ 40) - 8263 / 250 ≤ (vn : ℝ) / 10 ^ 9 := by
  unfold knotOK at h
  simp only [Bool.and_eq_true, decide_eq_true_eq, List.all_eq_true, List.mem_range] at h
  obtain ⟨⟨hy0, hsq⟩, hbig⟩ := h
  generalize hc0 : (4 * 2 ^ 48 : ℕ) = c0 at hbig
  generalize hck : (Mc ^ 15 * Nat.factorial 15 : ℕ) = ck at hbig
  have hc0r : (c0 : ℝ) = 4 * 2 ^ 48 := by rw [← hc0]; push_cast; ring
  have hckr : (ck : ℝ) = (Mc : ℝ) ^ 15 * (Nat.factorial 15 : ℝ) := by rw [← hck, Nat.cast_mul, Nat.cast_pow]
  have hc0pos : (0 : ℝ) < c0 := by rw [hc0r]; positivity
  have hckpos : (0 : ℝ) < ck := by rw [hckr]; exact mul_pos (pow_pos Mc_pos 15) (by exact_mod_cast Nat.factorial_pos 15)
  -- the 106 lower bounds
  set f : ℕ → ℝ := fun j => Real.log ((Qd n w j : ℝ) / (4 * 2 ^ 48)) with hf
  have hterm : ∀ c : Fin 53 × Fin 2, f (finProdFinEquiv c) ≤
      ivlGreen (ivlLo c) (ivlHi c) (((n : ℝ) / 2 ^ 40 : ℝ) : ℂ) + Real.log ((ivlHi c - ivlLo c) / 4) := by
    intro c
    have := term_nat n w (finProdFinEquiv c) (finProdFinEquiv c).2 (hsq _ (finProdFinEquiv c).2)
    rw [ivlGreen_real (ivlLo_lt c), add_comm]
    exact this
  have hsum1 : ∑ j ∈ Finset.range 106, f j ≤ ∑ c : Fin 53 × Fin 2,
      (ivlGreen (ivlLo c) (ivlHi c) (((n : ℝ) / 2 ^ 40 : ℝ) : ℂ) + Real.log ((ivlHi c - ivlLo c) / 4)) := by
    have e : ∑ j ∈ Finset.range 106, f j = ∑ c : Fin 53 × Fin 2, f (finProdFinEquiv c) := by
      rw [← Fin.sum_univ_eq_sum_range f (53 * 2)]
      exact (Equiv.sum_comp finProdFinEquiv (fun j : Fin (53 * 2) => f j)).symm
    rw [e]
    exact Finset.sum_le_sum (fun c _ => hterm c)
  -- the product
  have hQpos : ∀ j ∈ Finset.range 106, (Qd n w j : ℝ) / (4 * 2 ^ 48) ≠ 0 := by
    intro j hj
    have := Qd_pos n w j (Finset.mem_range.mp hj)
    have h' : (0 : ℝ) < Qd n w j := by exact_mod_cast this
    exact div_ne_zero h'.ne' (by norm_num)
  have hlogprod : ∑ j ∈ Finset.range 106, f j =
      Real.log ((prodQ n w : ℝ) / (c0 : ℝ) ^ 106) := by
    rw [hf]
    simp only
    rw [← Real.log_prod hQpos, Finset.prod_div_distrib, Finset.prod_const, Finset.card_range, hc0r]
    congr 2
    unfold prodQ
    rw [lprod]
    push_cast
    rfl
  have hPpos : (0 : ℝ) < prodQ n w := by
    unfold prodQ
    rw [lprod]
    have : 0 < ∏ i ∈ Finset.range 106, Qd n w i :=
      Finset.prod_pos (fun j hj => Qd_pos n w j (Finset.mem_range.mp hj))
    exact_mod_cast this
  -- exponential
  have hyr : ((yOf vn : ℕ) : ℝ) = 2 * (vn : ℝ) + 66104000000 := yOf_real vn hy0
  generalize hyn : yOf vn = yn at hyr hbig
  have hx0 : 0 ≤ (yn : ℝ) / Mc := div_nonneg (Nat.cast_nonneg _) Mc_pos.le
  have hexp := exp_lower ((yn : ℝ) / Mc) hx0
  have h128 : 128 * ((yn : ℝ) / Mc) = ((yn : ℝ) / 10 ^ 9) := by
    unfold Mc; push_cast; field_simp; ring
  rw [h128] at hexp
  set S : ℝ := ∑ m ∈ Finset.range 16, ((yn : ℝ) / Mc) ^ m / (m.factorial : ℝ) with hS
  have hbigR : (c0 : ℝ) ^ 106 * (ck : ℝ) ^ 128 ≤
      (prodQ n w : ℝ) * ((tSum yn : ℝ)) ^ 128 := by exact_mod_cast hbig
  rw [tSum_eq, ← hS, ← hckr, mul_pow] at hbigR
  have hK : (0 : ℝ) < (ck : ℝ) ^ 128 := pow_pos hckpos 128
  have hD : (0 : ℝ) < (c0 : ℝ) ^ 106 := pow_pos hc0pos 106
  have h1 : (c0 : ℝ) ^ 106 ≤ (prodQ n w : ℝ) * S ^ 128 := by
    have : (c0 : ℝ) ^ 106 * (ck : ℝ) ^ 128 ≤
        ((prodQ n w : ℝ) * S ^ 128) * (ck : ℝ) ^ 128 := by
      calc _ ≤ _ := hbigR
        _ = _ := by ring
    exact le_of_mul_le_mul_right this hK
  set y : ℝ := (yn : ℝ) / 10 ^ 9 with hy
  have hSe : S ^ 128 ≤ Real.exp y := hexp
  have h2 : (c0 : ℝ) ^ 106 ≤ (prodQ n w : ℝ) * Real.exp y :=
    le_trans h1 (mul_le_mul_of_nonneg_left hSe hPpos.le)
  have h3 : -y ≤ Real.log ((prodQ n w : ℝ) / (c0 : ℝ) ^ 106) := by
    rw [Real.le_log_iff_exp_le (div_pos hPpos hD), Real.exp_neg, inv_eq_one_div,
      div_le_div_iff₀ (Real.exp_pos y) hD]
    linarith
  have hy' : y = 2 * ((vn : ℝ) / 10 ^ 9) + 8263 / 125 := by
    rw [hy, hyr]; ring
  -- assemble
  have hL : chordL ivlLo ivlHi ((n : ℝ) / 2 ^ 40) =
      (1 / 2) * ∑ c : Fin 53 × Fin 2,
        (ivlGreen (ivlLo c) (ivlHi c) (((n : ℝ) / 2 ^ 40 : ℝ) : ℂ) + Real.log ((ivlHi c - ivlLo c) / 4)) := rfl
  rw [hL]
  have := h3.trans (hlogprod.symm.le.trans hsum1)
  rw [hy'] at this
  linarith

theorem hv_table : ∀ i, i < 866 → -chordL ivlLo ivlHi (kt i) - 8263 / 250 ≤ vt i := by
  intro i hi
  exact hv_of_knotOK _ _ _ (List.all_eq_true.mp hv_nat i (List.mem_range.mpr hi))

/-- **GP Corollary 7.2 for the frozen table**: `-L(t) ≤ C₀ + δ̂(t)` on the hull of the knots. -/
theorem neg_L_le_table {t : ℝ} (h0 : kt 0 ≤ t) (h1 : t ≤ kt 865) :
    -chordL ivlLo ivlHi t ≤ 8263 / 250 + pwl 865 kt vt t :=
  neg_L_le_pwl (by norm_num) kt_lt hconc_table (fun i hi => hv_table i (by omega)) h0 h1

end
