/-- Flat left end. -/
def loF (i : Fin (53 * 2)) : ℝ := ((ivlAN.getD i 0 : ℤ) : ℝ) / 2 ^ 40
/-- Flat right end. -/
def hiF (i : Fin (53 * 2)) : ℝ := ((ivlBN.getD i 0 : ℤ) : ℝ) / 2 ^ 40

/-- The interval list as `Fin 53 × Fin 2 → ℝ`. -/
def ivlLo (c : Fin 53 × Fin 2) : ℝ := loF (finProdFinEquiv c)
def ivlHi (c : Fin 53 × Fin 2) : ℝ := hiF (finProdFinEquiv c)

private theorem all_range {p : ℕ → Prop} [DecidablePred p]
    (h : (List.range 106).all (fun i => decide (p i)) = true) {i : ℕ} (hi : i < 106) : p i := by
  have := List.all_eq_true.mp h i (List.mem_range.mpr hi)
  simpa using this

theorem loF_lt (i : Fin (53 * 2)) : loF i < hiF i := by
  have h := all_range ivl_lt_nat (show (i : ℕ) < 106 from i.2)
  unfold loF hiF
  have : ((ivlAN.getD i 0 : ℤ) : ℝ) < ((ivlBN.getD i 0 : ℤ) : ℝ) := by exact_mod_cast h
  have h2 : (0 : ℝ) < 2 ^ 40 := by positivity
  exact div_lt_div_of_pos_right this h2

theorem ivlLo_lt (c : Fin 53 × Fin 2) : ivlLo c < ivlHi c := loF_lt _

theorem hiF_le_loF {i j : Fin (53 * 2)} (hij : i < j) : hiF i ≤ loF j := by
  have h1 := List.all_eq_true.mp ivl_ord_nat i (List.mem_range.mpr i.2)
  have h2 := List.all_eq_true.mp h1 j (List.mem_range.mpr j.2)
  have h' : ivlBN.getD i 0 ≤ ivlAN.getD j 0 := (of_decide_eq_true h2) (by exact_mod_cast hij)
  unfold loF hiF
  have : ((ivlBN.getD i 0 : ℤ) : ℝ) ≤ ((ivlAN.getD j 0 : ℤ) : ℝ) := by exact_mod_cast h'
  have h2 : (0 : ℝ) < 2 ^ 40 := by positivity
  exact div_le_div_of_nonneg_right this h2.le

theorem ivl_disj (c c' : Fin 53 × Fin 2) (hne : c ≠ c') :
    Disjoint (Ioo (ivlLo c) (ivlHi c)) (Ioo (ivlLo c') (ivlHi c')) := by
  have hne' : finProdFinEquiv c ≠ finProdFinEquiv c' := fun h => hne (finProdFinEquiv.injective h)
  rcases lt_or_gt_of_ne hne' with h | h
  · have := hiF_le_loF h
    rw [Set.disjoint_left]
    intro x hx hx'
    exact absurd (lt_of_lt_of_le hx.2 (this.trans hx'.1.le)) (lt_irrefl _)
  · have := hiF_le_loF h
    rw [Set.disjoint_left]
    intro x hx hx'
    exact absurd (lt_of_lt_of_le hx'.2 (this.trans hx.1.le)) (lt_irrefl _)

theorem ivl_lo_ge (c : Fin 53 × Fin 2) : -1 ≤ ivlLo c := by
  have h := all_range ivl_lo_nat (show ((finProdFinEquiv c : Fin (53*2)) : ℕ) < 106 from (finProdFinEquiv c).2)
  unfold ivlLo loF
  have : (-(2:ℝ)^40) ≤ ((ivlAN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) := by exact_mod_cast h
  rw [le_div_iff₀ (by positivity)]
  linarith

theorem ivl_hi_le (c : Fin 53 × Fin 2) : ivlHi c ≤ 1 := by
  have h := all_range ivl_hi_nat (show ((finProdFinEquiv c : Fin (53*2)) : ℕ) < 106 from (finProdFinEquiv c).2)
  unfold ivlHi hiF
  have : ((ivlBN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) ≤ (2:ℝ)^40 := by exact_mod_cast h
  rw [div_le_iff₀ (by positivity)]
  linarith

theorem ivl_zero (c : Fin 53 × Fin 2) : 0 ∉ Ioo (ivlLo c) (ivlHi c) := by
  have h := all_range ivl_zero_nat (show ((finProdFinEquiv c : Fin (53*2)) : ℕ) < 106 from (finProdFinEquiv c).2)
  intro hm
  unfold ivlLo ivlHi loF hiF at hm
  have hp : (0 : ℝ) < 2 ^ 40 := by positivity
  rcases h with h | h
  · have : (0:ℝ) ≤ ((ivlAN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) := by exact_mod_cast h
    have := div_nonneg this hp.le
    linarith [hm.1]
  · have : ((ivlBN.getD (finProdFinEquiv c) 0 : ℤ) : ℝ) ≤ 0 := by exact_mod_cast h
    have := div_nonpos_of_nonpos_of_nonneg this hp.le
    linarith [hm.2]

/-! ### The hypotheses of `IntervalNodes` for design C (`d₀ = 53`) -/

theorem tauI_injective_data (N : ℕ) : Function.Injective (tauI ivlLo ivlHi N) :=
  tauI_injective ivlLo ivlHi ivlLo_lt ivl_disj N

theorem tauI_mem_data (N : ℕ) (a : Fin (53 * N)) : tauI ivlLo ivlHi N a ∈ Ioo (-1 : ℝ) 1 :=
  tauI_mem ivlLo ivlHi ivlLo_lt ivl_lo_ge ivl_hi_le N a

theorem tauI_ne_zero_data (N : ℕ) (a : Fin (53 * N)) : tauI ivlLo ivlHi N a ≠ 0 :=
  tauI_ne_zero ivlLo ivlHi ivlLo_lt ivl_zero N a

