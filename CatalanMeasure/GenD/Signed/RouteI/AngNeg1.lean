def DD : AngAux.AuxD := ⟨shS, aLD, bLD⟩

theorem rad_ok : radPass 192 NRD (sigQ 1) rHD = true := by
  -- kcost: exp series of 28 terms, twice, at 192-bit target; under 1 s.
  decide +kernel

theorem a1_ok : alphaAll (alpha1OK 192 rHD eBu (kAD : ℚ)) TL alD = true := by
  -- kcost: 116 bins, about 15 Rat operations each; under 1 s.
  decide +kernel

theorem a2_ok : alphaAll (alpha2OK 192 rHD) TL al2D = true := by
  -- kcost: 116 bins, about 10 Rat operations each; under 1 s.
  decide +kernel

theorem const_ok : constOKneg 192 eBu rHD Hb1 Hb2 TL cnumD = true := by
  -- kcost: 232 logs of rationals (about 20 Rat operations each) plus sums; a few s.
  decide +kernel

theorem cb1_ok : cb1 192 eAu eBu (kAD : ℚ) rHD TL ≤ cbb1 := by
  -- kcost: 116 bins, a dozen Rat operations each; under 1 s.
  decide +kernel

theorem cb2_ok : cb2 192 eAu eBu rHD TL ≤ cbb2 := by
  -- kcost: 116 bins, a dozen Rat operations each; under 1 s.
  decide +kernel

theorem hgl_eq : glFastNeg 192 alD al2D (TL.map BD.s0) cnumD 511 = glL := by
  -- kcost: 2 x 116 bins x 512 power steps in 192-bit integer arithmetic; about 1 s at 29 bins (measured).
  decide +kernel

theorem hgl_len : glL.length ≤ 511 + 1 := by
  -- kcost: list length, 512 steps.
  decide +kernel

theorem hgl_ne : glL ≠ [] := by
  -- kcost: one constructor test.
  decide +kernel

theorem aux_rad : AngAux.auxRadCheck Sign.neg 26 1 DD = true := by
  -- kcost: 32 streams, 2 exp enclosures of 26 terms each; under 1 s.
  decide +kernel

theorem haux_eq : AngAux.auxList Sign.neg 1 DD = auxL := by
  -- kcost: 32 streams x 384 steps, 385 Rat floors; about 6 s at 32 streams (measured).
  decide +kernel

theorem heps : eGneg 192 511 Hb1 Hb2 cbb1 cbb2 + AngAux.eAq Sign.neg DD + AngAux.tailQ Sign.neg DD.sh ≤ epsQ := by
  -- kcost: 2 x 32-term rational sums, one rational 385th power; under 1 s.
  decide +kernel

theorem hconv : AngularCap.combineP (AngularCap.Nlist glL) auxL (2 ^ 192 * 2 ^ (glL.length - 1)) AngAux.adN = pL := by
  -- kcost: Nlist on 512 coefficients, O(512^2) big additions; about 1 s (measured).
  decide +kernel

theorem hkron : KronSquare.KronSquare KD pL qL [] rL ((2 ^ 192 * 2 ^ (glL.length - 1)) * AngAux.adN) (5463909/100000000) epsQ := by
  -- kcost: packed square of 512 coefficients at 1538 bits and a 1023-term identity; about 50 s (measured).
  decide +kernel

open CatalanMeasure.Signed.ChebSquare in
theorem hmarg : l1 rL.tail < rL.headD 0 := by
  -- kcost: 1023 absolute values; about 7 s (measured).
  decide +kernel

theorem gas_ok : AngularSource.Binning (capSource.gas Sign.neg) ((binsY TL).map reflectL) ∧
    ∑ j ∈ Finset.range (511 + 1), |AngularCap.gasA capSource Sign.neg 1 ((binsY TL).map reflectL) j -
      (((glFastNeg 192 alD al2D (TL.map BD.s0) cnumD 511).getD j 0 : ℤ) : ℝ) / ((2 ^ 192 : ℕ) : ℝ)| ≤
    ((eGneg 192 511 Hb1 Hb2 cbb1 cbb2 : ℚ) : ℝ) :=
  gas_final_neg capSource 1 part_neg capSource_neg_hi (capSource_neg_w CatalanMeasure.GenD.Signed.RouteI.AngMomNeg128.gasw_pos) mom_spec
    (rad_enc capSource 1 (capSource_sigma 1) rad_ok) a1_ok a2_ok const_ok cb1_ok cb2_ok 511

/-- **The certificate** of the negative species at radius index 1. -/
def angNeg1 : AngularCap.AngRadiusCert capSource Sign.neg 1 (5463909/100000000) :=
  AngAux.angRadius_of_kron Sign.neg 1 26 (5463909/100000000) ((binsY TL).map reflectL) gas_ok.1 511 (by decide)
    glL (2 ^ 192) (by positivity) hgl_len hgl_ne (eGneg 192 511 Hb1 Hb2 cbb1 cbb2)
    (by rw [← hgl_eq]; exact gas_ok.2)
    DD shared_ok (AngAux.auxRadOK_of_check aux_rad) auxL pL qL [] rL haux_eq epsQ heps hconv KD hkron hmarg

end

end CatalanMeasure.GenD.Signed.RouteI.AngNeg1
