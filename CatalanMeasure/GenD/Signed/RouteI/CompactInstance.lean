/-- Total uniform tail `epsilon`, negative ordinary field at `x=-u`, `u in [19501/10^5,1]`. -/
def negEps : ℚ := 1758790719139411 / 576460752303423488

/-- Kronecker radix exponent, negative ordinary field at `x=-u`, `u in [19501/10^5,1]`: `8 l1(q)^2 < 2^K`, `l1(q) < 2^102`. -/
def negK : ℕ := 207

theorem D_pos : 0 < D := by unfold D; norm_num

theorem capQ_real : ((capQ : ℚ) : ℝ) = -9783 / 10000 := by
  unfold capQ; push_cast; norm_num

/-! ### The three exact square identities -/

theorem near_kron : KronSquare nearK nearP nearQ [] nearR D capQ nearEps := by
  -- kcost: see module header; 3 kmul of 128 x 128 digits at K <= 210, about 1 s.
  decide +kernel

theorem pos_kron : KronSquare posK posP posQ [] posR D capQ posEps := by
  -- kcost: as above, remainder of length 255.
  decide +kernel

theorem neg_kron : KronSquare negK negP negQ [] negR D capQ negEps := by
  -- kcost: as above, remainder of length 255.
  decide +kernel

theorem near_identity : SquareIdentity nearP nearQ [] nearR D capQ nearEps :=
  near_kron.squareIdentity

theorem pos_identity : SquareIdentity posP posQ [] posR D capQ posEps :=
  pos_kron.squareIdentity

theorem neg_identity : SquareIdentity negP negQ [] negR D capQ negEps :=
  neg_kron.squareIdentity

/-! ### `hm` and the margins -/

theorem near_hm : l1 nearR.tail < nearR.headD 0 := by
  -- kcost: one pass over 134 integers.
  decide +kernel

theorem pos_hm : l1 posR.tail < posR.headD 0 := by
  -- kcost: one pass over 254 integers.
  decide +kernel

theorem neg_hm : l1 negR.tail < negR.headD 0 := by
  -- kcost: one pass over 254 integers.
  decide +kernel

theorem margin_ge {r : List ℤ} {a b : ℤ} (hb : 0 < b)
    (h : a * (D : ℤ) ≤ b * (r.headD 0 - l1 r.tail)) : (a : ℝ) / b ≤ margin r D := by
  have hD : (0 : ℝ) < D := by exact_mod_cast D_pos
  have hb' : (0 : ℝ) < b := by exact_mod_cast hb
  have h' : (a : ℝ) * D ≤ b * (((r.headD 0 : ℤ) : ℝ) - ((l1 r.tail : ℤ) : ℝ)) := by
    exact_mod_cast h
  unfold margin
  rw [div_le_div_iff₀ hb' hD]
  linarith

theorem near_margin : (187 : ℝ) / 10000 ≤ margin nearR D := by
  -- kcost: 0.01 s estimated (one integer inequality, about 130 steps, 100-bit entries).
  have := margin_ge (r := nearR) (a := 187) (b := 10000) (by norm_num) (by decide +kernel)
  simpa using this

theorem pos_margin : (7 : ℝ) / 100000 ≤ margin posR D := by
  -- kcost: 0.01 s estimated (one integer inequality, about 130 steps, 100-bit entries).
  have := margin_ge (r := posR) (a := 7) (b := 100000) (by norm_num) (by decide +kernel)
  simpa using this

theorem neg_margin : (3 : ℝ) / 1000 ≤ margin negR D := by
  -- kcost: 0.01 s estimated (one integer inequality, about 130 steps, 100-bit entries).
  have := margin_ge (r := negR) (a := 3) (b := 1000) (by norm_num) (by decide +kernel)
  simpa using this

/-! ### The source-to-polynomial hypotheses (named, not proved here) -/

/-- Positive ordinary `hf`: the source field is below the degree-128 majorant plus its tail. -/
def PosHf (S : CapSource) (t : Trunc) : Prop :=
  ∀ u ∈ Icc (98749 / 1000000 : ℝ) 1, S.ordField t Sign.pos u ≤
    chebSum posP D (affine (98749 / 1000000) u) + (posEps : ℝ)

/-- Negative ordinary `hf` at `x = -u`. -/
def NegHf (S : CapSource) (t : Trunc) : Prop :=
  ∀ u ∈ Icc (19501 / 100000 : ℝ) 1, S.ordField t Sign.neg (-u) ≤
    chebSum negP D (affine (19501 / 100000) u) + (negEps : ℝ)

/-- Near `hf` on `[1/10,1]`. -/
def NearHf (S : CapSource) (t : Trunc) : Prop :=
  ∀ y ∈ Icc (1 / 10 : ℝ) 1, S.nearField t y ≤
    chebSum nearP D (affine (1 / 10) y) + (nearEps : ℝ)

/-! ### Source numerics from the seed and the gas mass (generic in `S`)

`strength` and `curvature` depend only on `r = q^2 = exp(-eps)`; `auxTail (finite 384)` is
`q^385 *` a bounded factor `*` `auxMass`. So the four numeric hypotheses of `near_cap` follow
from `1/10 <= eps <= 3/20` (the real source has `eps = 0.1080`) and `63/100 <= gas mass`
(the real positive gas mass is `0.6349`, so `auxMass pos = 0.3651`). -/

theorem q_sq_eq (S : CapSource) : S.q ^ 2 = Real.exp (-S.eps) := by
  unfold CapSource.q
  rw [sq, ← Real.exp_add]
  congr 1
  ring

theorem q_pos (S : CapSource) : 0 < S.q := Real.exp_pos _

theorem r_bounds (S : CapSource) (he : S.eps ≤ 3 / 20) (hp : 0 < S.eps) :
    17 / 20 ≤ S.q ^ 2 ∧ S.q ^ 2 < 1 := by
  rw [q_sq_eq]
  constructor
  · have := Real.add_one_le_exp (-S.eps)
    linarith
  · have h := Real.exp_lt_exp.mpr (show -S.eps < 0 by linarith)
    rwa [Real.exp_zero] at h

theorem strength_curvature_le (S : CapSource) (hp : 0 < S.eps) (he : S.eps ≤ 3 / 20) :
    S.strength ≤ 1 / 10 ∧ S.curvature ≤ 1 / 10 := by
  obtain ⟨h1, h2⟩ := r_bounds S he hp
  set r : ℝ := S.q ^ 2 with hr
  have h0 : 0 < r := by linarith
  have hr1 : 0 < 1 - r := by linarith
  have hA : 0 < 1 + 4 * r + r ^ 2 := by positivity
  have hN : S.normalizer = (1 + 4 * r + r ^ 2) / (1 - r) ^ 2 := by
    unfold CapSource.normalizer; rw [← hr]
  have hs : S.strength = 3 * (1 - r ^ 2) / (2 * (1 + 4 * r + r ^ 2)) := by
    unfold CapSource.strength
    rw [hN, ← hr]
    field_simp
    ring
  have hc : S.curvature = (1 - r) ^ 2 / (2 * (1 + 4 * r + r ^ 2)) := by
    unfold CapSource.curvature
    rw [hN]
    field_simp
  constructor
  · rw [hs, div_le_iff₀ (by positivity)]
    nlinarith
  · rw [hc, div_le_iff₀ (by positivity)]
    nlinarith

theorem q_le (S : CapSource) (he : 1 / 10 ≤ S.eps) : S.q ≤ 24 / 25 := by
  unfold CapSource.q
  have h1 : Real.exp (-S.eps / 2) ≤ Real.exp (-(1 / 20)) :=
    Real.exp_le_exp.mpr (by linarith)
  have h2 : (25 / 24 : ℝ) ≤ Real.exp (1 / 20) := by
    have := Real.add_one_le_exp (1 / 20 : ℝ)
    linarith
  have h3 : Real.exp (-(1 / 20)) = (Real.exp (1 / 20))⁻¹ := Real.exp_neg _
  have h4 : (Real.exp (1 / 20))⁻¹ ≤ 24 / 25 := by
    rw [inv_le_comm₀ (Real.exp_pos _) (by norm_num)]
    linarith
  linarith

theorem auxTail_pos_le (S : CapSource) (hs : S.strength ≤ 1 / 10) (hc : S.curvature ≤ 1 / 10)
    (hs0 : 0 ≤ S.strength) (hc0 : 0 ≤ S.curvature)
    (he : 1 / 10 ≤ S.eps) (hM : S.auxMass Sign.pos ≤ 37 / 100) (hM0 : 0 ≤ S.auxMass Sign.pos) :
    S.auxTail (Trunc.finite 384) Sign.pos ≤ 1 / 100 := by
  have hq := q_le S he
  have hq0 := q_pos S
  set q := S.q with hqdef
  have hg0 : 0 < 1 - q := by linarith
  have hg : 1 / (1 - q) ≤ 25 := by
    rw [div_le_iff₀ hg0]; linarith
  have hg1 : 0 ≤ 1 / (1 - q) := by positivity
  have hpow : q ^ (384 + 1) ≤ (24 / 25) ^ 385 := pow_le_pow_left₀ hq0.le hq _
  have hpow' : ((24 : ℝ) / 25) ^ 385 ≤ 1 / 100000 := by
    have h35 : ((24 : ℝ) / 25) ^ 35 ≤ 1 / 4 := by norm_num
    have h11 : (((24 : ℝ) / 25) ^ 35) ^ 11 ≤ (1 / 4) ^ 11 :=
      pow_le_pow_left₀ (by positivity) h35 11
    have e : ((24 : ℝ) / 25) ^ 385 = (((24 : ℝ) / 25) ^ 35) ^ 11 := by rw [← pow_mul]
    rw [e]
    refine h11.trans ?_
    norm_num
  have hpow0 : 0 ≤ q ^ (384 + 1) := by positivity
  unfold CapSource.auxTail
  have hne : ¬ (Sign.pos = Sign.neg) := by decide
  simp only [hne, ite_false, mul_one]
  push_cast
  have hB : ((1 / ((384 : ℝ) + 1) + S.strength) * (1 / (1 - q)) +
      S.curvature * (((384 : ℝ) + 1) * (1 / (1 - q)) + q * (1 / (1 - q)) ^ 2)) ≤ 2000 := by
    have e1 : (1 / ((384 : ℝ) + 1) + S.strength) * (1 / (1 - q)) ≤ (1 / 385 + 1 / 10) * 25 := by
      apply mul_le_mul _ hg hg1 (by norm_num)
      norm_num; linarith
    have e2 : S.curvature * (((384 : ℝ) + 1) * (1 / (1 - q)) + q * (1 / (1 - q)) ^ 2) ≤
        1 / 10 * (385 * 25 + 1 * 25 ^ 2) := by
      apply mul_le_mul hc _ (by positivity) (by norm_num)
      have a1 : (385 : ℝ) * (1 / (1 - q)) ≤ 385 * 25 := by linarith
      have a2 : q * (1 / (1 - q)) ^ 2 ≤ 1 * 25 ^ 2 := by
        apply mul_le_mul (by linarith) _ (by positivity) (by norm_num)
        exact pow_le_pow_left₀ hg1 hg 2
      linarith
    linarith
  have hB0 : 0 ≤ ((1 / ((384 : ℝ) + 1) + S.strength) * (1 / (1 - q)) +
      S.curvature * (((384 : ℝ) + 1) * (1 / (1 - q)) + q * (1 / (1 - q)) ^ 2)) := by positivity
  calc q ^ (384 + 1) * ((1 / ((384 : ℝ) + 1) + S.strength) * (1 / (1 - q)) +
        S.curvature * (((384 : ℝ) + 1) * (1 / (1 - q)) + q * (1 / (1 - q)) ^ 2)) *
        S.auxMass Sign.pos
      ≤ (1 / 100000) * 2000 * (37 / 100) := by
        apply mul_le_mul (mul_le_mul (hpow.trans hpow') hB hB0 (by norm_num)) hM hM0
          (by norm_num)
    _ ≤ 1 / 100 := by norm_num

/-! ### The `ord` and `near` caps -/

/-- Ordinary cap constants, both signs. -/
noncomputable def ordCapC : Sign → ℝ := fun _ => -9783 / 10000

/-- Near cap constant `-9783/10000 - 187/10000`. -/
noncomputable def nearCapC : ℝ := -997 / 1000

theorem ord_pos (S : CapSource) (t : Trunc) (h : PosHf S t) (d : ℝ → ℝ) (G : ℝ → Prop) (c : ℝ)
    (hd : ∀ u ∈ Icc (98749 / 1000000 : ℝ) 1, G u → d u ≤ c - (-9783 / 10000)) :
    S.OrdCap t Sign.pos d G c :=
  ordCap_pos_of_square S t posP posQ [] posR D D_pos capQ posEps pos_identity pos_hm h d G c
    (fun u hu hG => by have := hd u hu hG; rwa [capQ_real])

theorem ord_neg (S : CapSource) (t : Trunc) (h : NegHf S t) (d : ℝ → ℝ) (G : ℝ → Prop) (c : ℝ)
    (hd : ∀ u ∈ Icc (19501 / 100000 : ℝ) 1, G (-u) → d (-u) ≤ c - (-9783 / 10000)) :
    S.OrdCap t Sign.neg d G c :=
  ordCap_neg_of_square S t negP negQ [] negR D D_pos capQ negEps neg_identity neg_hm h d G c
    (fun u hu hG => by have := hd u hu hG; rwa [capQ_real])

/-- `S.OrdCap t σ d G (c σ)` for both signs (the `ord` field of `CapBundle`), where the node
correction is bounded by `c σ + 9783/10000` on the window. -/
theorem ord_caps (S : CapSource) (t : Trunc) (hp : PosHf S t) (hn : NegHf S t) (d : ℝ → ℝ)
    (G : ℝ → Prop) (c : Sign → ℝ)
    (hdp : ∀ u ∈ Icc (98749 / 1000000 : ℝ) 1, G u → d u ≤ c Sign.pos - (-9783 / 10000))
    (hdn : ∀ u ∈ Icc (19501 / 100000 : ℝ) 1, G (-u) → d (-u) ≤ c Sign.neg - (-9783 / 10000)) :
    ∀ σ, S.OrdCap t σ d G (c σ) := by
  intro σ
  cases σ
  · exact ord_neg S t hn d G _ hdn
  · exact ord_pos S t hp d G _ hdp

/-- `S.NearCap t d G c`: the `near` field of `CapBundle`, with `d ≤ c - nearCapC` on the window. -/
theorem near_cap (S : CapSource) (hS : S.Admissible) (t : Trunc)
    (hs : S.strength ≤ 1 / 10) (hc : S.curvature ≤ 1 / 10)
    (hM : S.auxMass Sign.pos ≤ 37 / 100) (hE : S.auxTail t Sign.pos ≤ 1 / 100)
    (hκ : (1 / 10 : ℝ) ≤ kappa Sign.pos)
    (h : NearHf S t) (d : ℝ → ℝ) (G : ℝ → Prop) (c : ℝ)
    (hd : ∀ y ∈ Ioo (0 : ℝ) 1, G y → d y ≤ c - nearCapC) : S.NearCap t d G c := by
  have hcap : (-9783 / 10000 : ℝ) ≤ ((capQ : ℚ) : ℝ) := by rw [capQ_real]
  have e : ((capQ : ℚ) : ℝ) - 187 / 10000 = nearCapC := by
    rw [capQ_real]; unfold nearCapC; norm_num
  exact nearCap_of_square S hS t hs hc hM hE nearP nearQ [] nearR D D_pos capQ nearEps
    near_identity h (187 / 10000) (by simpa using near_margin) (by norm_num) hcap hκ d G c
    (fun y hy hG => by have := hd y hy hG; rwa [← e] at this)

/-- The `ord` and `near` fields of `CapBundle` at `Trunc.finite 384`. -/
theorem compact_caps_384 (S : CapSource) (hS : S.Admissible)
    (hs : S.strength ≤ 1 / 10) (hc : S.curvature ≤ 1 / 10)
    (hM : S.auxMass Sign.pos ≤ 37 / 100)
    (hE : S.auxTail (Trunc.finite 384) Sign.pos ≤ 1 / 100) (hκ : (1 / 10 : ℝ) ≤ kappa Sign.pos)
    (hp : PosHf S (Trunc.finite 384)) (hn : NegHf S (Trunc.finite 384))
    (hy : NearHf S (Trunc.finite 384)) (d : ℝ → ℝ) (G : ℝ → Prop) (c : Sign → ℝ) (cn : ℝ)
    (hdp : ∀ u ∈ Icc (98749 / 1000000 : ℝ) 1, G u → d u ≤ c Sign.pos - (-9783 / 10000))
    (hdn : ∀ u ∈ Icc (19501 / 100000 : ℝ) 1, G (-u) → d (-u) ≤ c Sign.neg - (-9783 / 10000))
    (hdy : ∀ y ∈ Ioo (0 : ℝ) 1, G y → d y ≤ cn - nearCapC) :
    (∀ σ, S.OrdCap (Trunc.finite 384) σ d G (c σ)) ∧ S.NearCap (Trunc.finite 384) d G cn :=
  ⟨ord_caps S _ hp hn d G c hdp hdn, near_cap S hS _ hs hc hM hE hκ hy d G cn hdy⟩

/-- The `ord` and `near` fields of `CapBundle` at `Trunc.finite 384`, with the numeric hypotheses
replaced by plain facts: `1/10 <= eps <= 3/20` and `63/100 <=` positive gas mass. -/
theorem compact_caps_384_seed (S : CapSource) (hS : S.Admissible)
    (hε1 : 1 / 10 ≤ S.eps) (hε2 : S.eps ≤ 3 / 20)
    (hmass : 63 / 100 ≤ massL (S.gas Sign.pos)) (hκ : (1 / 10 : ℝ) ≤ kappa Sign.pos)
    (hp : PosHf S (Trunc.finite 384)) (hn : NegHf S (Trunc.finite 384))
    (hy : NearHf S (Trunc.finite 384)) (d : ℝ → ℝ) (G : ℝ → Prop) (c : Sign → ℝ) (cn : ℝ)
    (hdp : ∀ u ∈ Icc (98749 / 1000000 : ℝ) 1, G u → d u ≤ c Sign.pos - (-9783 / 10000))
    (hdn : ∀ u ∈ Icc (19501 / 100000 : ℝ) 1, G (-u) → d (-u) ≤ c Sign.neg - (-9783 / 10000))
    (hdy : ∀ y ∈ Ioo (0 : ℝ) 1, G y → d y ≤ cn - nearCapC) :
    (∀ σ, S.OrdCap (Trunc.finite 384) σ d G (c σ)) ∧ S.NearCap (Trunc.finite 384) d G cn := by
  have hpos : 0 < S.eps := hS.eps_pos
  obtain ⟨hs, hc⟩ := strength_curvature_le S hpos hε2
  have hM : S.auxMass Sign.pos ≤ 37 / 100 := by rw [hS.aux_pos_mass]; linarith
  have hM0 : 0 ≤ S.auxMass Sign.pos := by
    unfold CapSource.auxMass
    exact List.sum_nonneg (by
      intro x hx
      obtain ⟨e, he, rfl⟩ := List.mem_map.mp hx
      exact e.w_nonneg)
  have hs0 : 0 ≤ S.strength := by
    unfold CapSource.strength CapSource.normalizer
    obtain ⟨h1, h2⟩ := r_bounds S hε2 hpos
    have : 0 < 1 - S.q ^ 2 := by linarith
    positivity
  have hc0 : 0 ≤ S.curvature := by
    unfold CapSource.curvature CapSource.normalizer
    obtain ⟨h1, h2⟩ := r_bounds S hε2 hpos
    have : 0 < 1 - S.q ^ 2 := by linarith
    positivity
  exact compact_caps_384 S hS hs hc hM (auxTail_pos_le S hs hc hs0 hc0 hε1 hM hM0) hκ hp hn hy d G c cn hdp hdn hdy

/-- Exact-field version (via `Dominates`, `CompactSource`). -/
theorem compact_caps_exact (S : CapSource) (hS : S.Admissible)
    (hs : S.strength ≤ 1 / 10) (hc : S.curvature ≤ 1 / 10)
    (hM : S.auxMass Sign.pos ≤ 37 / 100)
    (hE : S.auxTail (Trunc.finite 384) Sign.pos ≤ 1 / 100) (hκ : (1 / 10 : ℝ) ≤ kappa Sign.pos)
    (hp : PosHf S (Trunc.finite 384)) (hn : NegHf S (Trunc.finite 384))
    (hy : NearHf S (Trunc.finite 384)) (d : ℝ → ℝ) (G : ℝ → Prop) (c : Sign → ℝ) (cn : ℝ)
    (hdp : ∀ u ∈ Icc (98749 / 1000000 : ℝ) 1, G u → d u ≤ c Sign.pos - (-9783 / 10000))
    (hdn : ∀ u ∈ Icc (19501 / 100000 : ℝ) 1, G (-u) → d (-u) ≤ c Sign.neg - (-9783 / 10000))
    (hdy : ∀ y ∈ Ioo (0 : ℝ) 1, G y → d y ≤ cn - nearCapC) :
    (∀ σ, S.OrdCap Trunc.exact σ d G (c σ)) ∧ S.NearCap Trunc.exact d G cn := by
  obtain ⟨h1, h2⟩ := compact_caps_384 S hS hs hc hM hE hκ hp hn hy d G c cn hdp hdn hdy
  exact ⟨fun σ => ordCap_exact S hS (h1 σ), nearCap_exact S hS h2⟩

