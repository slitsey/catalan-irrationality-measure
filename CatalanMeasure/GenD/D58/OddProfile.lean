module

public import CatalanMeasure.GenD.OddProfile

@[expose] public section

/-!
# Odd-prime profile of the design (58,9,3,5,3) (instance file)

Numerals only.  `H = 78 N`, `L = 70 N`, `A = 22 N`.  The continuum loss (generated by
`lean-pkg/PA/gen_odd.py`, which also reproduces the 7 segments of the P20 design) has 8 segments;
it is the hinge profile `f58`.  Every segment is identified by named linear facts (`omega`).
-/

namespace CatalanMeasure.GenD
namespace D58
namespace Odd

open CatalanMeasure.Parametric OAI.InternalCatalan PL OddProfile

noncomputable section

/-- The displaced design in the units `n = 58 N`. -/
def design : Parameters := ⟨58, 9, 3, 5, 3⟩

theorem design_admissible : Admissible design := by
  norm_num [Admissible, design]

theorem design_H (N : ℕ) : design.H N = 78 * N := by
  simp only [Parameters.H, Parameters.C, Parameters.L, Parameters.n, Parameters.b, Parameters.q,
    Parameters.g, Parameters.h, design]
  omega

theorem design_L (N : ℕ) : design.L N = 70 * N := by
  simp only [Parameters.L, Parameters.n, Parameters.b, Parameters.q, design]
  omega

theorem design_A (N : ℕ) : design.A N = 22 * N := by
  simp only [Parameters.A, Parameters.b, Parameters.q, Parameters.g, design]
  omega

/-- The segmentwise loss. -/
def lossNat (N p : ℕ) : ℕ :=
  if 2 * p ≤ 59 * N then 116 * N else
  if 2 * p ≤ 69 * N then 175 * N - 2 * p else
  if p ≤ 39 * N then 106 * N else
  if 2 * p ≤ 81 * N then 184 * N - 2 * p else
  if p ≤ 48 * N then 265 * N - 4 * p else
  if p ≤ 69 * N then 217 * N - 3 * p else
  if p ≤ 70 * N then 148 * N - 2 * p else 78 * N - p

theorem lower_eq {N p : ℕ} (h : 2 * p ≤ 78 * N) : lowerPrimeLoss design N p = lossNat N p := by
  rw [lowerPrimeLoss_eq]
  simp only [design_H, design_L, design_A]
  simp only [Parameters.n, Parameters.b, Parameters.q, design]
  unfold lossNat
  split_ifs <;> omega

theorem upper_eq {N p : ℕ} (h : 78 * N ≤ 2 * p) (hp : p ≤ 78 * N) :
    upperPrimeLoss design N p = lossNat N p := by
  rw [upperPrimeLoss_eq]
  simp only [upperR, upperPd, upperE, design_H, design_L, design_A]
  simp only [Parameters.n, Parameters.b, Parameters.q, design]
  unfold lossNat
  split_ifs <;> omega

/-- The hinge profile of the loss, in units of `N`. -/
def f58 : Prof :=
  ⟨116, 0, [(-2, 59/2), (2, 69/2), (-2, 39), (-2, 81/2), (1, 48), (1, 69), (1, 70)]⟩

macro "seg_ker" : tactic =>
  `(tactic| (intro wt hwt
             simp only [f58, List.mem_cons, List.not_mem_nil, or_false] at hwt
             rcases hwt with h | h | h | h | h | h | h <;> (subst h; norm_num)))

macro "seg_facts" : tactic =>
  `(tactic| norm_num [f58, PL.hingeSlope, PL.hingeIntercept])

theorem lossNat_cast {N p : ℕ} (hN : 0 < N) (hp : p ≤ 78 * N) :
    (lossNat N p : ℝ) = N * f58.eval ((p : ℝ) / N) := by
  unfold lossNat
  split_ifs with h1 h2 h3 h4 h5 h6 h7
  · exact loss_eq_segment f58 hN 116 0 (by omega) (u1 := 0) (w1 := 1) (u2 := 59) (w2 := 2)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)
  · exact loss_eq_segment f58 hN 175 (-2) (by omega) (u1 := 59) (w1 := 2) (u2 := 69) (w2 := 2)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)
  · exact loss_eq_segment f58 hN 106 0 (by omega) (u1 := 69) (w1 := 2) (u2 := 39) (w2 := 1)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)
  · exact loss_eq_segment f58 hN 184 (-2) (by omega) (u1 := 39) (w1 := 1) (u2 := 81) (w2 := 2)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)
  · exact loss_eq_segment f58 hN 265 (-4) (by omega) (u1 := 81) (w1 := 2) (u2 := 48) (w2 := 1)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)
  · exact loss_eq_segment f58 hN 217 (-3) (by omega) (u1 := 48) (w1 := 1) (u2 := 69) (w2 := 1)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)
  · exact loss_eq_segment f58 hN 148 (-2) (by omega) (u1 := 69) (w1 := 1) (u2 := 70) (w2 := 1)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)
  · exact loss_eq_segment f58 hN 78 (-1) (by omega) (u1 := 70) (w1 := 1) (u2 := 78) (w2 := 1)
      (by norm_num) (by norm_num) (by omega) (by omega) (by seg_ker) (by seg_facts) (by seg_facts)

theorem side_of {N p : ℕ} (hN : 0 < N) (h : design.H N ≤ 2 * p) : UpperSide design N p := by
  rw [design_H] at h
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [design_A]; omega
  · rw [design_H, design_L]; omega
  · simp only [Parameters.b, design]; omega
  · rw [design_H, design_L]; omega

/-- The odd-prime valuation bound for the displaced design: `v_p(det) ≥ -N f58(p/N)`. -/
theorem odd_valuation_d58 {N p : ℕ} [Fact p.Prime]
    (hN : 0 < N) (hp2 : p ≠ 2) (hHsq : 78 * N < p ^ 2) (hpH : p ≤ 78 * N)
    (z : ℚ) (hz : (z.den : ZMod p) ≠ 0) :
    -((N : ℝ) * f58.eval ((p : ℝ) / N)) ≤ (padicValRat p (determinantRat design z N) : ℝ) := by
  refine odd_valuation_profile design design_admissible f58 ?_ ?_ hN hp2
    (by rw [design_H]; exact hHsq) (by rw [design_H]; exact hpH) (side_of hN) z hz
  · intro N p hN h
    rw [design_H] at h
    rw [lower_eq h]
    have : p ≤ 78 * N := by omega
    exact (lossNat_cast hN this).le
  · intro N p hN h hp
    rw [design_H] at h hp
    have h' : 78 * N ≤ 2 * p := by omega
    rw [upper_eq h' hp]
    exact (lossNat_cast hN hp).le

end
end Odd
end D58
end CatalanMeasure.GenD
