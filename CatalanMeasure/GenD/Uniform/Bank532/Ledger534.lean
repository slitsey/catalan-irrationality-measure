theorem partial_growth534 (H : Hosts534) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ N : ℕ in atTop,
      Real.log (((canonicalNormalizer design D58.Odd.design_admissible (famLB (fams534 H)) 79
        (by rw [D58.Odd.design_H]; norm_num)).D N : ℕ) : ℝ) ≤
        (24733 / 4 + 2673 / 8 * Real.log 2 - gain534 + ε) * (N : ℝ) ^ 2 :=
  growth_of_families (fams534 H) wins534 gain534 rfl wins534_pos wins534_ord wins534_rec (wins534_cert H) hε

