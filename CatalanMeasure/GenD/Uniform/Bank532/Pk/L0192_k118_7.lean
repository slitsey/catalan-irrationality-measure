def wInt (N p : ℕ) : List ℤ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  [(1) * hp,
   (69) * N + (-8) * hp + (-4),
   (9) * N,
   (-78) * N + (10) * hp + (5),
   (3) * N,
   (1) * hp,
   (-6) * N + (1) * hp + (1),
   (-78) * N + (10) * hp + (5),
   (70) * N + (-8) * hp + (-4),
   (-48) * N + (6) * hp + (4),
   (53) * N + (-6) * hp + (-4),
   (1)]

def wNat (g : Fin pk.charts.length) (N p : ℕ) : ℕ := ((wInt N p).getD g.val 0).toNat

def cNat (N p : ℕ) : ℕ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
