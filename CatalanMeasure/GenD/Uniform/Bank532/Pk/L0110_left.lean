def wInt (N p : ℕ) : List ℤ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  [(1) * hp,
   (78) * N + (-38) * hp + (-19),
   (-9) * N + (6) * hp + (3),
   (-69) * N + (34) * hp + (17),
   (3) * N + (-1) * hp + (-1),
   (-6) * N + (3) * hp + (2),
   (6) * N + (-2) * hp + (-1),
   (5) * N + (-2) * hp + (-1),
   (1),
   (-53) * N + (26) * hp + (13),
   (-22) * N + (12) * hp + (5)]

