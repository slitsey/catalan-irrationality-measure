  | 6 => { rows := chRows6, r := 4, ker := chKer6, qpiv := chPiv6, qadj := chAdj6, qdelta := 1 }
  | 7 => { rows := chRows7, r := 3, ker := chKer7, qpiv := chPiv7, qadj := chAdj7, qdelta := 1 }
  | 8 => { rows := chRows8, r := 3, ker := chKer8, qpiv := chPiv8, qadj := chAdj8, qdelta := 1 }
  | 9 => { rows := chRows9, r := 2, ker := chKer9, qpiv := chPiv9, qadj := chAdj9, qdelta := 46598971923014761298140 }
  | 10 => { rows := chRows10, r := 1, ker := chKer10, qpiv := chPiv10, qadj := chAdj10, qdelta := 1778153629664632867380764124923445768533067827804 }
  | _ => { rows := [], r := 0, ker := [], qpiv := [], qadj := [], qdelta := 1 }

def pk : Packet where
  n := 36
  d := 4
  v := vRows
  piv := vPiv
  adj := vAdj
  delta := vDelta
  charts := (List.range 11).map chart

set_option maxRecDepth 100000

theorem head_ok : pk.checkHead = true := by decide +kernel

theorem ch_ok0 : (chart 0).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok1 : (chart 1).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok2 : (chart 2).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok3 : (chart 3).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok4 : (chart 4).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok5 : (chart 5).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok6 : (chart 6).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok7 : (chart 7).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok8 : (chart 8).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok9 : (chart 9).check pk.n pk.d pk.v = true := by decide +kernel
theorem ch_ok10 : (chart 10).check pk.n pk.d pk.v = true := by decide +kernel

theorem pk_check : pk.check = true :=
  Packet.check_of_parts head_ok (by
    intro c hc
    simp only [pk, List.mem_map, List.mem_range] at hc
    obtain ⟨j, hj, rfl⟩ := hc
    interval_cases j
    exacts [ch_ok0, ch_ok1, ch_ok2, ch_ok3, ch_ok4, ch_ok5, ch_ok6, ch_ok7, ch_ok8, ch_ok9, ch_ok10])

theorem pk_sound : pk.Sound := Packet.check_sound pk_check

theorem pk_D_ne : pk.D ≠ 0 := by decide +kernel

def wInt (N p : ℕ) : List ℤ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  [(1) * hp,
   (69) * N + (-24) * hp + (-12),
   (9) * N + (-2) * hp + (-1),
   (3) * N + (-1) * hp + (-1),
   (-6) * N + (3) * hp + (2),
   (6) * N + (-2) * hp + (-1),
   (-78) * N + (28) * hp + (14),
   (75) * N + (-26) * hp + (-13),
   (1),
   (-5) * N + (2) * hp,
   (-48) * N + (18) * hp + (10)]

def wNat (g : Fin pk.charts.length) (N p : ℕ) : ℕ := ((wInt N p).getD g.val 0).toNat

def cNat (N p : ℕ) : ℕ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  ((2) * hp + (1)).toNat

def ranks : List ℕ := [2, 1, 0, 3, 1, 1, 4, 3, 3, 2, 1]

/-- The hull window of the packet pieces. -/
def Win (N p : ℕ) : Prop := 20 ≤ N ∧ 39 * N < 7 * p ∧ 12 * p ≤ 67 * N ∧ p % 2 = 1

def Phys : Prop := PhysHost design pk Win cNat wNat

theorem pk_len : pk.charts.length = 11 := by decide +kernel
theorem pk_d : pk.d = 4 := by decide +kernel

theorem pk_ranks (g : Fin pk.charts.length) : (pk.chart g).r = ranks.getD g.val 0 := by
  obtain ⟨i, hi⟩ := g
  rw [pk_len] at hi
  interval_cases i <;> rfl

theorem val2_ge {N p : ℕ} (h : Win N p) :
    (0 : ℤ) + (134) * (N : ℤ) + (-24) * (p : ℤ) ≤ 2 * ((packetVal pk cNat wNat N p : ℕ) : ℤ) := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  unfold packetVal cNat
  have hs : ∑ g : Fin pk.charts.length, wNat g N p * (pk.chart g).r =
      ∑ i ∈ Finset.range 11, ((wInt N p).getD i 0).toNat * ranks.getD i 0 := by
    have e : ∑ g : Fin pk.charts.length, wNat g N p * (pk.chart g).r =
        ∑ g : Fin pk.charts.length, ((wInt N p).getD g.val 0).toNat * ranks.getD g.val 0 :=
      Finset.sum_congr rfl (fun g _ => by rw [pk_ranks g]; rfl)
    rw [e, Fin.sum_univ_eq_sum_range
      (fun i => ((wInt N p).getD i 0).toNat * ranks.getD i 0) pk.charts.length, pk_len]
  rw [hs, pk_d]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, wInt, ranks]
  simp
  omega

theorem win_hull0 {N p : ℕ} (hN : 20 ≤ N) (hp : p.Prime) (h1 : 39 * N < 7 * p) (h2 : 12 * p ≤ 67 * N) : Win N p := by
  rcases hp.eq_two_or_odd with rfl | hodd
  · omega
  · refine ⟨hN, ?_, ?_, hodd⟩ <;> omega

theorem cell0 : ∀ N p : ℕ, 20 ≤ N → p.Prime → 39 * N < 7 * p → 12 * p ≤ 67 * N →
    (134 : ℤ) * (N : ℤ) + (-24 : ℤ) * (p : ℤ) ≤ ((2 : ℕ) : ℤ) * (((packetVal pk cNat wNat N p : ℕ) : ℤ) + 2) := by
  intro N p hN hp h1 h2
  have h := val2_ge (win_hull0 hN hp h1 h2)
  push_cast
  omega

theorem win0 (hP : Admissible design) (phys : Phys) :
    WinCert (NullityLB.ofPacketHost hP pk pk_sound Win cNat wNat phys) (cw (39 / 7 : ℝ) (67 / 12 : ℝ) (67 : ℝ) (-12 : ℝ)) :=
  winCert_host_cw hP pk pk_sound pk_D_ne Win cNat wNat phys (d := 2) (A := 134) (B := -24) (N0 := 20)
    (na := 39) (da := 7) (nb := 67) (db := 12)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (fun N p hN hp h1 h2 => win_hull0 hN hp h1 h2) cell0

