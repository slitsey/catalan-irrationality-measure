def wInt (N p : ℕ) : List ℤ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  [(1) * hp,
   (69) * N + (-34) * hp + (-17),
   (9) * N + (-4) * hp + (-2),
   (-78) * N + (40) * hp + (20),
   (3) * N + (-1) * hp + (-1),
   (-6) * N + (3) * hp + (2),
   (6) * N + (-2) * hp + (-1),
   (-48) * N + (24) * hp + (13),
   (53) * N + (-26) * hp + (-14),
   (1),
   (-75) * N + (38) * hp + (18)]

def wNat (g : Fin pk.charts.length) (N p : ℕ) : ℕ := ((wInt N p).getD g.val 0).toNat

def cNat (N p : ℕ) : ℕ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  ((8) * N + (-2) * hp + (-1)).toNat

def ranks : List ℕ := [16, 2, 1, 0, 32, 17, 16, 31, 30, 16, 0]

/-- The hull window of the packet pieces. -/
def Win (N p : ℕ) : Prop := 74 ≤ N ∧ 150 * N < 37 * p ∧ 17 * p ≤ 69 * N ∧ p % 2 = 1

def Phys : Prop := PhysHost design pk Win cNat wNat

theorem pk_len : pk.charts.length = 11 := by decide +kernel
theorem pk_d : pk.d = 32 := by decide +kernel

theorem pk_ranks (g : Fin pk.charts.length) : (pk.chart g).r = ranks.getD g.val 0 := by
  obtain ⟨i, hi⟩ := g
  rw [pk_len] at hi
  interval_cases i <;> rfl

theorem val2_ge {N p : ℕ} (h : Win N p) :
    (-3 : ℤ) + (-166) * (N : ℤ) + (41) * (p : ℤ) ≤ 2 * ((packetVal pk cNat wNat N p : ℕ) : ℤ) := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  unfold packetVal cNat
  have hs : ∑ g : Fin pk.charts.length, wNat g N p * (pk.chart g).r =
      ∑ i ∈ Finset.range 11, ((wInt N p).getD i 0).toNat * ranks.getD i 0 := by
    have e : ∑ g : Fin pk.charts.length, wNat g N p * (pk.chart g).r =
        ∑ g : Fin pk.charts.length, ((wInt N p).getD g.val 0).toNat * ranks.getD g.val 0 :=
      Finset.sum_congr rfl (fun g _ => by rw [pk_ranks g]; rfl)
    rw [e, Fin.sum_univ_eq_sum_range
      (fun i => ((wInt N p).getD i 0).toNat * ranks.getD i 0) pk.charts.length, pk_len]
  rw [hs, pk_d]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, wInt, ranks]
  simp
  omega

theorem win_hull0 {N p : ℕ} (hN : 74 ≤ N) (hp : p.Prime) (h1 : 150 * N < 37 * p) (h2 : 17 * p ≤ 69 * N) : Win N p := by
  rcases hp.eq_two_or_odd with rfl | hodd
  · omega
  · refine ⟨hN, ?_, ?_, hodd⟩ <;> omega

theorem cell0 : ∀ N p : ℕ, 74 ≤ N → p.Prime → 150 * N < 37 * p → 17 * p ≤ 69 * N →
    (-166 : ℤ) * (N : ℤ) + (41 : ℤ) * (p : ℤ) ≤ ((2 : ℕ) : ℤ) * (((packetVal pk cNat wNat N p : ℕ) : ℤ) + 2) := by
  intro N p hN hp h1 h2
  have h := val2_ge (win_hull0 hN hp h1 h2)
  push_cast
  omega

theorem win0 (hP : Admissible design) (phys : Phys) :
    WinCert (NullityLB.ofPacketHost hP pk pk_sound Win cNat wNat phys) (cw (150 / 37 : ℝ) (69 / 17 : ℝ) (-83 : ℝ) (41 / 2 : ℝ)) :=
  winCert_host_cw hP pk pk_sound pk_D_ne Win cNat wNat phys (d := 2) (A := -166) (B := 41) (N0 := 74)
    (na := 150) (da := 37) (nb := 69) (db := 17)
    (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num)
    (fun N p hN hp h1 h2 => win_hull0 hN hp h1 h2) cell0

