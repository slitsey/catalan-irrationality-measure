def wInt (N p : ℕ) : List ℤ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  [(1) * hp,
   (78) * N + (-14) * hp + (-7),
   (-9) * N + (2) * hp + (1),
   (-69) * N + (14) * hp + (7),
   (3) * N,
   (-6) * N + (2) * hp + (1),
   (6) * N + (-1) * hp + (-1),
   (-8) * N + (2) * hp + (1),
   (5) * N,
   (1),
   (-53) * N + (10) * hp + (5),
   (-22) * N + (4) * hp + (1)]

