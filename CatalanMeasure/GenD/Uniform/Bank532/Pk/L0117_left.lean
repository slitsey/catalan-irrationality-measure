  | 8 => { rows := chRows8, r := 3, ker := chKer8, qpiv := chPiv8, qadj := chAdj8, qdelta := 258724124271223902403547799723349598968616636003219371677669013 }
  | 9 => { rows := chRows9, r := 2, ker := chKer9, qpiv := chPiv9, qadj := chAdj9, qdelta := 1 }
  | 10 => { rows := chRows10, r := 2, ker := chKer10, qpiv := chPiv10, qadj := chAdj10, qdelta := 1 }
