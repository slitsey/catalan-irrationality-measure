def wInt (N p : ℕ) : List ℤ :=
  let N : ℤ := N
  let hp : ℤ := ((p : ℤ) - 1) / 2
  [(1) * hp,
   (69) * N + (-36) * hp + (-18),
   (9) * N + (-4) * hp + (-2),
   (-3) * N + (2) * hp + (1),
   (6) * N + (-3) * hp + (-2),
   (1) * hp + (1),
   (-78) * N + (42) * hp + (21),
   (75) * N + (-40) * hp + (-20),
   (1),
   (-5) * N + (4) * hp + (1),
   (-48) * N + (26) * hp + (14)]

