theorem partial_growth532 (H : Hosts532) {ε : ℝ} (hε : 0 < ε) :
    ∀ᶠ N : ℕ in atTop,
      Real.log (((canonicalNormalizer design D58.Odd.design_admissible (famLB (fams532 H)) 79
        (by rw [D58.Odd.design_H]; norm_num)).D N : ℕ) : ℝ) ≤
        (24733 / 4 + 2673 / 8 * Real.log 2 - gain532 + ε) * (N : ℝ) ^ 2 :=
  growth_of_families (fams532 H) wins532 gain532 rfl wins532_pos wins532_ord wins532_rec (wins532_cert H) hε

