theorem hw_eq0 (g : Fin pk.charts.length) (N p : ℕ) : wNat g N p = wdOf pd0.m N p g.val := by
  obtain ⟨g, hg⟩ := g
  rw [pk_len] at hg
  unfold wNat wdOf
  have h : ∀ k : Fin 11, ((wInt N p).getD k 0) = ((pdMeta0.ws.getD k ⟨0, 0, 0⟩).eval (N : ℤ) (((p : ℤ) - 1) / 2)) := by
    intro k
    fin_cases k <;> simp [wInt, pdMeta0, Aff.eval] <;> try ring
  exact congrArg Int.toNat (h ⟨g, hg⟩)

theorem hc_eq0 (N p : ℕ) : cNat N p = cmN pd0.m N p := by
  unfold cNat cmN; simp only [pd0, pdMeta0, Aff.eval] <;> (congr 1; try ring)

def pds : List PData := [pd0]

theorem win_cover (N p : ℕ) (h : Win N p) : ∃ pd ∈ pds, inWin pd.m N p := by
  obtain ⟨h1, h2, h3, h4⟩ := h
  exact ⟨pd0, by simp [pds], h1, h2, h3, h4⟩

theorem phys : Phys :=
  physHost_of_checks pk pds pk_sound Win cNat wNat win_cover
    (fun pd hpd N p _ => by
      simp only [pds, List.mem_cons, List.not_mem_nil, or_false] at hpd
      rcases hpd with rfl
      · exact hc_eq0 N p
    )
    (fun pd hpd g N p => by
      simp only [pds, List.mem_cons, List.not_mem_nil, or_false] at hpd
      rcases hpd with rfl
      · exact hw_eq0 g N p
    )
    (fun pd hpd => by
      simp only [pds, List.mem_cons, List.not_mem_nil, or_false] at hpd
      rcases hpd with rfl
      · exact check_ok0
    )

end
