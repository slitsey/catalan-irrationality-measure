theorem mtcell6 {N p : ℕ} [Fact p.Prime] (hN : 100000 ≤ N) (hp1 : p % 2 = 1)
    (h1 : 11429 * N < 2500 * p) (h2 : 10000 * p ≤ 45999 * N) :
    (-64000 : ℤ) * N + (14000) * p ≤ 1000 * ((((mtLB3 design adm).kap N p : ℕ) : ℤ) + 2) := by
  have hp0 : 0 < p := by omega
  have key := mtMinus_ge (N := N) (p := p) (s := 16) (K := 13) (D1 := ((5 * N) - (p))) (e0 := ((69 * N) - (15 * p))) (a := 0) (b := 13)
    (t := 0) (c := 13) (m0 := 1) (k0 := (-1 : ℤ)) hp0
    (by des_unfold; omega)
    (by have := hpKmin_le_of design N p 2 hp0 (by des_unfold; omega); omega)
    (by have := le_hpKmax_of design N p 0 hp0 (by des_unfold; omega); omega)
    (mtKmax_ge_of design N p 2 11 13 hp0 (by des_unfold; omega) (by des_unfold; omega) (by omega))
    (by omega) (by omega)
    (by
      unfold mtMinusOK hpEta
      des_unfold
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> omega)
    (mtJJ_card_le (lm1 := 1) (c := 13)
        (by unfold hpEta; des_unfold; omega) (by unfold hpEta; des_unfold; omega))
    (by omega) (by omega)
    (by des_unfold; push_cast; omega) (by des_unfold; push_cast; omega) (by omega)
  des_unfold at key
  omega

