theorem mtcell0 {N p : ℕ} [Fact p.Prime] (hN : 100000 ≤ N) (hp1 : p % 2 = 1)
    (h1 : 42943 * N < 10000 * p) (h2 : 1250 * p ≤ 5403 * N) :
    (-73000 : ℤ) * N + (17000) * p ≤ 1000 * ((((mtLB3 design adm).kap N p : ℕ) : ℤ) + 2) := by
  have hp0 : 0 < p := by omega
  have key := mtMinus_ge (N := N) (p := p) (s := 17) (K := 14) (D1 := ((5 * N) - (p))) (e0 := ((78 * N) - (18 * p))) (a := 0) (b := 14)
    (t := 0) (c := 14) (m0 := 1) (k0 := (-1 : ℤ)) hp0
    (by des_unfold; omega)
    (by have := hpKmin_le_of design N p 2 hp0 (by des_unfold; omega); omega)
    (by have := le_hpKmax_of design N p 0 hp0 (by des_unfold; omega); omega)
    (mtKmax_ge_of design N p 2 12 14 hp0 (by des_unfold; omega) (by des_unfold; omega) (by omega))
    (by omega) (by omega)
    (by
      unfold mtMinusOK hpEta
      des_unfold
      refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩ <;> omega)
    (mtJJ_card_le (lm1 := 1) (c := 14)
        (by unfold hpEta; des_unfold; omega) (by unfold hpEta; des_unfold; omega))
    (by omega) (by omega)
    (by des_unfold; push_cast; omega) (by des_unfold; push_cast; omega) (by omega)
  des_unfold at key
  omega

