theorem rootMinusHalf_nonzero : ipEval AZX (-(1/2:ℝ))≠0 := by
  have hh := ipHorner_ne_zero (p := AZX) (a := -1) (d := 2) (by decide) (by decide +kernel)
  norm_num at hh
  exact hh
theorem rootPlusHalf_nonzero : ipEval AZX (1/2:ℝ)≠0 := by
  have hh := ipHorner_ne_zero (p := AZX) (a := 1) (d := 2) (by decide) (by decide +kernel)
  norm_num at hh
  exact hh
end CatalanMeasure.StrongTrial
